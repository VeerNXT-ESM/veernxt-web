# ============================================================
# VeerNXT Web Application — Environment Configuration Template
# ============================================================

# --- Frontend (VITE_ prefix = exposed to browser) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
VITE_ENGINE_URL=https://your-project.supabase.co/functions/v1/engine
VITE_ADMIN_API_SECRET=your-admin-api-secret
VITE_R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# --- Tester / QA Full Access Bypass ---
# Set to 'true' in Vercel to unlock all books, precis, PYQs, mock tests, and features for testers
VITE_TESTER_KEY=true
VITE_TESTER_MODE=true
TESTER_KEY=true
TESTER_MODE=true

# --- Backend Only (Vercel Serverless — NOT exposed to browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_API_SECRET=your-admin-api-secret
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

    {
      "id": "uhhwto5",
      "type": "heading",
      "level": 2,
      "content": "1.8 Indian Soil Types (ICAR Classification)"
    },
    {
      "id": "mf8m5xr",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Soil Type</strong></p>",
            "<p><strong>States / Regions</strong></p>",
            "<p><strong>Crops Grown</strong></p>",
            "<p><strong>Special Features</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Alluvial Soil (Khadar &amp; Bhangar)</p>",
            "<p>Indo-Gangetic Plains, river deltas</p>",
            "<p>Rice, wheat, sugarcane, cotton, oilseeds</p>",
            "<p>Most extensive; highly fertile; low humus; Khadar = new alluvium; Bhangar = old</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Black Soil (Regur)</p>",
            "<p>Deccan Plateau (Maharashtra, MP, Gujarat, AP)</p>",
            "<p>Cotton, soybean, sorghum, sunflower</p>",
            "<p>Self-ploughing; cracks in dry season; high clay; excellent water retention</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Red and Yellow Soil</p>",
            "<p>Peninsular plateau, Odisha, Jharkhand</p>",
            "<p>Millets, groundnut, tobacco, vegetables</p>",
            "<p>Low fertility; acidic; red colour due to Fe2O3; yellow when hydrated</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Laterite Soil</p>",
            "<p>Kerala, Karnataka, Assam, Meghalaya</p>",
            "<p>Tea, coffee, cashew, rubber</p>",
            "<p>Highly leached; low pH; iron and aluminium oxides dominate; poor in N, P, K</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

    {
      "id": "usm3txb",
      "type": "heading",
      "level": 2,
      "content": "12.5 Glossary of Agricultural Terms"
    },
    {
      "id": "x4bx3bj",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Term</strong></p>",
            "<p><strong>Meaning</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Agronomy</p>",
            "<p>Science of crop production and soil management relating to crop yield</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Allelopathy</p>",
            "<p>Chemical inhibition of one plant by another through release of toxic substances</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Apomixis</p>",
            "<p>Seed formation without fertilisation; clonal reproduction through seeds</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Biofertiliser</p>",
            "<p>Microorganism preparations that fix N or solubilise P; Rhizobium, Azospirillum, PSB</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Certified Seed</p>",
            "<p>Seed produced under certified conditions; blue tag; ensures genetic and physical purity</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>CEC (Cation Exchange Capacity)</p>",
            "<p>Ability of soil to hold cations (Ca, Mg, K, Na) for plant uptake; higher = more fertile</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Crop coefficient (Kc)</p>",
            "<p>Ratio of actual ET to reference ET; used in irrigation scheduling</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Cytoplasmic Male Sterility (CMS)</p>",
            "<p>Sterility in pollen due to cytoplasmic (mitochondrial) factors; used in hybrid seed production</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Dormancy</p>",
            "<p>Period when seed/bud does not germinate despite favourable conditions; adaptive mechanism</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Evapotranspiration (ET)</p>",
            "<p>Combined loss of water by evaporation from soil and transpiration from plants</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Fertigation</p>",
            "<p>Application of fertilisers through drip irrigation system; efficient use of nutrients</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hardening off</p>",
            "<p>Gradual acclimatisation of greenhouse-grown plants to outdoor conditions before transplanting</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hybrid vigour (Heterosis)</p>",
            "<p>Superiority of hybrid offspring over both parents in growth, yield, stress tolerance</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Intercropping systems</p>",
            "<p>Mixed intercropping, row intercropping, strip cropping, relay intercropping</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Juvenile phase</p>",
            "<p>Period of vegetative growth before plant becomes capable of flowering</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Khaira disease</p>",
            "<p>Zinc deficiency in rice; rusty brown spots; corrected with ZnSO4 spray</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>LAI (Leaf Area Index)</p>",
            "<p>Total one-sided green leaf area / ground area; optimal 3–5 for most crops</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Mulching</p>",
            "<p>Covering soil surface with organic or inorganic materials; conserves moisture; controls weeds</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Neem-Coated Urea (NCU)</p>",
            "<p>Urea coated with neem oil; slows nitrification; reduces leaching; mandatory since 2015</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Phenology</p>",
            "<p>Study of periodic biological events (flowering, fruiting) and their relation to climate</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Rhizobium</p>",
            "<p>Nitrogen-fixing bacteria that form nodules on legume roots; provide ~100–300 kg N/ha/year</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Saline soil</p>",
            "<p>EC &gt; 4 dS/m; white deposits; ESP &lt; 15%; treated by leaching</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sodic/Alkaline soil (Usar)</p>",
            "<p>ESP &gt; 15%; pH &gt; 8.5; treated with gypsum; poor structure</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Transpiration efficiency (TE)</p>",
            "<p>Ratio of dry matter produced to water transpired; C4 plants have higher TE</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Vernalisation</p>",
            "<p>Promotion of flowering by cold temperature treatment; required by wheat (winter types)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Zero Budget Natural Farming</p>",
            "<p>ZBNF; Subhash Palekar; Jeevamrit (cow dung, cow urine, jaggery, pulse flour) as input</p>"
          ]
        }
      ]
    }
  ],

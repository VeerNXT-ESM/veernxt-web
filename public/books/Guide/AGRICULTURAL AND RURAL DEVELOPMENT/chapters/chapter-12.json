      "content": "12.4 Important Acts in Agriculture"
    },
    {
      "id": "2mdibp6",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Act</strong></p>",
            "<p><strong>Year</strong></p>",
            "<p><strong>Purpose</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Land Acquisition Act (LARR)</p>",
            "<p>2013 (amended 2015)</p>",
            "<p>Right to Fair Compensation and Transparency in Land Acquisition; consent of 70-80% landowners</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Essential Commodities Act (ECA)</p>",
            "<p>1955 (amended 2020)</p>",
            "<p>Control production, supply, distribution of essential commodities including food</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>APMC Acts</p>",
            "<p>State-specific</p>",
            "<p>Regulate agricultural markets; mandis; agent licensing; recent reforms by states</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Seeds Act</p>",
            "<p>1966 (amendment pending)</p>",
            "<p>Regulate quality of seeds; certification; minimum standards</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Fertiliser Control Order (FCO)</p>",
            "<p>1985</p>",
            "<p>Regulate quality, manufacture, sale of fertilisers; specifications</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Pesticides Management Bill</p>",
            "<p>Pending (replaces 1968 Act)</p>",
            "<p>Registration, manufacture, sale of pesticides; safety standards</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Prevention of Food Adulteration Act</p>",
            "<p>1954 (replaced by FSS Act)</p>",
            "<p>Food quality; replaced by Food Safety and Standards Act 2006</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Food Safety and Standards Act</p>",
            "<p>2006</p>",
            "<p>FSSAI established; food safety standards; labelling; licensing of food businesses</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Plant Quarantine Order</p>",
            "<p>2003 (under NPPO)</p>",
            "<p>Regulate import/export of plant material; prevent pest introduction</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Geographical Indications Act</p>",
            "<p>1999</p>",
            "<p>Protect GI for agricultural and other products; unique quality linked to origin</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Biological Diversity Act</p>",
            "<p>2002</p>",
            "<p>Regulate access to biological resources; benefit sharing; NBA</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Farmer Producer Companies Act</p>",
            "<p>2002 (Companies Act)</p>",
            "<p>Enable FPOs to register as producer companies; collective farming benefits</p>"
          ]
        }
      ]
    },

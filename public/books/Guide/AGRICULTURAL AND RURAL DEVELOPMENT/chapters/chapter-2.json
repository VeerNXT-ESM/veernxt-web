        },
        {
          "isHeader": false,
          "cells": [
            "<p>Fertiliser</p>",
            "<p>N:P:K = 120:60:60 kg/ha; nitrogen in splits (1/3 basal, 1/3 at knee-high, 1/3 tasselling)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Types</p>",
            "<p>Sweet corn, Popcorn, Baby corn, Waxy corn, QPM (Quality Protein Maize)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

      "content": "Seed Quality Parameters"
    },
    {
      "id": "lf2uplb",
      "type": "list",
      "items": [
        "<strong>Minimum % of seeds that should germinate under standard conditions: </strong>Germination Percentage (GP)",
        "<strong>% of pure seeds by weight; free from inert matter, other crop seeds, weed seeds: </strong>Physical Purity",
        "<strong>% of seeds true to the variety; tested by grow-out test: </strong>Genetic Purity",
        "<strong>Ability of seed to germinate and establish quickly under adverse conditions: </strong>Seed Vigour",
        "<strong>Should be below 10–12% for safe storage; prevents mould and deterioration: </strong>Moisture Content",
        "<strong>Indicates seed size; larger seeds generally have more vigour: </strong>1000-Seed Weight (TSW)"
      ]
    },

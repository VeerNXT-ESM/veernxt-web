      "content": "3.4 Propagation Methods in Horticulture"
    },
    {
      "id": "365wyvz",
      "type": "heading",
      "level": 3,
      "content": "Sexual Propagation (Seeds)"
    },
    {
      "id": "e6i9srr",
      "type": "list",
      "items": [
        "Used for papaya, guava, pineapple from seed, annuals",
        "Cheap but variation in progeny; takes longer to bear fruit"
      ]
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Method Category",

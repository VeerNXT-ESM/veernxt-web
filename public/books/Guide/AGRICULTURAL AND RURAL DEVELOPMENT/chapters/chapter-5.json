      "level": 2,
      "content": "5.2 Metamorphosis in Insects"
    },
    {
      "type": "pullQuote",
      "content": "Integrated Pest Management (IPM)",
      "id": "ys2euyd"
    },
    {
      "id": "ttyshvo",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Type</strong></p>",
            "<p><strong>Stages</strong></p>",
            "<p><strong>Examples</strong></p>",
            "<p><strong>Significance</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Ametabolous (no metamorphosis)</p>",
            "<p>Egg → Nymph (like adult) → Adult</p>",
            "<p>Silverfish, springtails</p>",
            "<p>Rare in pest species</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hemimetabolous (Incomplete)</p>",
            "<p>Egg → Nymph → Adult; nymph resembles adult</p>",
            "<p>Locusts, aphids, leafhoppers, bugs</p>",
            "<p>All stages can be pests; no pupal stage</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Holometabolous (Complete)</p>",
            "<p>Egg → Larva → Pupa → Adult; larva unlike adult</p>",
            "<p>Butterflies, beetles, flies, wasps, moths</p>",
            "<p>Larval stage is usually the damaging stage</p>"
          ]
        }
      ]
    },

    {
      "id": "unmulja",
      "type": "heading",
      "level": 2,
      "content": "6.3 Dairy Science — Key Concepts"
    },
    {
      "id": "bdm4djm",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Concept</strong></p>",
            "<p><strong>Details</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Lactation Period</p>",
            "<p>Period from parturition (calving) to drying off; 305 days standard</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Dry Period</p>",
            "<p>Period between lactation and next calving; ~60 days; needed for udder rest</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Calving Interval</p>",
            "<p>Time between two consecutive calvings; ideal is 12–13 months</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SNF (Solids Not Fat)</p>",
            "<p>Protein + lactose + minerals in milk; indicator of milk quality; min 8.5% in cow milk</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Fat %</p>",
            "<p>Cow milk: 3.5–4.5%; Buffalo milk: 7–8%; Jersey: 5.5%</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Crossbreeding</p>",
            "<p>HF x Sahiwal = Karan Fries; Jersey x Red Sindhi = Karan Swiss (NDRI crosses)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Operation Flood</p>",
            "<p>White Revolution; Dr. Verghese Kurien; NDDB; 1970; made India largest milk producer</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NDDB</p>",
            "<p>National Dairy Development Board; HQ Anand (Gujarat); cooperative model (Amul)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NDRI</p>",
            "<p>National Dairy Research Institute; Karnal, Haryana; research and breed development</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Colostrum</p>",
            "<p>First milk after calving; rich in immunoglobulins; must be fed to calf for 3 days</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Milk Fever (Hypocalcaemia)</p>",
            "<p>Drop in blood calcium at calving; treated with IV calcium borogluconate</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Foot and Mouth Disease (FMD)</p>",
            "<p>Viral; affects cloven-hoofed animals; vesicles on mouth/feet; vaccination mandatory</p>"
          ]
        }
      ]
    },

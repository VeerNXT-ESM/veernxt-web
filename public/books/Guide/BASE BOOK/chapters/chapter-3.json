    {
      "id": "8xizvms",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Tense</strong></p>",
            "<p><strong>Structure</strong></p>",
            "<p><strong>Example</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Simple Present</p>",
            "<p>V₁ / V₁+s</p>",
            "<p>She works in NALCO.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Present Continuous</p>",
            "<p>am/is/are + V₁+ing</p>",
            "<p>He is preparing for BEL exam.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Present Perfect</p>",
            "<p>has/have + V₃</p>",
            "<p>They have completed the project.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Simple Past</p>",
            "<p>V₂</p>",
            "<p>The company signed the contract.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Past Continuous</p>",
            "<p>was/were + V₁+ing</p>",
            "<p>We were reviewing the report.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Past Perfect</p>",
            "<p>had + V₃</p>",
            "<p>She had submitted the form before the deadline.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Simple Future</p>",
            "<p>will/shall + V₁</p>",
            "<p>BEL will recruit 500 engineers.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Future Perfect</p>",
            "<p>will have + V₃</p>",
            "<p>They will have finished by March.</p>"
          ]
        }
      ]
    },

    {
      "type": "paragraph",
      "id": "rsaej0g",
      "content": "<strong>4.3  Must-Know PSU Facts for Exam</strong>"
    },
    {
      "id": "803bll5",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>PSU</strong></p>",
            "<p><strong>Key Fact</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>BEL</p>",
            "<p>India's premier defence electronics company; established 1954; 9 manufacturing units</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NALCO</p>",
            "<p>Asia's largest integrated Alumina–Aluminium complex; mines at Panchpatmali, Odisha</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NLC India</p>",
            "<p>Lignite mining + thermal power; Neyveli, Tamil Nadu; also has solar/wind capacity</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NHPC</p>",
            "<p>India's largest hydropower company; installed capacity 7,000+ MW</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RINL</p>",
            "<p>Only shore-based integrated steel plant in India; famous Vizag Steel</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NMDC</p>",
            "<p>Largest iron ore producer in India; mines at Bailadila (CG) and Donimalai (Karnataka)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>CONCOR</p>",
            "<p>India's largest multimodal logistics company; operates ICDs and CFSs across India</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RITES</p>",
            "<p>Railway consultancy in 55+ countries; IPO listed on NSE &amp; BSE</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IREDA</p>",
            "<p>India's largest NBFC for renewable energy financing; IPO completed Nov 2023</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SJVN</p>",
            "<p>Joint venture: GoI (74.92%) + HP Govt (25.08%); flagship Nathpa Jhakri 1,500 MW station</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>MDL</p>",
            "<p>India's premier warship builder; built Scorpene-class submarines and INS Visakhapatnam</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SECI</p>",
            "<p>Nodal agency for PM-KUSUM, PLI (solar), Green Hydrogen mission</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IRCTC</p>",
            "<p>Holds near-monopoly on online railway ticketing in India; became Navratna March 2025</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>CWC</p>",
            "<p>One of India's largest public warehousing agencies; 400+ warehouses; 100 lakh MT capacity</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IRFC</p>",
            "<p>Dedicated financing arm of Ministry of Railways; registered NBFC with RBI</p>"
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "id": "0mo7qhk",
      "content": "<strong>4.4  Key Government Schemes Relevant to PSU GK</strong>"
    },
    {
      "id": "ukr7san",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Scheme</strong></p>",
            "<p><strong>Launched</strong></p>",
            "<p><strong>Relevance</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Make in India</p>",
            "<p>2014</p>",
            "<p>Boosts domestic manufacturing — relevant to BEL, HAL, MDL, BHEL</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Digital India</p>",
            "<p>2015</p>",
            "<p>ICT infrastructure — relevant to NIC, RCIL (RailTel), IRCTC</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>PM-KUSUM</p>",
            "<p>2019</p>",
            "<p>Solar energy for farmers — nodal agency SECI</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>National Green Hydrogen Mission</p>",
            "<p>2023</p>",
            "<p>Green hydrogen production — SECI, NTPC, ONGC</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>PLI Scheme (Solar Modules)</p>",
            "<p>2021</p>",
            "<p>Production linked incentive for solar — SECI, BHEL</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>PM Gati Shakti</p>",
            "<p>2021</p>",
            "<p>Multimodal connectivity — RVNL, IRCON, RITES, CONCOR</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SVAMITVA Scheme</p>",
            "<p>2020</p>",
            "<p>Property rights in villages — involves DRDO/Survey of India</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Jal Jeevan Mission</p>",
            "<p>2019</p>",
            "<p>Clean water to rural households — relevant to NBCC, HUDCO</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>UDAN Scheme</p>",
            "<p>2016</p>",
            "<p>Regional air connectivity — relevant to AAI</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Samarth Scheme</p>",
            "<p>2017</p>",
            "<p>Skill development in textile sector — NMDC, SAIL support</p>"
          ]
        }
      ]
    },
    {
      "type": "heading",
      "level": 4,
      "id": "xfms80d",
      "content": "<strong>4.5  Indian Economy Basics</strong>"
    },
    {
      "id": "6793r5p",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Indicator</strong></p>",
            "<p><strong>Description</strong></p>",
            "<p><strong>Current Status (approx.)</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>GDP</p>",
            "<p>Gross Domestic Product — total value of goods &amp; services produced</p>",
            "<p>~$3.9 trillion (FY 2024–25); 5th largest economy</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>GDP Growth Rate</p>",
            "<p>Rate at which economy expands</p>",
            "<p>~7–8% (one of fastest growing major economies)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Inflation</p>",
            "<p>Rise in general price level; measured by CPI &amp; WPI</p>",
            "<p>Retail inflation ~4–5% (RBI target band 4±2%)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RBI</p>",
            "<p>Reserve Bank of India — central bank; controls monetary policy</p>",
            "<p>Repo rate used to control inflation</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Fiscal Deficit</p>",
            "<p>Excess of government expenditure over revenue</p>",
            "<p>Target: 4.5% of GDP (FY25); reduced from 5.1%</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Union Budget</p>",
            "<p>Annual financial statement of Government of India</p>",
            "<p>Presented by Finance Minister in Parliament</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>FRBM Act</p>",
            "<p>Fiscal Responsibility &amp; Budget Management Act 2003</p>",
            "<p>Mandates fiscal discipline; deficit targets</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>FDI</p>",
            "<p>Foreign Direct Investment — foreign investment in Indian businesses</p>",
            "<p>India receives ~$70–80 billion FDI annually</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>GST</p>",
            "<p>Goods &amp; Services Tax — unified indirect tax</p>",
            "<p>4 slabs: 0%, 5%, 12%, 18%, 28%</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SEBI</p>",
            "<p>Securities &amp; Exchange Board of India — capital market regulator</p>",
            "<p>Regulates stock markets, mutual funds, FPIs</p>"
          ]
        }
      ]
    }
  ],

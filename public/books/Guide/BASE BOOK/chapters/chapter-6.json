    {
      "type": "heading",
      "level": 4,
      "id": "3kju6lr",
      "content": "<strong>6.2  Key Economic Terms</strong>"
    },
    {
      "id": "btpcm4f",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Term</strong></p>",
            "<p><strong>Full Form / Meaning</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>GDP</p>",
            "<p>Gross Domestic Product — total economic output of a country</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>GNP</p>",
            "<p>Gross National Product — GDP + net income from abroad</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NDP</p>",
            "<p>Net Domestic Product — GDP minus depreciation</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>CPI</p>",
            "<p>Consumer Price Index — measures retail inflation</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>WPI</p>",
            "<p>Wholesale Price Index — measures wholesale price changes</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Repo Rate</p>",
            "<p>Rate at which RBI lends to commercial banks; key monetary tool</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Reverse Repo</p>",
            "<p>Rate at which RBI borrows from commercial banks</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SLR</p>",
            "<p>Statutory Liquidity Ratio — % of deposits banks must keep in liquid assets</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>CRR</p>",
            "<p>Cash Reserve Ratio — % of deposits banks must keep with RBI as cash</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>FRBM</p>",
            "<p>Fiscal Responsibility &amp; Budget Management Act — sets deficit targets</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>FDI</p>",
            "<p>Foreign Direct Investment — investment from abroad in Indian companies</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>FPI</p>",
            "<p>Foreign Portfolio Investment — investment in Indian stocks/bonds by foreigners</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NBFC</p>",
            "<p>Non-Banking Financial Company — provides financial services but no banking licence</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>MSME</p>",
            "<p>Micro, Small &amp; Medium Enterprises — backbone of Indian manufacturing</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>PLI</p>",
            "<p>Production Linked Incentive — scheme to boost domestic manufacturing</p>"
          ]
        }
      ]
    },

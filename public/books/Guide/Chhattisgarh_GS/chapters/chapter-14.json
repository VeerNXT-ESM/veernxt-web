    },
    {
      "type": "examAlert",
      "items": [
        "Questions frequently test cross-mappings between legacy IPC provisions and newly enacted BNS sections.",
        "Hierarchy sequence and exact insignia identifiers for police ranks are common objective test items.",
        "CG Police Recruitment pattern specifics and statutory duties of Sub-Inspectors carry high weightage in state SI exams."
      ],
      "id": "lgtlbqr"
    },
    {
      "id": "ocudgcc",
      "type": "list",
      "items": [
        "Investigating complaints filed at the police station",
        "Maintaining law and order in the assigned area",
        "Drafting FIRs (First Information Reports)",
        "Conducting raids and arrests under proper warrant/authority",
        "Supervising constables and head constables",
        "Maintaining case diaries and official records",
        "Appearing in court and giving evidence in trials",
        "Conducting traffic regulation duties when required",
        "Preventing crimes through patrolling and intelligence gathering"
      ]
    },

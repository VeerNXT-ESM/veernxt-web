      ],
      "id": "mln345b"
    },
    {
      "type": "paragraph",
      "id": "gxjpdqd",
      "content": "• It is a permanent body."
    },
    {
      "type": "paragraph",
      "id": "dleob1t",
      "content": "• One-third members retire every two years."
    },
    {
      "id": "xdtvjgw",
      "type": "heading",
      "level": 2,
      "content": "SSC / SSC Important Facts"
    },
    {
      "type": "paragraph",
      "id": "vd0a613",
      "content": "• Part VI deals with State Government."
    },
    {
      "type": "paragraph",
      "id": "grg0xdi",
      "content": "• Governor is constitutional head."
    },
    {
      "type": "paragraph",
      "id": "oukofze",
      "content": "• Chief Minister is real executive head."
    }

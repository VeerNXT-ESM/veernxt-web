    {
      "id": "b3gctbn",
      "type": "heading",
      "level": 2,
      "content": "2. Importance of the Atmosphere"
    },
    {
      "type": "paragraph",
      "id": "itemfe5",
      "content": "• Provides oxygen necessary for respiration."
    },
    {
      "type": "paragraph",
      "id": "sa7lqzs",
      "content": "• Protects Earth from harmful ultraviolet radiation."
    },
    {
      "type": "paragraph",
      "id": "h5hr1r2",
      "content": "• Maintains Earth's temperature through greenhouse effect."
    },
    {
      "type": "paragraph",
      "id": "8de1gj3",
      "content": "• Helps in weather formation and water cycle."
    },
    {
      "id": "05mxoxl",
      "type": "heading",
      "level": 2,
      "content": "3. Layers of the Atmosphere"
    },
    {
      "id": "02tbrcg",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Layer</strong></p>",

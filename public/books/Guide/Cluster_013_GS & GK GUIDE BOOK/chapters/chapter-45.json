      "level": 2,
      "content": "7. Importance of Industries"
    },
    {
      "type": "paragraph",
      "id": "swazpux",
      "content": "• Generates employment opportunities."
    },
    {
      "type": "paragraph",
      "id": "iji13c8",
      "content": "• Increases national income."
    },

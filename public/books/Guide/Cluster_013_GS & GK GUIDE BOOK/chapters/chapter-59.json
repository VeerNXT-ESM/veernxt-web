          "Bitter"
        ],
        [
          "Ions Produced in Water",
          "H+ (Hydrogen ions)",
          "OH- (Hydroxide ions)"
        ],
        [
          "Effect on Litmus",
          "Blue litmus turns Red",
          "Red litmus turns Blue"
        ],
        [
          "pH Level",
          "Less than 7",
          "Greater than 7"
        ],
        [
          "Texture/Touch",
          "Corrosive",
          "Slippery / Soapy"
        ]
      ],
      "id": "s1612my"
    },
    {
      "type": "paragraph",
      "id": "7kqog6p",
      "content": "pH &lt; 7 : Acidic solution"
    },
    {
      "type": "paragraph",
      "id": "pqa88l7",
      "content": "pH = 7 : Neutral solution"
    },
    {
      "type": "paragraph",
      "id": "gkpat67",
      "content": "pH &gt; 7 : Basic solution"
    },
    {
      "id": "bmlrst2",
      "type": "heading",
      "level": 2,
      "content": "7. Indicators"
    },
    {

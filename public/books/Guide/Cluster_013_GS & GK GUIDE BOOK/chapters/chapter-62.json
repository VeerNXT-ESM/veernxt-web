      "content": "• Cytoplasm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "csi6peb",
      "content": "• Nucleus"
    },
    {
      "id": "4yetyqj",
      "type": "heading",
      "level": 2,
      "content": "5. Cell Membrane"
    },
    {
      "type": "paragraph",
      "id": "ug9ak2p",
      "content": "• Also called plasma membrane."
    },
    {
      "type": "paragraph",
      "id": "5uldzuc",
      "content": "• Controls movement of substances into and out of the cell."
    },
    {
      "type": "paragraph",
      "id": "54dv35o",
      "content": "• It is selectively permeable."
    },

          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Prohibition</p>",
            "<p>Prevent lower court from exceeding jurisdiction</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Certiorari</p>",
            "<p>Transfer case from lower court to higher court</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Quo Warranto</p>",

    {
      "id": "0zj02z2",
      "type": "heading",
      "level": 2,
      "content": "3. Lok Sabha (House of the People)"
    },
    {
      "type": "paragraph",
      "id": "st263pr",
      "content": "• Maximum strength: 552 members."
    },
    {
      "type": "paragraph",
      "id": "n0l4umq",
      "content": "• Members are directly elected by the people."
    },
    {
      "type": "paragraph",
      "id": "a3tdtyn",
      "content": "• Term of Lok Sabha: 5 years."
    },
    {
      "type": "paragraph",
      "id": "v3jobft",
      "content": "• The Speaker presides over the Lok Sabha."
    },
    {
      "id": "8b1bu52",
      "type": "heading",
      "level": 2,
      "content": "4. Rajya Sabha (Council of States)"
    },
    {
      "type": "paragraph",
      "id": "ijnnt9t",
      "content": "• Maximum strength: 250 members."
    },
    {
      "type": "paragraph",
      "id": "fzivtfz",
      "content": "• Members are elected by State Legislative Assemblies."
    },
    {
      "type": "paragraph",
      "id": "yhr0b1y",
      "content": "• 12 members are nominated by the President."
    },
    {
      "type": "paragraph",
      "id": "gxxdy1h",
      "content": "• It is a permanent house and cannot be dissolved."
    },
    {
      "type": "paragraph",
      "id": "wraaob8",
      "content": "• One-third members retire every two years."
    },
    {
      "id": "6gva50c",
      "type": "heading",
      "level": 2,
      "content": "5. Sessions of Parliament"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "306mp5f",
      "content": "• Budget Session (February–May)"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "ig67l3x",
      "content": "• Monsoon Session (July–September)"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "5oypr0u",
      "content": "• Winter Session (November–December)"
    },
    {
      "id": "zqj6ttw",

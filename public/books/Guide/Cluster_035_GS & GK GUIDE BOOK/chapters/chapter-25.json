      "content": "EXAM Important Facts"
    },
    {
      "type": "paragraph",
      "id": "0geuz93",
      "content": "• Articles 214–231 deal with High Courts."
    },
    {
      "type": "paragraph",
      "id": "801q0h4",
      "content": "• Judges retire at 62."
    },
    {
      "type": "paragraph",
      "id": "rpaqdmb",
      "content": "• High Courts issue writs under Article 226."
    }

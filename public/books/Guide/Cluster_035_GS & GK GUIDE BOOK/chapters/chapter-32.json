    {
      "type": "examAlert",
      "items": [
        "P-wave shadow zone spans from 103° to 142° from the epicenter, whereas S-wave shadow zone extends continuously beyond 103°.",
        "Mohorovičić (Moho) discontinuity lies between the Crust and Mantle, while the Gutenberg discontinuity separates the Mantle and Core.",
        "Lithosphere encompasses the entire Crust plus the uppermost solid portion of the Mantle (10–200 km)."
      ],
      "id": "a98yl1u"
    },
    {
      "id": "wngxarl",

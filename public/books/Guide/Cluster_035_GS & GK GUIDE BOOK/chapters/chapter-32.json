    {
      "id": "1tptuze",
      "type": "heading",
      "level": 2,
      "content": "4. Crust"
    },
    {
      "type": "paragraph",
      "id": "gzbqr7p",
      "content": "• Outermost layer of the Earth."
    },
    {
      "type": "paragraph",
      "id": "2n17e64",
      "content": "• Thickness varies from about 5 km (oceanic crust) to 70 km (continental crust)."
    },
    {
      "type": "paragraph",
      "id": "ptgfzii",
      "content": "• Mainly composed of oxygen, silicon, aluminium, iron and calcium."
    },
    {
      "id": "l1nniz2",
      "type": "heading",
      "level": 3,
      "content": "Types of Crust"
    },
    {
      "id": "lxflokf",
      "type": "table",
      "rows": [
        {
          "isHeader": true,

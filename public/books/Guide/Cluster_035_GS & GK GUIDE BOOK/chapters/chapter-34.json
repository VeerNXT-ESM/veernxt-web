    {
      "id": "i5166mc",
      "type": "heading",
      "level": 2,
      "content": "4. Troposphere"
    },
    {
      "type": "paragraph",
      "id": "z7i0g8s",
      "content": "• Lowest layer of the atmosphere."
    },
    {
      "type": "paragraph",
      "id": "qzaxc3p",
      "content": "• Contains about 75% of atmospheric mass."
    },
    {
      "type": "paragraph",
      "id": "hsu7kud",
      "content": "• All weather phenomena such as clouds, rain and storms occur here."
    },
    {
      "id": "13q683x",
      "type": "heading",
      "level": 2,
      "content": "5. Stratosphere"
    },
    {
      "type": "paragraph",
      "id": "myiaatg",
      "content": "• Located above the troposphere."
    },
    {
      "type": "paragraph",
      "id": "cqhol64",
      "content": "• Contains the ozone layer that absorbs harmful ultraviolet radiation."
    },
    {
      "type": "paragraph",
      "id": "1ap0n60",
      "content": "• Jet aircraft often fly in this layer."
    },
    {
      "id": "lr2mlht",
      "type": "heading",
      "level": 2,
      "content": "6. Mesosphere"
    },
    {

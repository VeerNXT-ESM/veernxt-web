    {
      "id": "bldn43e",
      "type": "heading",
      "level": 2,
      "content": "5. Government Wildlife Conservation Programs"
    },
    {
      "type": "paragraph",
      "id": "09o6v67",
      "content": "• Project Tiger (1973) – conservation of tigers."
    },
    {
      "type": "paragraph",
      "id": "7hn1f5b",
      "content": "• Project Elephant (1992) – conservation of elephants."
    },
    {
      "type": "paragraph",
      "id": "ud9bfaw",
      "content": "• Crocodile Conservation Project – protection of crocodiles."
    },
    {
      "type": "paragraph",
      "id": "wxxn4cz",
      "content": "• Wildlife Protection Act (1972) – legal framework for wildlife protection."
    },
    {
      "id": "qni18aq",
      "type": "heading",
      "level": 2,
      "content": "6. Importance of Wildlife Conservation"
    },
    {
      "type": "paragraph",
      "id": "ut5afws",
      "content": "• Maintains ecological balance."
    },
    {
      "type": "paragraph",
      "id": "6xt17ub",
      "content": "• Prevents extinction of endangered species."
    },
    {
      "type": "paragraph",
      "id": "ac0px3x",
      "content": "• Protects biodiversity."
    },
    {
      "type": "paragraph",
      "id": "vk84dee",
      "content": "• Supports eco-tourism and scientific research."
    },

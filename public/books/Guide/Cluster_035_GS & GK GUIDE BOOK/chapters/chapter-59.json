          "pH > 7"
        ],
        [
          "Water Solubility",
          "Generally soluble in water",
          "Soluble bases are called Alkalis"
        ],
        [
          "Reaction Outcome",
          "Reacts with bases to form salt and water",
          "Reacts with acids to form salt and water"
        ]
      ],
      "id": "y1rexsf"
    },
    {
      "type": "paragraph",
      "id": "rmo6pfb",
      "content": "pH &lt; 7 : Acidic solution"
    },
    {
      "type": "paragraph",
      "id": "qf09967",
      "content": "pH = 7 : Neutral solution"
    },
    {
      "type": "paragraph",
      "id": "xbq7zpu",
      "content": "pH &gt; 7 : Basic solution"
    },
    {
      "id": "s1ve9rw",

      "level": 2,
      "content": "Important Exam Points"
    },
    {
      "type": "paragraph",
      "id": "7siesq1",
      "content": "• Chlorophyll is responsible for photosynthesis."
    },
    {
      "type": "paragraph",
      "id": "x0epr64",
      "content": "• Xylem transports water while phloem transports food."
    },
    {
      "type": "paragraph",
      "id": "to3h2u7",
      "content": "• Auxin is responsible for plant growth."
    },
    {
      "type": "paragraph",
      "id": "gvjn47h",
      "content": "• Ethylene promotes fruit ripening."
    },
    {
      "type": "paragraph",
      "id": "rzfi9vt",
      "content": "• Angiosperms are flowering plants."
    }

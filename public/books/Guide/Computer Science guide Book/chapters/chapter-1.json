      "level": 2,
      "content": "1.2 Characteristics of Computer"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Type",
        "Data Handled",
        "Primary Characteristic"
      ],
      "rows": [
        [
          "Analog Computer",
          "Continuous physical signals",
          "Measures physical variables like voltage or temperature"
        ],
        [
          "Digital Computer",
          "Discrete binary data (0s and 1s)",
          "Performs high-speed calculations and logical operations"
        ],
        [
          "Hybrid Computer",
          "Both continuous and discrete data",
          "Combines the measuring speed of analog with the accuracy of digital"
        ]
      ],
      "id": "lqzyeg0"
    },
    {
      "id": "vwidqiv",
      "type": "list",
      "items": [
        "Speed – Performs millions of operations per second.",
        "Accuracy – Produces accurate results if input is correct.",
        "Diligence – Does not get tired.",
        "Storage – Can store huge amounts of data.",
        "Automation – Works automatically once instructions are given.",
        "Versatility – Can perform many types of tasks.",
        "Reliability – Produces consistent results."
      ]
    },
    {
      "id": "jyapp27",
      "type": "heading",
      "level": 2,
      "content": "1.3 Types of Computers (Analog, Digital, Hybrid)"

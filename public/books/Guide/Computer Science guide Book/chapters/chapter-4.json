{
  "id": "40d1j4v",
  "title": "Chapter 4: Input Devices",
  "order": 4,
  "blocks": [
    {
      "type": "paragraph",
      "id": "aabunhp",
      "content": "Input devices are hardware components used to enter data, instructions, or commands into a computer system. They allow users to interact with the computer and provide the raw data that the computer processes."
    },
    {
      "type": "statStrip",
      "stats": [
        {
          "label": "Primary Device",
          "value": "Keyboard",
          "icon": "book"
        },
        {
          "label": "Pointing Device",
          "value": "Mouse",
          "icon": "check"
        },
        {
          "label": "Optical Recognition",
          "value": "OMR & OCR",
          "icon": "info"
        },
        {
          "label": "Banking Technology",

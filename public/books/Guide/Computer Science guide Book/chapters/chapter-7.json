    {
      "id": "2zjfdyr",
      "type": "heading",
      "level": 2,
      "content": "7.3 System Software"
    },
    {
      "type": "paragraph",
      "id": "ktxzuhg",
      "content": "System software is a type of computer software that manages and controls the hardware of a computer system. It provides a platform for running application software."
    },
    {
      "id": "g6yaph9",
      "type": "heading",
      "level": 3,
      "content": "7.3.1 Functions of System Software"
    },
    {
      "id": "0au2m83",
      "type": "list",
      "items": [
        "Controls and manages hardware resources.",
        "Provides an interface between user and hardware.",
        "Manages memory and processing tasks.",
        "Handles input and output operations.",
        "Controls file management."
      ]
    },
    {
      "type": "pullQuote",
      "content": "System Software vs Application Software",
      "id": "vwesfui"
    },
    {
      "id": "m0lfjlw",

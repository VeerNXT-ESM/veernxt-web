            "<p><strong>Description</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Operating System</p>",
            "<p>Main system software that manages computer hardware and software resources.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Device Drivers</p>",
            "<p>Programs that allow the operating system to communicate with hardware devices.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Language Translators</p>",
            "<p>Convert programming languages into machine language.</p>"
          ]
        }
      ]
    },

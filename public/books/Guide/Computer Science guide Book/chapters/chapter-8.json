    {
      "type": "comparisonTable",
      "headers": [
        "OS Type",
        "Key Characteristics"
      ],
      "rows": [
        [
          "Batch Operating System",
          "Executes jobs grouped into batches sequentially without direct user interaction."
        ],
        [
          "Time Sharing Operating System",
          "Allocates dedicated CPU time slices to multiple users or tasks concurrently."
        ],
        [
          "Multiprocessing Operating System",
          "Utilizes two or more central processing units (CPUs) within a single system."
        ]

    },
    {
      "type": "comparisonTable",
      "headers": [
        "Operating System Type",
        "Key Characteristics & Processing Style"
      ],
      "rows": [
        [
          "Batch Operating System",
          "Jobs with similar needs are batched together and executed sequentially without user interaction."
        ],
        [
          "Time Sharing Operating System",
          "CPU time is divided into time slots (quanta) shared among multiple users for interactive execution."
        ],
        [
          "Multiprocessing Operating System",
          " Employs two or more central processing units (CPUs) working simultaneously within a single system."
        ]
      ],
      "id": "fsk8rmk"

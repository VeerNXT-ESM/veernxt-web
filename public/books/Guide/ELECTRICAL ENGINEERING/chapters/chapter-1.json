      "content": "<strong>PREFACE</strong>"
    },
    {
      "type": "paragraph",
      "id": "pxre69n",
      "content": "This Electrical Engineering Guide Book is part of the VeerNXT PSU Navratna Series. It is written specifically for engineers appearing in recruitment examinations conducted by BEL, NALCO, NLC India, NHPC, SJVN, RINL, NBCC, SECI, IRCON, RVNL, RITES, Mazagon Dock, and other PSUs that test Electrical Engineering knowledge in their Computer Based Tests (CBTs)."
    },
    {
      "id": "ufuibr7",
      "type": "image",
      "imageId": "c36qz9w",
      "src": "/books/Guide/ELECTRICAL ENGINEERING/images/image_c36qz9w.png"
    },
    {
      "id": "usgejc1",
      "type": "image",

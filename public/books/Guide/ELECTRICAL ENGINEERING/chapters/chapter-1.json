      "type": "heading",
      "level": 4,
      "id": "yx9a7a6",
      "content": "        (C)  4R"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "ka229xr",
      "content": "        (D)  R/4"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "jfolx9r",
      "content": "<strong>Answer: </strong>(C)"
    },
    {
      "type": "paragraph",
      "id": "vgkza6m",

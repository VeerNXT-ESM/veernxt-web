      "headers": [
        "Degree of Comparison",
        "Usage / Function",
        "Example Form"
      ],
      "rows": [
        [
          "Positive Degree",
          "States the simple existence of a quality without direct comparison",
          "Tall, Wise, Beautiful"
        ],
        [
          "Comparative Degree",
          "Compares a quality between exactly two persons, places, or things",
          "Taller, Wiser, More Beautiful"
        ],
        [
          "Superlative Degree",
          "Denotes the highest or lowest degree of quality among three or more entities",
          "Tallest, Wisest, Most Beautiful"
        ]

    },
    {
      "type": "comparisonTable",
      "headers": [
        "Adverb Pair",
        "Meaning & Usage",
        "Exam Example"
      ],
      "rows": [
        [
          "Hard vs. Hardly",
          "'Hard' means with great energy/effort; 'Hardly' means scarcely or almost not at all.",
          "He works hard. / He hardly works."
        ],
        [
          "Very vs. Too",
          "'Very' simply intensifies degree; 'Too' implies excess with an undesirable/negative result.",
          "The tea is very hot. / The tea is too hot to drink."
        ],
        [
          "Late vs. Lately",
          "'Late' means after the expected or usual time; 'Lately' means recently.",
          "He reached late. / I haven't met him lately."
        ]
      ],
      "id": "nkgo30v"
    },

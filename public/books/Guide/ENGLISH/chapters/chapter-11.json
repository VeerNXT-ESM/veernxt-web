    {
      "type": "examAlert",
      "items": [
        "Never use 'not' or 'no' with negative words like 'hardly', 'scarcely', 'barely', or 'unless'.",
        "Remember the correct modifier order: 'Enough' follows adjectives (e.g., 'wise enough', NOT 'enough wise').",
        "Do not confuse 'Too' (excessive/negative context) with 'Very' (high degree/neutral context)."
      ],

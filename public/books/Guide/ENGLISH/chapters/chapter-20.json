      "rows": [
        [
          "Atheist",
          "A person who disbelieves or lacks belief in the existence of God",
          "a- (without) + theos (god)"
        ],
        [
          "Agnostic",
          "A person who believes that nothing is known or can be known of God",
          "a- (without) + gnosis (knowledge)"
        ],
        [
          "Monotheist",
          "A person who believes that there is only one God",
          "mono- (single) + theos (god)"
        ],
        [
          "Polytheist",
          "A person who believes in or worships more than one God",
          "poly- (many) + theos (god)"
        ]
      ],

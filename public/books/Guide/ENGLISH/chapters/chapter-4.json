    {
      "type": "paragraph",
      "id": "cwxdudj"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Modal Category",
        "Usage Context",
        "Key Exam Rule"
      ],
      "rows": [
        [
          "May vs Might",
          "Possibility & Permission",
          "'May' indicates higher probability or formal permission; 'Might' indicates weak or remote possibility."
        ],
        [
          "Should vs Must vs Ought to",
          "Advice, Compulsion & Duty",
          "'Should' implies recommendation; 'Must' implies mandatory rule/compulsion; 'Ought to' expresses moral duty."
        ],
        [
          "Need / Dare (Modal vs Main)",
          "Necessity & Courage",
          "As modals: followed by V1 without 'to' in negatives ('Need not stay'); as main verbs: follow standard tense rules with 'to' ('Does not need to stay')."
        ]
      ],
      "id": "eh00jte"
    },

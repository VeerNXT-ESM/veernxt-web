    {
      "type": "comparisonTable",
      "headers": [
        "Direct Speech",
        "Indirect Speech"
      ],
      "rows": [
        [
          "Encloses exact spoken words within inverted commas",
          "Removes inverted commas and uses conjunctions like 'that', 'if', or 'to'"
        ],
        [
          "Retains original speaker tenses",
          "Applies Backshift Rule if the reporting verb is in the past tense"
        ],
        [
          "Uses direct time and place adverbs (e.g., 'today', 'now')",
          "Converts adverbs of time and place (e.g., 'that day', 'then')"
        ],
        [
          "Punctuation includes question marks and exclamation marks inside quotes",
          "Converts all sentence types into assertive statements ending with a full stop"
        ]
      ],
      "id": "kcgl1jg"

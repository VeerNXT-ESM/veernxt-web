    {
      "type": "comparisonTable",
      "headers": [
        "Preposition Pair",
        "Core Difference",
        "Correct Context Example"
      ],
      "rows": [
        [
          "In vs Into",
          "'In' indicates static location; 'Into' denotes movement entering inside.",
          "He is sitting in the hall / He walked into the hall."
        ],
        [
          "Between vs Among",
          "'Between' is used for two entities; 'Among' is used for three or more.",
          "Divide the work between A and B / Divide the work among all members."
        ],
        [
          "Since vs For",
          "'Since' indicates a specific starting point; 'For' denotes total duration.",
          "Studying since 8 AM / Studying for 3 hours."
        ],
        [
          "Beside vs Besides",
          "'Beside' means adjacent to; 'Besides' means in addition to.",
          "Sit beside me / Besides physics, she likes math."
        ]
      ],
      "id": "r46q0hf"
    },

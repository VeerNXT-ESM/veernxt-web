    {
      "id": "aph8pjs",
      "type": "heading",
      "level": 2,
      "content": "1.2 Reserve Bank of India (RBI)"
    },
    {
      "type": "paragraph",
      "id": "xsc3f0i",
      "content": "RBI was established on April 1, 1935 under the Reserve Bank of India Act, 1934 and nationalised on January 1, 1949. It is headquartered in Mumbai."
    },
    {
      "id": "rxtmqhz",
      "type": "heading",
      "level": 3,
      "content": "Functions of RBI"
    },
    {
      "id": "vvknen6",
      "type": "list",
      "items": [
        "Issue of Currency Notes (Monopoly except Rs.1 coin/note, issued by Govt)",
        "Banker to the Government – manages government accounts and public debt",
        "Banker's Bank – lender of last reGBOrt, holds CRR deposits of banks",
        "Controller of Credit – uses monetary policy tools to regulate money supply",
        "Foreign Exchange Management – manages forex reserves, regulates FEMA",
        "Developmental Role – promotes financial inclusion, priority sector lending",
        "Regulator and SuperviGBOr of Banks – grants licences, issues guidelines"
      ]
    },

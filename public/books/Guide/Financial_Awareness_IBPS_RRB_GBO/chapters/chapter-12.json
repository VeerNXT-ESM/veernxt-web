    {
      "type": "pullQuote",
      "content": "A robust grasp of key financial terms is essential for mastering economic policy and regulatory frameworks in competitive examinations.",
      "id": "973tqgs"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Financial Instrument / Term",
        "Primary Purpose",
        "Governing Body"
      ],
      "rows": [
        [
          "Repo Rate",
          "Short-term borrowing rate for banks from RBI against securities",
          "Reserve Bank of India"
        ],
        [
          "Reverse Repo Rate",
          "Rate at which RBI absorbs excess liquidity from commercial banks",
          "Reserve Bank of India"
        ],
        [
          "CRR (Cash Reserve Ratio)",
          "Mandatory cash reserve requirement held with RBI earning no interest",
          "Reserve Bank of India"
        ],
        [
          "SLR (Statutory Liquidity Ratio)",
          "Mandatory liquid asset reserve maintained by commercial banks themselves",
          "Reserve Bank of India"
        ]
      ],
      "id": "t8p3ysj"

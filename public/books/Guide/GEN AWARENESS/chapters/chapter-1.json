    {
      "id": "unr0g1i",
      "type": "heading",
      "level": 3,
      "content": "5.Town Planning"
    },
    {
      "type": "paragraph",
      "id": "r1pbcaw",
      "content": "• Cities were divided into Citadel and Lower Town"
    },
    {
      "type": "paragraph",
      "id": "gr1nrwg",
      "content": "• Houses were made of baked bricks"
    },
    {
      "type": "paragraph",
      "id": "1frfer4",
      "content": "• Roads intersected at right angles"
    },
    {
      "type": "paragraph",
      "id": "pm37ehf",
      "content": "• Covered drainage system was highly advanced"
    },
    {
      "id": "i74cnn7",
      "type": "heading",
      "level": 3,
      "content": "6.Economy"
    },
    {
      "type": "paragraph",
      "id": "8bcy6x8",
      "content": "• Agriculture was the main occupation"
    },

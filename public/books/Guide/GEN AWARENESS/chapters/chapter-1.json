      "level": 3,
      "content": "7.Religion"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "3v7uo18",
      "content": "• Worship of Mother Goddess"
    },
    {
      "type": "paragraph",
      "id": "ydtv96s",
      "content": "• Pashupati seal suggests proto‑Shiva worship                                                     "
    },
    {
      "type": "paragraph",
      "id": "zv6zdz0",
      "content": "• Sacred animals included bull and unicorn"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "fvu0k8i",
      "content": "• Peepal tree considered sacred"
    },
    {
      "id": "mu9wktr",

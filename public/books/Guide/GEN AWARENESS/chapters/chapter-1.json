    {
      "type": "paragraph",
      "id": "ldiz2dy",
      "content": "• Wheat and barley were major crops"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "al8qgdd",
      "content": "• Trade existed with Mesopotamia"
    },
    {
      "type": "paragraph",
      "id": "b5tio8y",
      "content": "• Standard weights and measures were used"
    },
    {
      "id": "ijp8i4u",

    {
      "type": "comparisonTable",
      "headers": [
        "Feature",
        "Supreme Court (Article 32)",
        "High Court (Article 226)"
      ],
      "rows": [
        [
          "Scope of Jurisdiction",
          "Narrower: Can issue writs strictly for the enforcement of Fundamental Rights",
          "Wider: Can issue writs for Fundamental Rights as well as ordinary legal rights"
        ],
        [
          "Territorial Jurisdiction",
          "Wider: Applicable throughout the entire territory of India",
          "Narrower: Enforceable only within its specific state or territorial limit"
        ],
        [
          "Remedial Status",
          "Mandatory: Article 32 itself is a Fundamental Right, so the SC cannot refuse relief",
          "Discretionary: High Court may refuse to grant relief if alternative remedies exist"
        ]
      ],
      "id": "szyg3gw"

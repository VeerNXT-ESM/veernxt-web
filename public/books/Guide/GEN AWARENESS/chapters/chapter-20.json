    {
      "type": "examAlert",
      "items": [
        "Nominated members of Parliament do not participate in the Presidential election, but they DO participate in the impeachment process.",
        "Elected members of State Legislative Assemblies participate in the election, but do NOT participate in the impeachment process.",
        "Pardoning power under Article 72 is an executive power that extends to all cases where punishment is by a Court Martial or for a death sentence."
      ],
      "id": "3ss0sok"

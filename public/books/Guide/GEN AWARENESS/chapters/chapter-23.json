    {
      "id": "ectsuki",
      "type": "heading",
      "level": 2,
      "content": "7. Legislative Process"
    },
    {
      "type": "paragraph",
      "id": "6fm0w1o",
      "content": "• First Reading – Introduction of the bill."
    },
    {
      "type": "paragraph",
      "id": "az4ckas",
      "content": "• Second Reading – Detailed discussion and committee stage."
    },
    {
      "type": "paragraph",
      "id": "xo4339e",
      "content": "• Third Reading – Final voting."
    },
    {
      "type": "paragraph",
      "id": "konrqaq",
      "content": "• Bill sent to the other House."
    },
    {
      "type": "paragraph",
      "id": "uv4fw2t",
      "content": "• President’s assent required for law."
    },
    {

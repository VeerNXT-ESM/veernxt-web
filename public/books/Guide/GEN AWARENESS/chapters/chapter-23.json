      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Part</strong></p>",
            "<p><strong>Description</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>President</p>",
            "<p>Part of Parliament; gives assent to bills</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Lok Sabha</p>",
            "<p>Lower House representing the people</p>"
          ]
        },
        {
          "isHeader": false,

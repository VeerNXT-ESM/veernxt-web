          "value": "3 (Crust, Mantle, Core)",
          "icon": "layers"
        },
        {
          "label": "Mantle Volume",
          "value": "84% of Earth",
          "icon": "pie-chart"
        },
        {
          "label": "Core Composition",
          "value": "NIFE (Ni & Fe)",
          "icon": "award"

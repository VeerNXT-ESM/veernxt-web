          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Mantle</p>",
            "<p>35–2900 km</p>",
            "<p>Silicate minerals</p>",
            "<p>Largest layer; convection currents occur</p>"
          ]
        },
        {

        },
        {
          "isHeader": false,
          "cells": [
            "<p>Troposphere</p>",
            "<p>0–12 km</p>",
            "<p>Weather phenomena occur here; temperature decreases with height</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Stratosphere</p>",
            "<p>12–50 km</p>",
            "<p>Contains ozone layer; temperature increases with height</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Mesosphere</p>",
            "<p>50–80 km</p>",
            "<p>Coldest layer; meteors burn here</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Thermosphere</p>",

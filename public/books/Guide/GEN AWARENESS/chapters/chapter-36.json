      "content": "5. Drainage Patterns in India"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Feature",
        "Himalayan Rivers",
        "Peninsular Rivers"
      ],
      "rows": [
        [
          "Origin",
          "Himalayan glaciers and snowfields",
          "Peninsular plateaus and coastal hills"
        ],
        [
          "Nature of Flow",
          "Perennial (fed by glacier melt and rainfall)",
          "Seasonal (dependent entirely on rainfall)"
        ],
        [
          "Valleys & Courses",
          "V-shaped valleys, gorges, long courses",
          "Broad, shallow valleys, shorter courses"
        ],
        [
          "Outfall Delta/Estuary",
          "Form large deltas at river mouths",
          "East-flowing form deltas; West-flowing form estuaries"
        ]
      ],
      "id": "af0zjui"
    },
    {
      "type": "paragraph",
      "id": "v0475l7",
      "content": "• Dendritic – tree-like pattern (most common)."
    },
    {
      "type": "paragraph",
      "id": "gntb8ws",
      "content": "• Trellis – right-angle pattern due to hard and soft rocks."
    },
    {
      "type": "paragraph",
      "id": "l4wp36e",
      "content": "• Radial – rivers flow outward from a central high point."
    },
    {
      "type": "paragraph",
      "id": "mw5e4vl",
      "content": "• Centripetal – rivers flow towards a central basin."
    },

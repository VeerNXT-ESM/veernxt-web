        },
        {
          "isHeader": false,
          "cells": [
            "<p>National Parks</p>",
            "<p>Strictly protected areas where wildlife and habitat are fully protected; no human activity allowed</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Wildlife Sanctuaries</p>",
            "<p>Areas where animals are protected but limited human activities may be allowed</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Biosphere Reserves</p>",
            "<p>Large areas protecting biodiversity, ecosystems and traditional communities</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Tiger Reserves</p>",
            "<p>Special reserves created under Project Tiger to conserve tigers</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Bird Sanctuaries</p>",
            "<p>Protected areas mainly for migratory and native birds</p>"
          ]
        }
      ]

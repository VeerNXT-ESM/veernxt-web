    },
    {
      "type": "paragraph",
      "id": "bexsik9",
      "content": "• North-Eastern Plateau Region – Chota Nagpur Plateau rich in coal, iron, manganese and mica."
    },
    {
      "type": "paragraph",
      "id": "zyf30gf",
      "content": "• South-Western Plateau Region – Karnataka and Tamil Nadu rich in iron ore and bauxite."
    },
    {
      "type": "paragraph",
      "id": "wpyawgy",
      "content": "• North-Western Region – Rajasthan rich in copper and zinc."
    },
    {
      "type": "paragraph",
      "id": "bez6e3s",
      "content": "• Central Belt – Madhya Pradesh and Chhattisgarh rich in minerals."
    },

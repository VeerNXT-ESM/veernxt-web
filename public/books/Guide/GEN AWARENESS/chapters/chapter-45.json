      "content": "5. Factors Affecting Industrial Location"
    },
    {
      "type": "paragraph",
      "id": "nmv3l5h",
      "content": "• Availability of raw materials."
    },
    {
      "type": "paragraph",
      "id": "rb4ig5p",
      "content": "• Availability of labour."
    },
    {
      "type": "paragraph",
      "id": "7m8jqde",
      "content": "• Availability of power supply."
    },

    {
      "type": "examAlert",
      "items": [
        "Article 112 covers the Annual Financial Statement (Union Budget) presented by the Finance Minister.",
        "Goods and Services Tax (GST) was introduced via the 101st Constitutional Amendment Act, 2016.",
        "Disinvestment receipts and recovery of loans are classified as Capital Receipts, not Revenue Receipts.",
        "Primary Deficit equals Fiscal Deficit minus net interest payments."
      ],

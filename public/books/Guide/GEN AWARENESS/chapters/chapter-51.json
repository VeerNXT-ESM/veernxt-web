      "type": "comparisonTable",
      "headers": [
        "Type of Work",
        "Angle (θ) between F and S",
        "Common Example"
      ],
      "rows": [
        [
          "Positive Work",
          "θ < 90° (cos θ > 0)",
          "A body falling freely towards Earth under gravity"
        ],
        [
          "Negative Work",
          "θ > 90° (cos θ < 0)",
          "Work done by frictional force against the direction of motion"
        ],
        [
          "Zero Work",
          "θ = 90° or s = 0",
          "Pushing a rigid wall or carrying a load horizontally"

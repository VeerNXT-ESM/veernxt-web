{
  "id": "l9tfhhr",
  "title": "Chapter 16: Nutrition and Health",
  "order": 65,
  "blocks": [
    {
      "type": "paragraph",
      "id": "i42uik9",
      "content": "Nutrition is the process by which living organisms obtain food and use it for energy, growth, repair and maintenance of the body. Proper nutrition is essential for maintaining health, preventing diseases and ensuring proper development of the body."
    },
    {
      "type": "statStrip",
      "stats": [
        {
          "label": "Key Topic",
          "value": "Nutrition and Health",
          "icon": "book"
        },

    {
      "id": "y0hlxa6",
      "type": "heading",
      "level": 2,
      "content": "3. Babur (1526–1530)"
    },
    {
      "type": "paragraph",
      "id": "j19aatq",
      "content": "• Founder of the Mughal Empire."
    },
    {
      "type": "paragraph",
      "id": "e65gpu1",
      "content": "• Introduced gunpowder and field artillery in Indian warfare."
    },
    {
      "type": "paragraph",
      "id": "vf3w7xv",
      "content": "• Wrote his autobiography 'Baburnama'."
    },
    {
      "type": "paragraph",
      "id": "usi1sy0",
      "content": "• Defeated Rana Sanga in the Battle of Khanwa."
    },
    {
      "id": "19q893d",
      "type": "heading",
      "level": 2,
      "content": "4. Humayun"
    },
    {
      "type": "paragraph",
      "id": "dnyl1w6",
      "content": "• Son of Babur."
    },
    {
      "type": "paragraph",
      "id": "mvoi5ls",
      "content": "• Defeated by Sher Shah Suri in the Battle of Kannauj."
    },
    {
      "type": "paragraph",
      "id": "5w2qkwp",
      "content": "• Spent years in exile before regaining the throne with Persian support."
    },
    {
      "type": "paragraph",
      "id": "q1rie95",
      "content": "• Died in 1556 after falling from the stairs of his library."
    },
    {
      "id": "shokqn1",
      "type": "heading",
      "level": 2,
      "content": "5. Akbar the Great"
    },
    {
      "type": "paragraph",
      "id": "cm38sex",
      "content": "• Became emperor in 1556."
    },
    {
      "type": "paragraph",
      "id": "9t8ypzr",
      "content": "• Defeated Hemu in the Second Battle of Panipat."
    },
    {
      "type": "paragraph",
      "id": "ly042j8",
      "content": "• Introduced important administrative reforms."
    },
    {
      "type": "paragraph",
      "id": "t8ydjun",
      "content": "• Started the policy of religious tolerance (Sulh-i-Kul)."
    },
    {
      "type": "paragraph",
      "id": "2rrq34s",
      "content": "• Founded Din-i-Ilahi."
    },
    {

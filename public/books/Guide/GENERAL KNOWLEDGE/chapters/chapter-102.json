      "items": [
        "<ul><li>Electric current = Q / t</li><li>V = IR</li><li>Power = VI</li><li>1 unit = 1 kWh</li><li>Fuse protects circuit</li><li>Heating effect produces heat</li></ul>",
        "Electric current = Q / t",
        "V = IR",
        "Power = VI",
        "1 unit = 1 kWh",
        "Fuse protects circuit",
        "Heating effect produces heat"
      ]
    }
  ],

    {
      "type": "paragraph",
      "id": "v9322iz",
      "content": "Global warming is the rise in Earth's temperature due to greenhouse gases. Main causes:"
    },
    {
      "id": "g31ohcp",
      "type": "list",
      "items": [
        "<ul><li>Burning fossil fuels</li><li>Deforestation</li><li>Industrial activities</li></ul>",
        "Burning fossil fuels",
        "Deforestation",
        "Industrial activities"
      ]
    },
    {

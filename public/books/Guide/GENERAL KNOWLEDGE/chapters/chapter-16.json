        "Key Characteristics"
      ],
      "rows": [
        [
          "Convectional Rainfall",
          "Intense solar heating of the Earth's surface",
          "Common in equatorial zones; heavy afternoon convectional showers"
        ],
        [
          "Orographic Rainfall",
          "Moist air forced to ascend over mountain barriers",
          "Creates distinct windward rain zones and leeward rain-shadow regions"
        ],
        [
          "Cyclonic Rainfall",
          "Convergence and uplifting of warm and cold air masses",
          "Associated with frontal systems and tropical/extra-tropical cyclones"
        ]

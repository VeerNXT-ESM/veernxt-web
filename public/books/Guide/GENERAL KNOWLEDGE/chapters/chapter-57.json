    {
      "id": "gga2xgl",
      "type": "heading",
      "level": 2,
      "content": "PARLIAMENT OF INDIA"
    },
    {
      "type": "keyFacts",
      "title": "Key Takeaways",
      "items": [
        "Parliament of India comprises the President, Rajya Sabha (Council of States), and Lok Sabha (House of the People).",
        "Money Bills under Article 110 can only be introduced in Lok Sabha with the prior recommendation of the President.",
        "A Joint Sitting under Article 108 is summoned by the President and presided over by the Speaker of Lok Sabha.",
        "Disqualification under the Anti-Defection Law (10th Schedule) is determined by the Presiding Officer of the House.",
        "Quorum to conduct a meeting of either House is one-tenth of the total membership."
      ],
      "id": "0ptaig5"
    },

    },
    {
      "id": "dk151qd",
      "type": "heading",
      "level": 3,
      "content": "10. Meaning of Monetary Policy"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Monetary Tool",
        "Key Characteristic / Mechanism"
      ],
      "rows": [
        [
          "Cash Reserve Ratio (CRR)",
          "Percentage of bank deposits that must be kept as cash reserves with the RBI."
        ],
        [
          "Statutory Liquidity Ratio (SLR)",
          "Percentage of bank deposits maintained in liquid assets like gold or government securities."
        ],
        [
          "Repo Rate",
          "Interest rate at which RBI lends short-term funds to commercial banks against collateral."
        ],
        [
          "Reverse Repo Rate",
          "Interest rate at which commercial banks park excess liquidity with the RBI."
        ],
        [
          "Open Market Operations (OMO)",
          "Buying and selling of government securities by RBI in the open market to manage market liquidity."
        ]
      ],
      "id": "lr5wrap"
    },

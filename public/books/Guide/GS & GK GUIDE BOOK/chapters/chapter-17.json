          ]
        }
      ]
    },
    {
      "id": "es1zwv6",
      "type": "heading",
      "level": 2,
      "content": "6. Freedom of Religion (Articles 25–28)"
    },
    {
      "id": "5mkt7im",
      "type": "table",
      "rows": [
        {
          "isHeader": true,

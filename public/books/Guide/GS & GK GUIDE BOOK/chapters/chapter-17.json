            "<p><strong>Article</strong></p>",
            "<p><strong>Provision</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Article 25</p>",
            "<p>Freedom of conscience and free profession of religion</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Article 26</p>",
            "<p>Freedom to manage religious affairs</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

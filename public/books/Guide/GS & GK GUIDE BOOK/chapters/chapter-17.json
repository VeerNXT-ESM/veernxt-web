      "type": "comparisonTable",
      "headers": [
        "Feature",
        "Article 32 (Supreme Court)",
        "Article 226 (High Court)"
      ],
      "rows": [
        [
          "Jurisdictional Scope",
          "Narrower: Can issue writs ONLY for Fundamental Rights",
          "Wider: Can issue writs for Fundamental Rights AND ordinary legal rights"
        ],
        [
          "Territorial Reach",
          "Enforces writs throughout the entire territory of India",
          "Enforces writs within its state territorial jurisdiction"
        ],
        [
          "Constitutional Status",
          "A Fundamental Right in itself (Right to Constitutional Remedies)",
          "A discretionary constitutional power, not a Fundamental Right"
        ]

      "rows": [
        [
          "Socialist Principles",
          "Aim to provide social and economic justice and lay down the framework for a welfare state."
        ],
        [
          "Gandhian Principles",
          "Based on Gandhian ideology representing the programme of reconstruction enunciated by Gandhi during the national movement."
        ],
        [
          "Liberal–Intellectual Principles",
          "Incline towards the ideology of liberalism, covering uniform laws, environment protection, and international peace."

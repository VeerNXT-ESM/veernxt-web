    {
      "type": "comparisonTable",
      "headers": [
        "Feature",
        "Early Vedic Period (1500–1000 BCE)",
        "Later Vedic Period (1000–500 BCE)"
      ],
      "rows": [
        [
          "Economic Base",
          "Predominantly pastoral; wealth measured in cattle (Gau)",
          "Settled agriculture; widespread use of iron technology"
        ],
        [
          "Political Structure",
          "Tribal chief (Rajan) with limited power checked by assemblies",
          "Hereditary monarchy with centralized power and large armies"
        ],
        [
          "Role of Assemblies",
          "Sabha, Samiti, and Vidatha played prominent political roles",
          "Importance of political assemblies declined; women excluded"
        ],
        [
          "Primary Deities",
          "Indra (Thunder), Agni (Fire), Varuna (Water)",
          "Prajapati (Creator), Vishnu (Preserver), Rudra (Destroyer)"
        ]
      ],
      "id": "n5tix0v"

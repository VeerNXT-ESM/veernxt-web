    {
      "type": "examAlert",
      "items": [
        "Nominated members of Parliament do NOT participate in the Presidential election, but they DO vote in the impeachment process.",
        "State Legislative Assembly (MLAs) members vote in the Presidential election, but do NOT participate in the impeachment process.",
        "Emergency powers are invoked under Article 352 (National), Article 356 (State/President's Rule), and Article 360 (Financial)."
      ],
      "id": "dgccts4"

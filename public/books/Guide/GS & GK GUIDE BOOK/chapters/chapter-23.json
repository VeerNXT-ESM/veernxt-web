      "content": "2. Structure of Parliament"
    },
    {
      "id": "g54di98",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Part</strong></p>",
            "<p><strong>Description</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>President</p>",
            "<p>Part of Parliament; gives assent to bills</p>"
          ]
        },
        {
          "isHeader": false,

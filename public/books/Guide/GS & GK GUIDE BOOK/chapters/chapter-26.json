            "<p>Head important departments</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Ministers of State</p>",
            "<p>Assist cabinet ministers</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Deputy Ministers</p>",
            "<p>Assist ministers in administrative work</p>"
          ]
        }
      ]
    },

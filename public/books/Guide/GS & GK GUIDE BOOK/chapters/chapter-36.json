      "content": "5. Drainage Patterns in India"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "East Flowing Rivers",
        "West Flowing Rivers"
      ],
      "rows": [
        [
          "Drain into the Bay of Bengal",
          "Drain into the Arabian Sea"
        ],
        [
          "Form extensive deltas at their mouths",
          "Form estuaries rather than deltas"
        ]
      ],
      "id": "bbvmf18"
    },
    {
      "type": "paragraph",
      "id": "vts32q4",
      "content": "• Dendritic – tree-like pattern (most common)."
    },
    {
      "type": "paragraph",
      "id": "swn39q2",
      "content": "• Trellis – right-angle pattern due to hard and soft rocks."
    },
    {
      "type": "paragraph",
      "id": "8y7z7oi",
      "content": "• Radial – rivers flow outward from a central high point."
    },
    {
      "type": "paragraph",
      "id": "1vd6vcq",
      "content": "• Centripetal – rivers flow towards a central basin."
    },
    {
      "id": "nts45x1",

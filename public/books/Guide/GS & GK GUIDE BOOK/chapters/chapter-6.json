    {
      "type": "comparisonTable",
      "headers": [
        "Aspect",
        "Alauddin Khilji",
        "Muhammad bin Tughlaq"
      ],
      "rows": [
        [
          "Economic Reforms",
          "Implemented strict price control and market regulation through Shahna-i-Mandi.",
          "Introduced bronze/copper token currency which failed due to widespread counterfeiting."
        ],
        [
          "Capital & Geography",
          "Maintained Delhi as the capital while expanding military campaigns into the Deccan.",
          "Shifted capital from Delhi to Devagiri (Daulatabad) and forced population migration."
        ],
        [
          "Military System",
          "Introduced direct cash payments to soldiers, Dagh (branding), and Chehra (descriptive roll).",
          "Maintained a massive standing army but faced multiple rebellions across the realm."
        ]
      ],

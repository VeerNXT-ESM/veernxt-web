          "isHeader": false,
          "cells": [
            "<p>Summer</p>",
            "<p>March to May</p>",
            "<p>Hot and humid; temperatures 32°C–40°C; high humidity</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Monsoon</p>",

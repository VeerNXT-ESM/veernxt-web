        },
        {
          "isHeader": false,
          "cells": [
            "<p>Goa Carnival</p>",
            "<p>February (before Lent)</p>",
            "<p>Four-day street festival; Portuguese legacy; floats, dances, music</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Shigmo (Holi of Goa)</p>",
            "<p>February/March</p>",
            "<p>Hindu spring festival; folk dances and processions for 14 days</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sao Joao</p>",
            "<p>June 24</p>",
            "<p>Feast of St. John the Baptist; men jump into wells; villages fill with fern crowns</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Ganesh Chaturthi</p>",
            "<p>August/September</p>",
            "<p>Major Hindu festival; Fugdi and other dances</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Bonderam Festival</p>",
            "<p>August</p>",
            "<p>Flag festival on Divar Island; celebrates old boundary disputes</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Feast of St. Francis Xavier</p>",
            "<p>December 3</p>",
            "<p>Major Christian festival at Bom Jesus Basilica</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Christmas and New Year</p>",
            "<p>December 25 – Jan 1</p>",
            "<p>Peak tourist season; midnight mass; parties</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Diwali</p>",
            "<p>October/November</p>",
            "<p>Celebrated with effigies of Narkasur (demon) — unique to Goa</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Exposition of St. Francis Xavier</p>",
            "<p>Every 10 years</p>",
            "<p>Body of St. Francis Xavier publicly displayed; last in 2024</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IFFI (Int'l Film Festival of India)</p>",
            "<p>November</p>",
            "<p>Held in Panaji every November; one of India's most prestigious film festivals</p>"
          ]
        }
      ]
    },

      "content": "10.2 Important Constitutional Amendments"
    },
    {
      "id": "z9z49lv",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Amendment</strong></p>",
            "<p><strong>Year</strong></p>",
            "<p><strong>Key Change</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>1st Amendment</p>",
            "<p>1951</p>",
            "<p>Enables restrictions on freedom of speech for social order; saves land reform laws</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>7th Amendment</p>",
            "<p>1956</p>",
            "<p>States Reorganisation; abolished Part B States</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>14th Amendment</p>",
            "<p>1962</p>",
            "<p>Added Pondicherry and others as UTs; Goa, Daman and Diu as UT</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>24th Amendment</p>",
            "<p>1971</p>",
            "<p>Parliament's power to amend Fundamental Rights (after Golak Nath case)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>42nd Amendment</p>",
            "<p>1976</p>",
            "<p>Added Fundamental Duties; Socialist, Secular, Integrity to Preamble</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>44th Amendment</p>",
            "<p>1978</p>",
            "<p>Removed Right to Property from Fundamental Rights (Article 300A — legal right)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>52nd Amendment</p>",
            "<p>1985</p>",
            "<p>Anti-Defection Law (10th Schedule)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>56th Amendment</p>",
            "<p>1987</p>",
            "<p>Goa granted statehood — 25th State</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>61st Amendment</p>",
            "<p>1988</p>",
            "<p>Voting age lowered from 21 to 18</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>71st Amendment</p>",
            "<p>1992</p>",
            "<p>Konkani, Manipuri, Nepali added to 8th Schedule</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>73rd Amendment</p>",
            "<p>1992</p>",
            "<p>Constitutional status to Panchayati Raj — Part IX added</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>74th Amendment</p>",
            "<p>1992</p>",
            "<p>Constitutional status to Urban Local Bodies — Part IX-A added</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>86th Amendment</p>",
            "<p>2002</p>",
            "<p>Right to Education as Fundamental Right — Article 21A</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>91st Amendment</p>",
            "<p>2003</p>",
            "<p>Maximum size of Council of Ministers (15% of legislature)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>97th Amendment</p>",
            "<p>2011</p>",
            "<p>Right to form Cooperative Societies — Part IX-B</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>100th Amendment</p>",
            "<p>2015</p>",
            "<p>Land Boundary Agreement with Bangladesh</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>101st Amendment</p>",
            "<p>2016</p>",
            "<p>GST — Goods and Services Tax</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>102nd Amendment</p>",
            "<p>2018</p>",
            "<p>Constitutional status to NCBC (National Commission for Backward Classes)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>103rd Amendment</p>",
            "<p>2019</p>",
            "<p>10% reservation for Economically Weaker Sections (EWS)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>105th Amendment</p>",
            "<p>2021</p>",
            "<p>States restored power to identify OBCs</p>"
          ]
        }
      ]

      "content": "5.5 Music, Dance and Performing Arts"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Cultural Element",
        "Cultural Origin",
        "Key Characteristics & Features"
      ],
      "rows": [
        [
          "Shigmo",
          "Traditional Hindu",
          "Spring harvest festival featuring street parades, mythology enactments, and folk dances like Ghode Modni."
        ],
        [
          "Carnival",
          "Portuguese Catholic",
          "Pre-Lenten festival with grand parades, music, costumed revelers, and led symbolically by King Momo."
        ],
        [
          "Fugdi & Dhalo",
          "Indigenous Goan",
          "Folk dances traditionally performed by Goan women during religious rituals and festive occasions."
        ],
        [
          "Mando & Corridinho",
          "Indo-Portuguese",
          "Musical and dance genres reflecting a fusion of Western classical music with Goan vocal traditions."
        ]
      ],

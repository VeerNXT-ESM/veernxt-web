    {
      "type": "examAlert",
      "items": [
        "Basilica of Bom Jesus contains the mortal remains of St. Francis Xavier, making it a recurring topic in competitive exams.",
        "Cashew Feni was granted Geographical Indication (GI) status in 2009 under agricultural products.",
        "Tambdi Surla Temple is constructed from weather-resistant black basalt in the Kadamba-Yadava architectural style.",
        "Distinguish between Shigmo (a traditional Goan Hindu spring festival) and Carnival (a pre-Lenten Catholic tradition introduced by Portuguese rule)."
      ],
      "id": "rkcubwc"
    },

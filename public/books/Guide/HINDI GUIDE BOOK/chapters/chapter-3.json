          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>नि/नि:</p>",
            "<p>नीचे/में/बिना</p>",
            "<p>निकास, निर्बल, नि:शब्द</p>"
          ]
        }
      ]
    },
    {

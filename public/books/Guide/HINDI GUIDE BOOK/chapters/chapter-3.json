            "<p>अवगुण, अवसर, अवनति</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>आ</p>",
            "<p>तक/से/सामने</p>",
            "<p>आगमन, आकर्षण, आजीवन</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>उत्/उद्</p>",
            "<p>ऊपर/श्रेष्ठ</p>",
            "<p>उत्पत्ति, उद्योग, उद्धार</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

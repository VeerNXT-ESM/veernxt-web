    {
      "type": "heading",
      "level": 4,
      "id": "tjmsuhl",
      "content": "<strong>वाक्य-शुद्धि के नियम</strong>"
    },
    {
      "id": "tqhokik",
      "type": "numberedList",
      "items": [
        "लिंग के अनुसार क्रिया: 'लड़की गाया' ❌ → 'लड़की गाई' ✓",
        "वचन के अनुसार क्रिया: 'बच्चे खेलता है' ❌ → 'बच्चे खेलते हैं' ✓",
        "कारक चिह्नों का सही प्रयोग: 'राम ने जाता है' ❌ → 'राम जाता है' ✓",
        "अनावश्यक शब्दों से बचें: 'वापस लौट आया' ❌ → 'लौट आया' ✓"
      ]
    },
    {
      "id": "5cg8qpu",
      "type": "table",
      "rows": [
        {
          "isHeader": true,

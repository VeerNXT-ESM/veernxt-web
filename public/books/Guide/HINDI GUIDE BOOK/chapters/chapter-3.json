    {
      "type": "heading",
      "level": 4,
      "id": "ufkt4la",
      "content": "<strong>  3.4 प्रत्यय (Suffixes)</strong>"
    },
    {
      "id": "j6655k7",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>कृत् प्रत्यय (क्रिया से)</strong></p>",
            "<p><strong>तद्धित प्रत्यय (संज्ञा/विशेषण से)</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>लिख + आई = लिखाई</p>",

        {
          "isHeader": false,
          "cells": [
            "<p>Trade Unions Act</p>",
            "<p>1926</p>",
            "<p>Registration of trade unions; immunity from civil suits; minimum 7 members for registration</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Payment of Wages Act</p>",
            "<p>1936</p>",
            "<p>Timely payment; authorised deductions only; Rs.24,000/month wage ceiling for Act applicability</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Industrial Employment (Standing Orders) Act</p>",
            "<p>1946</p>",
            "<p>Certify model standing orders for establishments with 100+ workers; defines misconduct; conditions of service</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Factories Act</p>",
            "<p>1948</p>",
            "<p>Working hours 9/day 48/week; safety; health; welfare; annual leave 1 day per 20 days worked</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Minimum Wages Act</p>",
            "<p>1948</p>",
            "<p>State Govt fixes minimum wage for scheduled employments; Central Govt for certain employments; violation criminal</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Employees' Provident Funds Act</p>",
            "<p>1952</p>",
            "<p>12%+12% contribution; applicable 20+ employees; EPFO; EPS-95; EDLI scheme</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Maternity Benefit Act</p>",
            "<p>1961 (2017 Amendment)</p>",
            "<p>26 weeks paid maternity leave (first 2 children); crèche for 50+ employees; WFH option</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Payment of Bonus Act</p>",
            "<p>1965</p>",
            "<p>Min 8.33%; max 20%; for employees earning up to Rs.21,000/month; requires profit</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Payment of Gratuity Act</p>",
            "<p>1972</p>",
            "<p>15 days salary per year; min 5 years service; max Rs.20 lakh; all establishments 10+ employees</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Equal Remuneration Act</p>",
            "<p>1976 (subsumed into Code on Wages 2019)</p>",
            "<p>Equal pay for equal work for men and women; no discrimination in recruitment on grounds of sex</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Child Labour (Prohibition and Regulation) Act</p>",
            "<p>1986 (amended 2016)</p>",
            "<p>No child below 14 in any occupation; no child 14–18 in hazardous occupations</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>ESI Act</p>",
            "<p>1948</p>",
            "<p>Medical/sickness/maternity/disability benefits; 10+ employees; wages up to Rs.21,000; 0.75%+3.25%</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sexual Harassment (POSH Act)</p>",
            "<p>2013</p>",
            "<p>ICC mandatory; complaint within 3 months; 60-day enquiry; Rs.50,000 employer penalty</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Employees' Compensation Act</p>",
            "<p>2010</p>",
            "<p>Compensation for work-related injury/death; employer liability; Rs.1.2 lakh minimum for death</p>"
          ]
        },
        {
          "isHeader": false,

    {
      "id": "5yclmy6",
      "type": "heading",
      "level": 2,
      "content": "3.2 Training Need Analysis (TNA)"
    },
    {
      "type": "pullQuote",
      "content": "Kirkpatrick's Training Evaluation Model",
      "id": "5fhrdo3"
    },
    {
      "type": "paragraph",
      "id": "u02r4j4",
      "content": "Training Needs Analysis (TNA) is a systematic process of identifying gaps between current and desired knowledge, skills, and attitudes. It ensures training resources are targeted effectively."
    },
    {
      "id": "mt718jq",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Level of Analysis</strong></p>",
            "<p><strong>Focus</strong></p>",
            "<p><strong>Methods</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Organisational Analysis</p>",
            "<p>Organisation-wide needs; business goals; culture; resources for training</p>",
            "<p>Strategic plans review; HR reports; climate surveys; audit results</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Task/Operational Analysis</p>",
            "<p>What knowledge, skills, attitudes needed for each job/task</p>",
            "<p>Job analysis; performance standards; observation; subject matter experts</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Person/Individual Analysis</p>",
            "<p>Who specifically needs training; gap between actual and required performance</p>",
            "<p>Performance appraisal data; 360-degree feedback; assessment centres; self-assessment</p>"
          ]
        }
      ]
    },

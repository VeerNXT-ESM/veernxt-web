    {
      "id": "dnermq2",
      "type": "heading",
      "level": 2,
      "content": "7.2 Forest Types and Cover"
    },
    {
      "id": "xcx46lj",
      "type": "image",
      "imageId": "gzmlym8",
      "src": "/books/Guide/Himachal_Pradesh_CONSTABLE/images/image_gzmlym8.jpeg"
    },
    {
      "type": "paragraph",
      "content": "About 66% of HP's geographical area is classified as forests, one of the highest in India. Types of forests:",
      "id": "tkdpwqu"
    },
    {
      "id": "hm8p52e",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Forest Type</strong></p>",
            "<p><strong>Altitude</strong></p>",
            "<p><strong>Key Species</strong></p>",
            "<p><strong>Distribution</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Tropical Moist Deciduous</p>",
            "<p>Below 1000m</p>",
            "<p>Sal, Bamboo, Khair, Semul</p>",
            "<p>Shivalik foothills; Una, Bilaspur, Hamirpur</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sub-Tropical Dry Deciduous</p>",
            "<p>Below 1000m</p>",
            "<p>Dhak (Butea), Ber, Amla</p>",
            "<p>Lower Shivalik zone</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Himalayan Moist Temperate</p>",
            "<p>1000–2500m</p>",
            "<p>Oak, Rhododendron, Maple, Walnut, Chestnut</p>",
            "<p>Kangra, Shimla, Mandi, Chamba middle hills</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Himalayan Dry Temperate (Coniferous)</p>",
            "<p>2500–3500m</p>",
            "<p>Deodar, Blue Pine (Kail), Silver Fir (Rai), West Himalayan Spruce</p>",
            "<p>Kullu, Chamba, Shimla upper hills</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sub-Alpine</p>",
            "<p>3000–4000m</p>",
            "<p>Birch, Juniper, Willow, Abies (Fir)</p>",
            "<p>Lahaul-Spiti, Kinnaur, higher Kullu</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Alpine Scrub</p>",
            "<p>3500–5000m</p>",
            "<p>Rhododendron (scrub), dwarf juniper</p>",
            "<p>High Himalayan belts</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Alpine Meadows (Bugyals)</p>",
            "<p>Above 3500m</p>",
            "<p>Grasses, sedges, alpine herbs, gentians</p>",
            "<p>Throughout high HP near glacial zones</p>"
          ]
        }
      ]
    },

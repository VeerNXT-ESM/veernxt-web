            "<p><strong>Districts Covered</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Chenab (Chandra+Bhaga)</p>",
            "<p>Baralacha La, Lahaul</p>",
            "<p>Miyar, Thirot, Chandra, Bhaga</p>",
            "<p>Lahaul-Spiti, Chamba</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Ravi (Iravati)</p>",
            "<p>Bara Bangahal, Kangra</p>",
            "<p>Budhil, Siul, Tantgari, Nai</p>",
            "<p>Kangra, Chamba</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Beas (Vipasa)</p>",
            "<p>Beas Kund, near Rohtang</p>",
            "<p>Parbati, Sainj, Tirthan, Luni, Solani, Suketi</p>",
            "<p>Kullu, Mandi, Hamirpur, Kangra</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sutlej (Shutudri)</p>",
            "<p>Rakshastal Lake, Tibet</p>",
            "<p>Spiti, Baspa, Nogli, Andhra, Gambhar</p>",
            "<p>Kinnaur, Shimla, Bilaspur, Mandi</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Yamuna (Jamuna)</p>",

    {
      "id": "t78vcgf",
      "type": "heading",
      "level": 2,
      "content": "6.3 Folk Music and Instruments"
    },
    {
      "id": "hal9ekl",
      "type": "list",
      "items": [
        "Nati/Naati songs: Folk songs accompanying Nati dance; lyrical; about nature, love, and seasons.",
        "Pahari songs: Melodic folk songs specific to Pahari language; romantic and nature-themed.",
        "Jhuri: A lament or song of longing for distant loved ones.",
        "Ghori: Wedding processional songs sung when groom leaves home.",
        "Suhag: Sung by women at wedding ceremonies.",
        "Bhajan/Kirtan: Devotional music at religious gatherings.",
        "Key Instruments: Dhol (large drum), Dholku (smaller drum), Nagara (kettle drum), Shehnai (oboe), Karnal (long brass horn), Ranasingha (curved war horn), Chimta (tong percussion), Bin Baja (mountain flute), Ektara (one-string instrument), Ghunghroo (ankle bells).",
        "Rabab: A plucked string instrument used in Lahaul-Spiti.",
        "Sunna: String instrument of Kinnaur."
      ]
    },

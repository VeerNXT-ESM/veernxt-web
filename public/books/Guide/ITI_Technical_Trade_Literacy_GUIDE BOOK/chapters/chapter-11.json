        {
          "isHeader": false,
          "cells": [
            "<p>Front View</p>",
            "<p>Shows height and width of the object</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Top View</p>",
            "<p>Shows width and depth</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Side View</p>",
            "<p>Shows height and depth</p>"
          ]
        }
      ]

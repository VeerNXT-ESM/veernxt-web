    {
      "id": "815wiih",
      "type": "heading",
      "level": 2,
      "content": "5. Power"
    },
    {
      "type": "paragraph",
      "id": "ak20isk",
      "content": "Power is the rate at which work is done. It measures how quickly work is performed."
    },
    {
      "type": "paragraph",
      "id": "cg9uvyl",
      "content": "Formula:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "7q80ijm",
      "content": "Power = Work ÷ Time"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "f03mvum",
      "content": "Unit of power: Watt (W)"
    },
    {

    {
      "type": "paragraph",
      "id": "mrur7hu",
      "content": "Frequency is the number of cycles of AC produced in one second. The unit of frequency is Hertz (Hz)."
    },
    {
      "type": "paragraph",
      "id": "ocn7df0",
      "content": "Standard household frequency in many countries including India is 50 Hz."
    },

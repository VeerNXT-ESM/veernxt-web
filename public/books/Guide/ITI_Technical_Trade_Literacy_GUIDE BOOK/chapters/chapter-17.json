    {
      "id": "zx0jpis",
      "type": "list",
      "items": [
        "Ensure safe working conditions",
        "Improve efficiency and productivity",
        "Maintain tools and machines properly",
        "Reduce accidents and equipment damage",
        "Promote discipline and teamwork in workshops"
      ]
    },

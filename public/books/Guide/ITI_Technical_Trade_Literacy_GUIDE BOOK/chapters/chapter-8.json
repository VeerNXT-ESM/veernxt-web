      "content": "Exam-Oriented Key Points"
    },
    {
      "type": "paragraph",
      "id": "70fpr63",
      "content": "• Hand tools operate without electricity."
    },
    {
      "type": "paragraph",
      "id": "iy64iht",
      "content": "• Ball peen hammer is used in metalworking."
    },
    {
      "type": "paragraph",
      "id": "dg0toww",
      "content": "• Hacksaw is used for cutting metal."
    },
    {
      "type": "paragraph",
      "id": "w22xssm",
      "content": "• Bench vice holds workpieces firmly."
    },
    {
      "type": "paragraph",

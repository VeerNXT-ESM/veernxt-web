      "level": 2,
      "content": "10. Safety and Maintenance"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "qcfxy1r",
      "content": "• Clean tools after use"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "8f20hlw",
      "content": "• Store tools properly"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "e8vdnpi",
      "content": "• Keep cutting tools sharp"
    },
    {
      "type": "paragraph",
      "id": "tgpfryp",
      "content": "• Do not use damaged tools"
    },
    {
      "type": "paragraph",
      "id": "s91pqss",
      "content": "• Wear PPE while using tools"
    },
    {
      "type": "examAlert",
      "items": [
        "The standard point angle of a cold chisel for cutting cast iron is 60°, whereas for copper it is 30°.",
        "Bastard files are used for heavy metal removal, while smooth files give a fine surface finish.",
        "Hacksaw teeth must point forward away from the handle during blade installation.",
        "Spanner size indicates the width across flats of the nut or bolt head."
      ],
      "id": "vxggtwt"
    },
    {
      "id": "6w369op",
      "type": "heading",
      "level": 2,
      "content": "Exam-Oriented Key Points"
    },
    {
      "type": "paragraph",
      "id": "e4h8s4k",
      "content": "• Hand tools operate without electricity."
    },
    {
      "type": "paragraph",
      "id": "o9ox3gb",
      "content": "• Ball peen hammer is used in metalworking."
    },
    {
      "type": "paragraph",
      "id": "fa30010",
      "content": "• Hacksaw is used for cutting metal."
    },
    {
      "type": "paragraph",
      "id": "c5kycd9",
      "content": "• Bench vice holds workpieces firmly."
    },
    {
      "type": "paragraph",

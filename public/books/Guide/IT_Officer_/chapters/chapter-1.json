            "<p><strong>Use Case</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Inorder (LNR)</p>",
            "<p>Left → Root → Right</p>",
            "<p>Gives sorted output from BST</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Preorder (NLR)</p>",
            "<p>Root → Left → Right</p>",
            "<p>Copy tree; prefix expression; serialize tree</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Postorder (LRN)</p>",
            "<p>Left → Right → Root</p>",
            "<p>Delete tree; postfix expression; evaluate expression tree</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Level Order (BFS)</p>",
            "<p>Level by level using queue</p>",
            "<p>Finding shortest path; level-wise processing</p>"
          ]
        }
      ]
    },
    {
      "id": "wiuyw45",
      "type": "heading",
      "level": 3,
      "content": "Special Trees"
    },
    {
      "id": "i4cf3bb",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Tree Type</strong></p>",
            "<p><strong>Property</strong></p>",
            "<p><strong>Use</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>BST (Binary Search Tree)</p>",
            "<p>Left &lt; Root &lt; Right; O(log n) avg search</p>",
            "<p>Database indexing, sorted dictionaries</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>AVL Tree</p>",
            "<p>Self-balancing BST; |height(L)−height(R)| ≤ 1; O(log n) guaranteed</p>",
            "<p>File systems, databases needing fast lookups</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Red-Black Tree</p>",
            "<p>Self-balancing; root is black; no two consecutive red nodes</p>",
            "<p>Java TreeMap, C++ STL map/set, Linux kernel scheduler</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>B-Tree</p>",
            "<p>Generalised BST; multiple keys per node; balanced; minimises disk I/O</p>",
            "<p>Databases (MySQL), file systems (NTFS, ext4)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>B+ Tree</p>",
            "<p>All data in leaves; internal nodes only keys; leaves linked</p>",
            "<p>RDBMS primary index structure (InnoDB)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Heap</p>",
            "<p>Complete binary tree; max-heap or min-heap property</p>",
            "<p>Priority queue, heap sort</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Trie (Prefix Tree)</p>",
            "<p>Each node stores character; root is empty</p>",
            "<p>Auto-complete, spell check, IP routing</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Segment Tree</p>",
            "<p>Stores intervals; O(log n) range queries</p>",
            "<p>Range min/max/sum queries; competitive programming</p>"
          ]
        }
      ]
    },

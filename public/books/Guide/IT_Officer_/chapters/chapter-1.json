    {
      "type": "paragraph",
      "id": "mnfk3m5",
      "content": "A data structure is a way of organising and storing data in a computer so that it can be accessed and modified efficiently. The choice of data structure affects algorithm performance significantly. Data structures are broadly classified into Linear (Array, Stack, Queue, Linked List) and Non-Linear (Tree, Graph) types."
    },
    {
      "id": "ay4lnba",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Data Structure</strong></p>",
            "<p><strong>Type</strong></p>",
            "<p><strong>Time Complexity (Search/Insert/Delete)</strong></p>",
            "<p><strong>Use Cases</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Array</p>",
            "<p>Linear</p>",
            "<p>O(1) access / O(n) insert/delete</p>",
            "<p>Sequential storage, matrix operations, lookup tables</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Linked List</p>",
            "<p>Linear</p>",
            "<p>O(n) search / O(1) insert-delete at head</p>",
            "<p>Dynamic memory; polynomials; undo operations</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Stack</p>",
            "<p>Linear (LIFO)</p>",
            "<p>O(1) push/pop</p>",
            "<p>Expression evaluation, recursion, backtracking, browser history</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Queue</p>",
            "<p>Linear (FIFO)</p>",
            "<p>O(1) enqueue/dequeue</p>",
            "<p>BFS, scheduling, buffers, printer spooling</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Deque</p>",
            "<p>Linear</p>",
            "<p>O(1) both ends</p>",
            "<p>Palindrome check, sliding window problems</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hash Table</p>",
            "<p>Non-Linear</p>",
            "<p>O(1) avg search/insert</p>",
            "<p>Dictionary, caching, symbol tables, indexing</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Binary Tree</p>",
            "<p>Non-Linear</p>",
            "<p>O(log n) for BST</p>",
            "<p>Hierarchical data, expression trees, Huffman coding</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Heap</p>",
            "<p>Non-Linear</p>",
            "<p>O(log n) insert; O(1) min/max</p>",
            "<p>Priority queue, heap sort, Dijkstra's algorithm</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Graph</p>",
            "<p>Non-Linear</p>",
            "<p>Depends on representation</p>",
            "<p>Social networks, maps, routing, dependency resolution</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Trie</p>",
            "<p>Non-Linear</p>",
            "<p>O(L) where L=word length</p>",
            "<p>Auto-complete, spell check, IP routing, dictionary</p>"
          ]
        }
      ]
    },

    },
    {
      "id": "xf0mcb3",
      "type": "heading",
      "level": 3,
      "content": "Binary Tree Properties"
    },
    {
      "id": "3sj28w8",
      "type": "list",
      "items": [
        "Max nodes at level i = 2^i (root is level 0)",
        "Max nodes in tree of height h = 2^(h+1) − 1",
        "Min height of tree with n nodes = ⌊log2 n⌋",
        "Number of leaf nodes = number of internal nodes with 2 children + 1 (Full Binary Tree)"
      ]
    },
    {
      "id": "8clwyuf",
      "type": "heading",
      "level": 3,
      "content": "Tree Traversals"
    },
    {
      "id": "ts2cggu",

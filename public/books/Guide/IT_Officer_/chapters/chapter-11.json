    {
      "id": "ahx16ki",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>ML Category</strong></p>",
            "<p><strong>Description</strong></p>",
            "<p><strong>Algorithms / Techniques</strong></p>",
            "<p><strong>Banking Use Cases</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Supervised Learning</p>",
            "<p>Train on labelled data; predict output for new data</p>",
            "<p>Linear Regression, Logistic Regression, Decision Tree, Random Forest, SVM, Neural Networks, XGBoost</p>",
            "<p>Credit scoring, fraud detection, loan default prediction, churn prediction</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Unsupervised Learning</p>",
            "<p>Find patterns in unlabelled data; no target variable</p>",
            "<p>K-Means Clustering, DBSCAN, PCA, Autoencoders, Apriori (association rules)</p>",
            "<p>Customer segmentation, anomaly detection, market basket analysis</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Reinforcement Learning</p>",
            "<p>Agent learns by trial-and-error; reward/penalty feedback</p>",
            "<p>Q-Learning, Deep Q-Network (DQN), Policy Gradient, PPO</p>",
            "<p>Algorithmic trading, dynamic pricing, portfolio optimisation</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Deep Learning</p>",
            "<p>Multi-layer neural networks; learns hierarchical features</p>",
            "<p>CNN (images), RNN/LSTM (sequences), Transformer, BERT, GPT</p>",
            "<p>Document analysis, NLP for chatbots, voice authentication</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NLP (Natural Language Processing)</p>",
            "<p>Process and understand human language</p>",
            "<p>Tokenisation, Named Entity Recognition, Sentiment Analysis, LLMs</p>",
            "<p>Chatbots, contract analysis, regulatory compliance, sentiment for trading</p>"
          ]
        }
      ]
    },
    {
      "id": "c95rrme",
      "type": "heading",
      "level": 3,
      "content": "Important ML Metrics"
    },
    {
      "id": "bbs0ire",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Metric</strong></p>",
            "<p><strong>Formula</strong></p>",
            "<p><strong>Use</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Accuracy</p>",
            "<p>(TP+TN)/(TP+TN+FP+FN)</p>",
            "<p>Overall correctness; misleading for imbalanced datasets</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Precision</p>",
            "<p>TP/(TP+FP)</p>",
            "<p>Of predicted positives, how many are actually positive; important when FP is costly</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Recall (Sensitivity)</p>",
            "<p>TP/(TP+FN)</p>",
            "<p>Of actual positives, how many were correctly predicted; important when FN is costly (fraud detection)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>F1 Score</p>",
            "<p>2×(Precision×Recall)/(Precision+Recall)</p>",
            "<p>Harmonic mean; balance precision and recall; fraud, medical diagnosis</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>AUC-ROC</p>",
            "<p>Area Under ROC Curve</p>",
            "<p>Measures model's discrimination ability across thresholds; 0.5=random, 1=perfect</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RMSE</p>",
            "<p>√(mean of (predicted−actual)²)</p>",
            "<p>For regression; penalises large errors more</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Confusion Matrix</p>",
            "<p>2×2 (or n×n) table of actual vs predicted</p>",
            "<p>Full picture of classification performance</p>"
          ]
        }
      ]
    },

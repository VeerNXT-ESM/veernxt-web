    {
      "id": "m0xtcl6",
      "type": "heading",
      "level": 2,
      "content": "13.3 Key Formulas and Values"
    },
    {
      "id": "oo8n5ca",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Formula / Fact</strong></p>",
            "<p><strong>Value / Expression</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IPv4 Address Space</p>",
            "<p>2³² = 4,294,967,296 (~4.3 billion) unique addresses</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IPv6 Address Space</p>",
            "<p>2¹²⁸ = 340 undecillion addresses</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Maximum hosts in subnet /n</p>",
            "<p>2^(32-n) − 2 (subtract network and broadcast addresses)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Cyclomatic Complexity (McCabe)</p>",
            "<p>V(G) = E − N + 2P; E=edges, N=nodes, P=connected components</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RAID 0</p>",
            "<p>Striping; no redundancy; capacity = n × disk_size; performance++</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RAID 1</p>",
            "<p>Mirroring; full redundancy; capacity = disk_size (only 1 copy)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RAID 5</p>",
            "<p>Striping + distributed parity; min 3 disks; capacity = (n−1) × disk_size; can lose 1 disk</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RAID 6</p>",
            "<p>Like RAID 5 + extra parity; min 4 disks; can lose 2 disks</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RAID 10</p>",
            "<p>RAID 1+0; mirrored stripes; min 4 disks; best performance + redundancy; enterprise</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Amdahl's Law</p>",
            "<p>Speedup = 1/(S + (1-S)/N); S=serial fraction, N=processors; limits parallel speedup</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Pipeline Speedup (ideal)</p>",
            "<p>k stages = k× speedup (k=number of pipeline stages)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>CPI (Cycles Per Instruction)</p>",
            "<p>Total CPU cycles / Total instructions executed; lower is better</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>MIPS</p>",
            "<p>Millions of Instructions Per Second = f / CPI; f=clock frequency</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Cache Hit Rate</p>",
            "<p>(Cache hits / Total accesses) × 100%; target &gt;95%</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Memory Access Time (EMAT)</p>",
            "<p>h×Tc + (1-h)×Tm; h=hit rate, Tc=cache time, Tm=main memory time</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hamming Distance</p>",
            "<p>Number of bit positions where two code words differ; error detection capability</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Error Detection</p>",
            "<p>Can detect up to d bit errors if Hamming distance ≥ d+1</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Error Correction</p>",
            "<p>Can correct up to t bit errors if Hamming distance ≥ 2t+1</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Shannon's Channel Capacity</p>",
            "<p>C = B log₂(1 + S/N); B=bandwidth(Hz), S/N=signal-to-noise ratio</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Throughput (Pipelining)</p>",
            "<p>1 instruction / clock cycle (ideal); limited by slowest stage</p>"
          ]
        }
      ]
    },

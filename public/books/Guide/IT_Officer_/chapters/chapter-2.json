            "<p>Journaling; extents; backward compatible with ext2/3</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>APFS</p>",
            "<p>macOS/iOS</p>",
            "<p>8 EB</p>",
            "<p>8 EB</p>",
            "<p>Copy-on-write; snapshots; encryption; SSD-optimised</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>ZFS</p>",
            "<p>Solaris/BSD/Linux</p>",
            "<p>256 TB</p>",
            "<p>256 ZB</p>",
            "<p>Copy-on-write; checksums; RAID; self-healing</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>HDFS</p>",
            "<p>Hadoop (distributed)</p>",
            "<p>Petabytes</p>",
            "<p>Exabytes</p>",
            "<p>Write-once-read-many; block size 128 MB; NameNode + DataNode</p>"
          ]
        }
      ]
    },
    {
      "id": "yq08gla",
      "type": "heading",
      "level": 2,
      "content": "2.6 I/O Systems and Disk Scheduling"
    },
    {
      "id": "ehp9r24",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Disk Scheduling Algo</strong></p>",
            "<p><strong>Strategy</strong></p>",
            "<p><strong>Advantage</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>FCFS</p>",
            "<p>Service requests in order of arrival</p>",
            "<p>Fair; simple; high seek time with random requests</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SSTF (Shortest Seek Time First)</p>",
            "<p>Service nearest track first</p>",
            "<p>Reduces average seek time; starvation possible</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SCAN (Elevator)</p>",
            "<p>Move arm in one direction servicing all; reverse</p>",
            "<p>Good throughput; no starvation</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>C-SCAN (Circular SCAN)</p>",
            "<p>Move in one direction; return to start without servicing</p>",
            "<p>More uniform wait time than SCAN</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>LOOK</p>",
            "<p>Like SCAN but reverses at last request (not end of disk)</p>",
            "<p>More efficient than SCAN</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>C-LOOK</p>",
            "<p>Like C-SCAN but uses LOOK strategy</p>",
            "<p>Most practical; used in modern disks</p>"
          ]
        }
      ]
    }
  ],
  "enriched": true
}
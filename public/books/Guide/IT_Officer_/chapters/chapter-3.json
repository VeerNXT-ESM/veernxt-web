    },
    {
      "id": "o03wxpv",
      "type": "heading",
      "level": 2,
      "content": "3.4 Relational Model and SQL"
    },
    {
      "id": "2gfxm3a",
      "type": "heading",
      "level": 3,
      "content": "Keys in Relational Database"
    },
    {
      "id": "e38z8hn",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Key Type</strong></p>",
            "<p><strong>Definition</strong></p>",
            "<p><strong>Example</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Super Key</p>",
            "<p>Any set of attributes that uniquely identifies a tuple</p>",
            "<p>(StudentID), (StudentID, Name), (Email)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Candidate Key</p>",
            "<p>Minimal super key; no proper subset is a super key</p>",
            "<p>StudentID, Email (both can uniquely identify)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Primary Key (PK)</p>",
            "<p>Chosen candidate key; not NULL; unique</p>",
            "<p>StudentID (chosen as PK)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Alternate Key</p>",
            "<p>Candidate keys not chosen as PK</p>",
            "<p>Email (if StudentID is PK)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Foreign Key (FK)</p>",
            "<p>Attribute referencing PK of another table; enforces referential integrity</p>",
            "<p>CourseID in Enrollment references Course(CourseID)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Composite Key</p>",
            "<p>Primary key made of multiple attributes</p>",
            "<p>(StudentID, CourseID) in Enrollment table</p>"
          ]
        }
      ]
    },
    {
      "id": "qbh0ibj",
      "type": "heading",
      "level": 3,
      "content": "SQL Commands Classification"
    },
    {
      "id": "kuxuxh4",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Category</strong></p>",
            "<p><strong>Commands</strong></p>",
            "<p><strong>Purpose</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DDL (Data Definition Language)</p>",
            "<p>CREATE, ALTER, DROP, TRUNCATE, RENAME</p>",
            "<p>Define and modify database schema/structure</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DML (Data Manipulation Language)</p>",
            "<p>SELECT, INSERT, UPDATE, DELETE</p>",
            "<p>Manipulate data within tables</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DCL (Data Control Language)</p>",
            "<p>GRANT, REVOKE</p>",
            "<p>Control access permissions</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>TCL (Transaction Control Language)</p>",
            "<p>COMMIT, ROLLBACK, SAVEPOINT, SET TRANSACTION</p>",
            "<p>Manage transactions</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DQL (Data Query Language)</p>",
            "<p>SELECT</p>",
            "<p>Query and retrieve data (often grouped under DML)</p>"
          ]
        }
      ]
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Feature",
        "DDL (Data Definition Language)",

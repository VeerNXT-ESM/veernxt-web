      "rows": [
        [
          "Connection Type",
          "Connection-oriented (3-way handshake)",
          "Connectionless"
        ],
        [
          "Reliability",
          "Reliable ( Guarantees delivery via ACKs)",
          "Unreliable (Best-effort delivery)"
        ],
        [
          "Speed & Overhead",
          "Slower, higher overhead (20-60 byte header)",
          "Faster, lower overhead (8 byte fixed header)"
        ],
        [
          "Data Flow Control",
          "Flow control and congestion control supported",
          "No flow or congestion control"
        ],
        [
          "Common Applications",
          "Web browsing (HTTP/HTTPS), File Transfer (FTP), Email (SMTP)",
          "Video Streaming, VoIP, DNS, Online Gaming"
        ]
      ],
      "id": "434xuac"
    },

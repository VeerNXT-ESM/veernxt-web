    {
      "id": "gqvm60b",
      "type": "heading",
      "level": 2,
      "content": "4.3 TCP vs UDP"
    },
    {
      "id": "ifd7fje",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Feature</strong></p>",
            "<p><strong>TCP (Transmission Control Protocol)</strong></p>",
            "<p><strong>UDP (User Datagram Protocol)</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Connection</p>",
            "<p>Connection-oriented (3-way handshake: SYN, SYN-ACK, ACK)</p>",
            "<p>Connectionless</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Reliability</p>",
            "<p>Reliable; acknowledgements; retransmission</p>",
            "<p>Unreliable; no acknowledgements</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Ordering</p>",
            "<p>Guaranteed in-order delivery</p>",
            "<p>No ordering guarantee</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Error Control</p>",
            "<p>Yes (checksum + retransmission)</p>",
            "<p>Checksum only (optional)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Flow Control</p>",
            "<p>Yes (sliding window)</p>",
            "<p>No</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Congestion Control</p>",
            "<p>Yes (slow start, congestion avoidance)</p>",
            "<p>No</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Speed</p>",
            "<p>Slower (overhead)</p>",
            "<p>Faster</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Header Size</p>",
            "<p>20–60 bytes</p>",
            "<p>8 bytes</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Use Cases</p>",
            "<p>HTTP/HTTPS, FTP, SMTP, SSH, file transfer</p>",
            "<p>DNS, VoIP, video streaming, gaming, TFTP, SNMP</p>"
          ]
        }
      ]
    },

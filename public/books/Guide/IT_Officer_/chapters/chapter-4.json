            "<p>RIP (Routing Info Protocol)</p>",
            "<p>IGP; Distance Vector</p>",
            "<p>Bellman-Ford</p>",
            "<p>Hop count (max 15)</p>",
            "<p>Small networks; legacy</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>OSPF (Open Shortest Path First)</p>",
            "<p>IGP; Link State</p>",
            "<p>Dijkstra (SPF)</p>",
            "<p>Cost (bandwidth-based)</p>",
            "<p>Enterprise networks; scalable</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>EIGRP (Cisco)</p>",
            "<p>IGP; Hybrid</p>",
            "<p>DUAL algorithm</p>",
            "<p>Bandwidth + Delay + Load + Reliability</p>",
            "<p>Cisco enterprise networks</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>BGP (Border Gateway Protocol)</p>",
            "<p>EGP; Path Vector</p>",
            "<p>Best path policy</p>",
            "<p>AS path, policy attributes</p>",
            "<p>Internet backbone; between ISPs</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IS-IS</p>",
            "<p>IGP; Link State</p>",
            "<p>SPF (Dijkstra)</p>",
            "<p>Cost</p>",
            "<p>ISP core networks; large enterprise</p>"
          ]
        }
      ]
    },

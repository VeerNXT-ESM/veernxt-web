    {
      "id": "ksmvvgr",
      "type": "heading",
      "level": 3,
      "content": "Symmetric vs Asymmetric Encryption"
    },
    {
      "id": "v1zk7fr",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Feature</strong></p>",
            "<p><strong>Symmetric Encryption</strong></p>",
            "<p><strong>Asymmetric Encryption</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Keys</p>",
            "<p>Single shared secret key for encrypt and decrypt</p>",
            "<p>Key pair: public key (encrypt) + private key (decrypt)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Speed</p>",
            "<p>Fast; hardware-accelerated</p>",
            "<p>Slow; computationally intensive</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Key Distribution</p>",
            "<p>Difficult (secure channel needed to share key)</p>",
            "<p>Public key freely distributed; private key kept secret</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Key Management</p>",
            "<p>Scales poorly: O(n²) keys for n parties</p>",
            "<p>Scales well: 2n keys for n parties</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Algorithms</p>",
            "<p>AES, DES, 3DES, Blowfish, ChaCha20</p>",
            "<p>RSA, ECC, Diffie-Hellman, ElGamal</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Use Cases</p>",
            "<p>Bulk data encryption, disk encryption, VPN data</p>",
            "<p>Key exchange, digital signatures, SSL handshake</p>"
          ]
        }
      ]
    },
    {
      "id": "oza7woc",
      "type": "heading",
      "level": 3,
      "content": "Important Cryptographic Algorithms"
    },
    {
      "id": "z7as5yt",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Algorithm</strong></p>",
            "<p><strong>Type</strong></p>",
            "<p><strong>Key Size</strong></p>",
            "<p><strong>Status / Notes</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DES (Data Encryption Standard)</p>",
            "<p>Symmetric block cipher</p>",
            "<p>56-bit</p>",
            "<p>Broken; insecure; historically significant</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>3DES (Triple DES)</p>",
            "<p>Symmetric block cipher</p>",
            "<p>112 or 168-bit</p>",
            "<p>Deprecated; slow; replaced by AES</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>AES (Advanced Encryption Standard)</p>",
            "<p>Symmetric block cipher</p>",
            "<p>128, 192, 256-bit</p>",
            "<p>Current standard; fast; secure; NIST approved</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RSA</p>",
            "<p>Asymmetric</p>",
            "<p>2048, 4096-bit</p>",
            "<p>Based on integer factorisation; widely used</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>ECC (Elliptic Curve Cryptography)</p>",
            "<p>Asymmetric</p>",
            "<p>256-bit ≈ RSA 3072-bit strength</p>",
            "<p>Smaller keys; efficient; mobile/IoT friendly</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SHA-1</p>",
            "<p>Hash function</p>",
            "<p>160-bit output</p>",
            "<p>Deprecated; collision vulnerabilities found</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SHA-256 / SHA-3</p>",
            "<p>Hash function</p>",
            "<p>256/variable-bit output</p>",
            "<p>Current standard; Bitcoin uses SHA-256</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>MD5</p>",
            "<p>Hash function</p>",
            "<p>128-bit output</p>",
            "<p>Broken; not for security; only for checksums</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Diffie-Hellman</p>",
            "<p>Key Exchange</p>",
            "<p>Variable</p>",
            "<p>Allows two parties to agree on secret over public channel</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>HMAC</p>",
            "<p>Message Authentication Code</p>",
            "<p>Variable</p>",
            "<p>Hash + secret key; ensures integrity and authenticity</p>"
          ]
        }
      ]
    },
    {
      "id": "43zk6or",
      "type": "heading",
      "level": 3,
      "content": "Digital Signatures and PKI"
    },
    {
      "id": "jyv22cl",
      "type": "list",
      "items": [
        "Digital Signature: uses sender's private key to sign (encrypt hash); receiver uses public key to verify",
        "PKI (Public Key Infrastructure): system of certificates, CAs, and policies to manage public keys",
        "Certificate Authority (CA): trusted entity that issues digital certificates (e.g., DigiCert, Let's Encrypt)",
        "X.509 Certificate: standard format for digital certificates; contains public key, owner identity, CA signature",
        "SSL/TLS Handshake: asymmetric for key exchange → symmetric for bulk data encryption"
      ]
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Feature",
        "Symmetric Encryption",
        "Asymmetric Encryption"
      ],
      "rows": [
        [
          "Key Usage",
          "Single secret key for encryption & decryption",
          "Pair of keys: Public key to encrypt, Private key to decrypt"
        ],
        [
          "Speed",
          "Fast and computationally efficient",
          "Slower due to complex mathematical operations"
        ],
        [
          "Key Distribution",
          "Difficult; sharing secret key securely is challenging",
          "Simple; Public key can be freely distributed"
        ],
        [
          "Popular Algorithms",
          "AES, DES, 3DES, Blowfish",
          "RSA, ECC, Diffie-Hellman"
        ]
      ],
      "id": "mlnwqmv"
    },
    {
      "id": "2onmsdw",
      "type": "heading",
      "level": 2,
      "content": "6.2 Types of Cyber Attacks"
    },
    {
      "id": "2lkvwcl",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Attack Type</strong></p>",
            "<p><strong>Description</strong></p>",
            "<p><strong>Prevention</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Phishing</p>",
            "<p>Fraudulent emails/sites to steal credentials</p>",
            "<p>User training; email filtering; MFA</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Spear Phishing</p>",
            "<p>Targeted phishing using personal info</p>",
            "<p>Security awareness; DMARC/DKIM/SPF</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SQL Injection</p>",
            "<p>Malicious SQL code injected into input fields</p>",
            "<p>Parameterised queries; input validation; WAF</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>XSS (Cross-Site Scripting)</p>",
            "<p>Inject malicious script into web pages viewed by others</p>",
            "<p>Input sanitisation; Content Security Policy (CSP); output encoding</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>CSRF (Cross-Site Request Forgery)</p>",
            "<p>Trick user into performing unintended actions</p>",
            "<p>CSRF tokens; SameSite cookie attribute; referer checking</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>MITM (Man-in-the-Middle)</p>",
            "<p>Intercept communication between two parties</p>",
            "<p>HTTPS/TLS; certificate pinning; VPN</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DDoS (Distributed Denial of Service)</p>",
            "<p>Overwhelm server with traffic from many sources</p>",
            "<p>Rate limiting; CDN; DDoS mitigation services (Cloudflare)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Ransomware</p>",
            "<p>Encrypt victim's files; demand ransom for decryption key</p>",
            "<p>Regular backups; EDR; patch management; user training</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Zero-Day Exploit</p>",
            "<p>Attack targeting unknown/unpatched vulnerability</p>",
            "<p>Intrusion detection; virtual patching; threat intelligence</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Brute Force</p>",
            "<p>Try all possible passwords/keys</p>",
            "<p>Account lockout; CAPTCHA; strong password policy; MFA</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Rainbow Table Attack</p>",
            "<p>Precomputed hash-to-password table</p>",
            "<p>Password salting before hashing</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>ARP Spoofing</p>",
            "<p>Send fake ARP messages to associate attacker's MAC with legitimate IP</p>",
            "<p>Dynamic ARP Inspection (DAI); static ARP entries</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DNS Spoofing / Cache Poisoning</p>",
            "<p>Insert malicious DNS records to redirect traffic</p>",
            "<p>DNSSEC; DNS over HTTPS (DoH); DNS monitoring</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Social Engineering</p>",
            "<p>Manipulate people into revealing information</p>",
            "<p>Security training; strict procedures; verify identity</p>"
          ]
        }
      ]
    },
    {
      "id": "mb0h41d",
      "type": "heading",
      "level": 2,
      "content": "6.3 Security Architecture"
    },
    {
      "id": "p6aoeql",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Security Concept</strong></p>",
            "<p><strong>Description</strong></p>",
            "<p><strong>Implementation</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Defence in Depth</p>",
            "<p>Multiple security layers; if one fails, others remain</p>",
            "<p>Firewall + IDS/IPS + Antivirus + Encryption + Access control</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Zero Trust Security</p>",
            "<p>Never trust, always verify; no implicit trust even inside network</p>",
            "<p>MFA; least privilege; micro-segmentation; continuous verification</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Principle of Least Privilege</p>",
            "<p>Users/processes get minimum permissions needed</p>",
            "<p>RBAC; regular access reviews; privileged access management</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Security by Design</p>",
            "<p>Build security into software from beginning</p>",
            "<p>Threat modelling; secure coding; SAST/DAST testing</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>CIA Triad</p>",
            "<p>Confidentiality, Integrity, Availability — core security goals</p>",
            "<p>Encryption (C); hashing/signatures (I); redundancy (A)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>AAA Framework</p>",
            "<p>Authentication, Authorisation, Accounting</p>",
            "<p>RADIUS, TACACS+; identity management systems</p>"
          ]
        }
      ]
    },
    {
      "id": "cw4ubww",
      "type": "heading",
      "level": 2,
      "content": "6.4 Security Tools and Technologies"
    },
    {
      "type": "examAlert",
      "items": [
        "Questions frequently distinguish between Symmetric (AES, DES) and Asymmetric (RSA, ECC) algorithms.",
        "Identify key provisions of the Information Technology (IT) Act, 2000 and the statutory role of CERT-In.",
        "Differentiate common attack vectors like Phishing, Man-in-the-Middle (MitM), and Ransomware."
      ],
      "id": "051vppj"
    },
    {
      "id": "v4lhg7l",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Tool/Technology</strong></p>",
            "<p><strong>Category</strong></p>",
            "<p><strong>Purpose</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Firewall (Stateful)</p>",
            "<p>Network Security</p>",
            "<p>Track connection state; block unauthorised traffic; Packet filtering + state tracking</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>WAF (Web Application Firewall)</p>",
            "<p>Application Security</p>",
            "<p>Filter HTTP traffic; protect against SQLi, XSS, CSRF; Layer 7</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IDS (Intrusion Detection System)</p>",
            "<p>Monitoring</p>",
            "<p>Detect suspicious activity and alert; passive; Snort, Suricata</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IPS (Intrusion Prevention System)</p>",
            "<p>Active Defence</p>",
            "<p>Detect and block attacks automatically; inline; Snort IPS mode</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SIEM (Security Info &amp; Event Mgmt)</p>",
            "<p>Monitoring/Analytics</p>",
            "<p>Collect and correlate logs; detect patterns; Splunk, QRadar, ELK Stack</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SOAR (Security Orchestration)</p>",
            "<p>Automation</p>",
            "<p>Automate response to security incidents; reduce analyst workload</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>EDR (Endpoint Detection &amp; Response)</p>",
            "<p>Endpoint Security</p>",
            "<p>Monitor endpoints; detect and respond to threats; CrowdStrike, Carbon Black</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DLP (Data Loss Prevention)</p>",
            "<p>Data Security</p>",
            "<p>Prevent unauthorised transfer of sensitive data; content inspection</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Vulnerability Scanner</p>",
            "<p>Assessment</p>",
            "<p>Scan systems for known vulnerabilities; Nessus, OpenVAS, Qualys</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Penetration Testing Tools</p>",
            "<p>Ethical Hacking</p>",
            "<p>Simulate attacks to find vulnerabilities; Metasploit, Burp Suite, Kali Linux</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>PAM (Privileged Access Management)</p>",
            "<p>Identity Security</p>",
            "<p>Control and monitor privileged account access; CyberArk, BeyondTrust</p>"
          ]
        }
      ]
    },
    {
      "id": "ef3orfr",
      "type": "heading",
      "level": 2,
      "content": "6.5 Cyber Security Laws and Compliance in India"
    },
    {
      "id": "44klwhv",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Law / Framework</strong></p>",
            "<p><strong>Year</strong></p>",
            "<p><strong>Key Provisions</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IT Act 2000 (amended 2008)</p>",
            "<p>2000/2008</p>",
            "<p>Cyber crimes; digital signatures; e-commerce legality; Section 43, 66, 69, 72</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Section 66 IT Act</p>",
            "<p>2008</p>",
            "<p>Hacking; unauthorized access; imprisonment up to 3 years + fine</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Section 66A IT Act</p>",
            "<p>2008</p>",
            "<p>Online offensive messages (struck down by SC in 2015 — Shreya Singhal case)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Section 67 IT Act</p>",
            "<p>2008</p>",
            "<p>Publishing obscene material electronically; imprisonment up to 5 years</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Section 69 IT Act</p>",
            "<p>2008</p>",
            "<p>Govt can intercept, monitor, decrypt information for security reasons</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>CERT-In (Computer Emergency Response Team India)</p>",
            "<p>2004</p>",
            "<p>National nodal agency for cybersecurity; under MeitY; incident reporting</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DPDP Act (Digital Personal Data Protection Act)</p>",
            "<p>2023</p>",
            "<p>Protect personal data; consent requirements; data fiduciaries; penalties up to Rs.250 crore</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RBI Cybersecurity Framework</p>",
            "<p>2016</p>",
            "<p>Mandatory for banks; 24x7 SOC; incident reporting within 2-6 hours</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NPCI Cybersecurity Guidelines</p>",
            "<p>Ongoing</p>",
            "<p>For payment system participants; tokenisation; fraud monitoring</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>ISO 27001</p>",
            "<p>International</p>",
            "<p>ISMS standard; risk management; widely adopted in IT sector</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>PCI-DSS</p>",
            "<p>International</p>",
            "<p>Payment Card Industry Data Security Standard; for card payment processors</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>GDPR</p>",
            "<p>EU (2018)</p>",
            "<p>European data privacy regulation; affects Indian companies with EU customers</p>"
          ]
        }
      ]
    }
  ],
  "enriched": true

      "id": "1rhx6kb",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Component</strong></p>",
            "<p><strong>Function</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>ALU (Arithmetic Logic Unit)</p>",
            "<p>Performs arithmetic operations (+, -, ×, ÷) and logic operations (AND, OR, NOT, XOR)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Control Unit (CU)</p>",
            "<p>Fetches and decodes instructions; coordinates all CPU components; generates control signals</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Registers</p>",
            "<p>Small, fast memory inside CPU; PC (Program Counter), IR (Instruction Register), MAR, MDR, Accumulator</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Cache Memory</p>",
            "<p>Small high-speed memory between CPU and RAM; L1 (fastest, smallest), L2, L3</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Main Memory (RAM)</p>",
            "<p>Primary storage; volatile; stores currently running programs and data</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Secondary Storage</p>",
            "<p>Non-volatile; HDD, SSD, optical disk; stores data permanently</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>I/O Interface</p>",
            "<p>Connects CPU with external devices; handles speed mismatch and format differences</p>"
          ]
        }
      ]
    },
    {
      "id": "k5uqc52",
      "type": "heading",
      "level": 2,
      "content": "7.2 Instruction Execution Cycle"
    },
    {
      "id": "a31xft4",
      "type": "list",
      "items": [
        "Fetch: PC contains address; instruction fetched from memory to IR; PC incremented",
        "Decode: Control unit decodes instruction in IR; identifies opcode and operands",
        "Execute: ALU performs operation; result stored in accumulator or register",
        "Write Back: Result written to memory or register file if needed",
        "Interrupt Check: Check for pending interrupts after each instruction"
      ]
    },
    {
      "type": "pullQuote",
      "content": "CHAPTER 7: COMPUTER ORGANISATION AND ARCHITECTURE",
      "id": "aqnfuja"
    },

    {
      "id": "295u1ez",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Deployment Model</strong></p>",
            "<p><strong>Description</strong></p>",
            "<p><strong>Pros</strong></p>",
            "<p><strong>Cons</strong></p>",
            "<p><strong>Use Case</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Public Cloud</p>",
            "<p>Resources owned and operated by third-party provider; shared infrastructure</p>",
            "<p>Low cost; high scalability; no maintenance</p>",
            "<p>Less control; security concerns; compliance issues</p>",
            "<p>Startups, web apps, development/test environments</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Private Cloud</p>",
            "<p>Cloud infrastructure for exclusive use of single organisation</p>",
            "<p>Full control; better security; compliance-friendly</p>",
            "<p>Expensive; requires IT expertise; limited scalability</p>",
            "<p>Banks, government, healthcare — sensitive data</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hybrid Cloud</p>",
            "<p>Combination of public + private; data/apps portable between them</p>",
            "<p>Flexibility; balance security and scalability</p>",
            "<p>Complex management; integration challenges</p>",
            "<p>Banks: sensitive data private, web apps public</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Multi-Cloud</p>",
            "<p>Use multiple cloud providers simultaneously</p>",
            "<p>Avoid vendor lock-in; best-of-breed services</p>",
            "<p>Most complex; data governance challenges</p>",
            "<p>Large enterprises; redundancy-critical systems</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Community Cloud</p>",
            "<p>Shared by organisations with common concerns (compliance, security)</p>",
            "<p>Shared cost; meets specific needs</p>",
            "<p>Limited scalability; requires governance</p>",
            "<p>Government agencies; financial regulators</p>"
          ]
        }
      ]
    },

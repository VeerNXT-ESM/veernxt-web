          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Deployment</p>",
            "<p>Desired state declaration; manages replica sets; rolling updates, rollbacks</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

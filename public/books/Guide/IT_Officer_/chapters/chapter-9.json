            "<p><strong>Examples</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>IaaS</p>",
            "<p>Infrastructure as a Service</p>",
            "<p>Physical infrastructure, virtualisation, storage, networking</p>",
            "<p>OS, middleware, runtime, applications, data</p>",
            "<p>AWS EC2, Azure VMs, Google Compute Engine</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>PaaS</p>",
            "<p>Platform as a Service</p>",
            "<p>IaaS + OS, middleware, runtime, development tools</p>",
            "<p>Applications and data only</p>",
            "<p>Heroku, Google App Engine, AWS Elastic Beanstalk</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SaaS</p>",
            "<p>Software as a Service</p>",
            "<p>Everything including applications</p>",
            "<p>Only user data and access</p>",
            "<p>Gmail, Office 365, Salesforce, Zoom, GitHub</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>FaaS / Serverless</p>",
            "<p>Function as a Service</p>",
            "<p>Infrastructure + runtime + scaling</p>",
            "<p>Function code only; event-driven</p>",
            "<p>AWS Lambda, Azure Functions, Google Cloud Functions</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>CaaS</p>",
            "<p>Container as a Service</p>",
            "<p>Infrastructure + container orchestration</p>",
            "<p>Container images and applications</p>",
            "<p>Google GKE, Amazon ECS/EKS, Azure AKS</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DBaaS</p>",
            "<p>Database as a Service</p>",
            "<p>Infrastructure + database engine + backups</p>",
            "<p>Data schema and queries</p>",
            "<p>Amazon RDS, Azure SQL, Google Cloud SQL</p>"
          ]
        }
      ]
    },

        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Saser La</strong></p>",
            "<p>5,400 m; on Karakoram Pass route</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Karakoram Pass</strong></p>",

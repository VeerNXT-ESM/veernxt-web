    {
      "id": "fb0sqj7",
      "type": "heading",
      "level": 2,
      "content": "2.6 Climate of Kerala"
    },
    {
      "type": "examAlert",
      "items": [
        "Frequently tested: Distinguishing the 3 east-flowing rivers (Kabini, Bhavani, Pambar) from the 41 west-flowing rivers.",
        "Identify major lakes, backwaters (such as Vembanad and Ashtamudi), and highest mountain peaks (Anamudi).",
        "Match wildlife sanctuaries and national parks to their corresponding districts and physical features."
      ],
      "id": "vmu46qx"
    },
    {
      "type": "paragraph",
      "id": "hr1452k",
      "content": "Kerala has a tropical climate influenced by the Arabian Sea and Western Ghats. It receives rainfall from both the Southwest Monsoon (June–September) and the Northeast Monsoon (October–November). The annual rainfall averages 3,107 mm."
    },
    {
      "id": "1j83qqs",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Season</strong></p>",
            "<p><strong>Period</strong></p>",
            "<p><strong>Characteristics</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Summer</p>",
            "<p>March–May</p>",
            "<p>Hot and humid; temperatures up to 36°C; sea winds moderate heat</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>SW Monsoon (Edavappathy)</p>",
            "<p>June–September</p>",
            "<p>Heavy rainfall; 65–70% of annual rainfall; first hits Kerala on June 1</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>NE Monsoon (Thulavarsham)</p>",
            "<p>October–November</p>",
            "<p>Moderate rainfall; cooler temperatures</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Winter</p>",
            "<p>December–February</p>",
            "<p>Pleasant; cooler in highlands; 16–17°C in hills</p>"
          ]
        }
      ]
    },

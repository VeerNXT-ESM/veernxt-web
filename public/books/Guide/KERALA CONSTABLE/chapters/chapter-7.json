      "content": "7.3 SI Examination Pattern (Kerala PSC)"
    },
    {
      "id": "3k4cdab",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Stage</strong></p>",
            "<p><strong>Type</strong></p>",

          "cells": [
            "<p>Specialised Wings</p>",
            "<p>Crime Branch, SIT, Cyber Cell, Vigilance, Anti-Terrorist Squad (ATS)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Women Police</p>",
            "<p>All-women police stations in each district</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Rank of SI (Sub-Inspector)</p>",
            "<p>Entry-level gazetted officer; selected by PSC</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Kerala Police Act</p>",
            "<p>Kerala Police Act 2011 (replaced 1960 Act)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Training Academy</p>",
            "<p>Kerala Police Academy, Thrissur (Ramavarmapuram)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Emblem</p>",
            "<p>Kerala Police emblem features the Venad tiger</p>"
          ]
        }
      ]
    },

    {
      "type": "paragraph",
      "id": "z3ndtwr",
      "content": "The Kerala Public Service Commission (KPSC) is a constitutional body established under Article 315 of the Indian Constitution. It recruits candidates to civil services in Kerala through competitive examinations."
    },
    {
      "id": "f7zgxed",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Aspect</strong></p>",
            "<p><strong>Details</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Established</p>",
            "<p>1956 (coinciding with Kerala state formation)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Constitutional Provision</p>",
            "<p>Articles 315–323 of the Constitution of India</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Chairman</p>",
            "<p>Appointed by Governor</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Headquarters</p>",
            "<p>Pattom, Thiruvananthapuram</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Major Exams</p>",
            "<p>Civil Service, Sub Inspector, Excise Inspector, VEO, LDC, LD Typist, etc.</p>"
          ]
        },
        {

            "<p><strong>Details</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Established</p>",
            "<p>Originally British era; reorganised post-1956</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Head</p>",
            "<p>Director General of Police (DGP)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Zones</p>",
            "<p>Northern, Central, Southern Range (+ Commissionerates)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Police Commissionerates</p>",
            "<p>Thiruvananthapuram City, Kochi City, Kozhikode City, Thrissur City</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Total Districts</p>",

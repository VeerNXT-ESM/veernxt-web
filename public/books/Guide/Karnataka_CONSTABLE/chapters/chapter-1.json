          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Longitudinal Extent</strong></p>",
            "<p>74°12'E to 78°10'E</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>North</strong></p>",
            "<p>Maharashtra (Maharashtra-Karnataka border: ~865 km) &amp; Goa</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>South</strong></p>",
            "<p>Kerala &amp; Tamil Nadu</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>East</strong></p>",
            "<p>Andhra Pradesh &amp; Telangana</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>West</strong></p>",
            "<p>Arabian Sea — coastline approximately 320 km (Karavali region)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>East-West Width (max)</strong></p>",
            "<p>~480 km</p>"
          ]
        },
        {

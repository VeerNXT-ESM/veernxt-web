    {
      "id": "yu7c8lo",
      "type": "heading",
      "level": 2,
      "content": "10.2 Social Reform Movements Originating in Karnataka"
    },
    {
      "id": "b7qei55",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Movement / Leader</strong></p>",
            "<p><strong>Period</strong></p>",
            "<p><strong>Key Contributions</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Vachana Movement (Basavanna)</p>",
            "<p>12th century CE</p>",
            "<p>Anti-caste; equality for all; Kayaka (dignity of labour); Dasoha (service); Anubhava Mantapa; founded Lingayat/Veerashaiva faith as egalitarian religion</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Haridasa Movement (Purandaradasa, Kanakadasa)</p>",
            "<p>15th–16th century</p>",
            "<p>Bhakti movement; composed songs in simple Kannada for masses; anti-caste message; Kanakadasa's protest at Udupi temple</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Brahmo Samaj Influence</p>",
            "<p>19th century</p>",
            "<p>Influence of Raja Ram Mohan Roy's ideas spread to educated Kannada elite in Mysore</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Mysore Model State Reforms</p>",
            "<p>1881–1940</p>",
            "<p>Compulsory education; women's education (Maharani's College 1901 — first women's college in South India); widow remarriage support</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Navakarnataka Movement / DVG</p>",
            "<p>1920s–1950s</p>",
            "<p>Newspaper Kaggada; rational thinking; cultural renaissance; D. V. Gundappa's role</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Karnataka Dalit Movement</p>",
            "<p>1970s–1990s</p>",
            "<p>Siddalingaiah's Bandaya (protest literature); Dalit Sangharsha Samiti; rights for bonded laborers</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>OBC / Backward Classes Movement</p>",
            "<p>1980s</p>",
            "<p>Havanur Commission (1975); Venkataswamy Commission; reservation for OBC communities</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Women's Self-Help Groups</p>",
            "<p>1990s–present</p>",
            "<p>Stree Shakti Programme (Karnataka government); microfinance through SHGs</p>"
          ]
        }
      ]
    },

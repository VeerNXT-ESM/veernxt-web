          "cells": [
            "<p>Malaikudi</p>",
            "<p>Kodagu hills</p>",
            "<p>Forest dwellers; agriculture</p>",
            "<p>Tamil dialect + Kannada</p>",
            "<p>Listed ST in Karnataka</p>"
          ]
        },

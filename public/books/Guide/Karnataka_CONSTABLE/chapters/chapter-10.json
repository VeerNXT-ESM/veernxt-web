        {
          "isHeader": false,
          "cells": [
            "<p>Soliga</p>",
            "<p>Biligirirangana Hills, Chamarajanagar; MM Hills</p>",
            "<p>Forest dwellers; NTFP collection; honey</p>",
            "<p>Soliga (Dravidian)</p>",
            "<p>One of the most studied forest tribes; BRT Tiger Reserve overlaps their traditional land; won Supreme Court right to stay</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Jenu Kuruba</p>",
            "<p>Nagarhole, Kodagu forests</p>",
            "<p>Honey gatherers (Jenu = honey); forest NTFP</p>",
            "<p>Jenu Kuruba</p>",
            "<p>Expert honey collectors from beehives on tall trees; scheduled tribe</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Betta Kuruba</p>",
            "<p>Kodagu, Mysuru forests</p>",
            "<p>Herders; pastoralists; settled in hills</p>",
            "<p>Kannada dialect</p>",
            "<p>Distinct from Jenu Kuruba; cattle herding tradition</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hakki-Pikki</p>",
            "<p>Shivamogga, Davanagere, Davangere</p>",
            "<p>Bird catching, hunting; now forest crafts &amp; tourism</p>",
            "<p>Hindi-like dialect + Kannada</p>",
            "<p>Nomadic origin; speak unique language; some sub-groups speak a secret traders' language</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Iruliga</p>",
            "<p>Ramanagara, Tumakuru, Kolar</p>",
            "<p>Snake catching; forest produce; now agriculture</p>",
            "<p>Iruliga (Dravidian)</p>",
            "<p>Traditional snake catchers; worship snakes; many work with forest department</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Siddi</p>",
            "<p>Yellapur, Haliyal (Uttara Kannada)</p>",
            "<p>Agriculture, forest work; rhythmic music &amp; dance</p>",
            "<p>Kannada + Konkani + Urdu</p>",
            "<p>Descendants of East African Bantu people; brought by Portuguese, Arab &amp; British traders; GI acrobatics</p>"
          ]
        },

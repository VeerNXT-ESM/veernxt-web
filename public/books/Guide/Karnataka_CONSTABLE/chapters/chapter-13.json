      "id": "bo16ht3",
      "type": "heading",
      "level": 2,
      "content": "13.4 Rajyotsava Award — Karnataka's Second Highest Honour"
    },
    {
      "id": "mgwf1xy",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Instituted</strong></p>",
            "<p>1966</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Announced</strong></p>",
            "<p>Every year on November 1 (Rajyotsava / Karnataka Formation Day)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Purpose</strong></p>",
            "<p>Given for distinguished contribution to literature, arts, culture, sports, science, social service, or other fields related to Karnataka</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Cash Award</strong></p>",
            "<p>Rs. 1 lakh + certificate + state emblem badge</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Number Given</strong></p>",
            "<p>Typically 50–60 awardees per year</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Eligibility</strong></p>",
            "<p>Kannada/Karnataka citizens; NRIs from Karnataka also eligible</p>"
          ]
        }
      ]
    },

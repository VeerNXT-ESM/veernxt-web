          "cells": [
            "<p>Gruha Jyoti</p>",
            "<p>Energy</p>",
            "<p>Free 200 units of electricity per month to all domestic consumers</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Gruha Lakshmi</p>",
            "<p>Women &amp; Child Development</p>",
            "<p>Rs. 2,000 per month to woman head of household</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Yuva Nidhi</p>",
            "<p>Skill Development</p>",
            "<p>Rs. 3,000 per month to degree holders, Rs. 1,500 to diploma holders — unemployed youth, 2 years</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Anna Bhagya</p>",
            "<p>Food &amp; Civil Supplies</p>",
            "<p>10 kg free rice per person per month to BPL families</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Shakti (Free Bus for Women)</p>",
            "<p>Transport</p>",
            "<p>Free bus travel for all women in KSRTC, BMTC, KKRTC buses</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Arogya Karnataka</p>",
            "<p>Health</p>",
            "<p>Universal health coverage; Rs. 5 lakh per family per year; renamed &amp; expanded Ayushman Bharat in KA context</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Rajiv Gandhi Housing Corporation</p>",
            "<p>Rural Development</p>",
            "<p>Rural housing under Pradhan Mantri Awas Yojana + state funds</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sandhya Suraksha</p>",
            "<p>Social Welfare</p>",
            "<p>Enhanced pension for elderly; Rs. 1,000 per month</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Krishi Bhagya</p>",
            "<p>Agriculture</p>",
            "<p>Water harvesting structures; farm ponds; subsidised equipment; dryland farmers</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Ksheera Bhagya</p>",
            "<p>Women &amp; Child Dev.</p>",
            "<p>Free milk to schoolchildren; 150 ml per school day</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Vidyasiri</p>",
            "<p>Education</p>",
            "<p>Scholarship for SC/ST, OBC students for higher education</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>DESI (Digital Economy for South India)</p>",
            "<p>IT/BT</p>",
            "<p>Digital literacy; rural broadband; Karnataka Digital Economy Mission</p>"
          ]
        }
      ]
    },
    {
      "id": "yu9q386",
      "type": "heading",
      "level": 2,
      "content": "16.2 Central Schemes Active in Karnataka"
    },
    {
      "id": "hvds3sh",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>PM Awas Yojana (Gramin)</strong></p>",
            "<p>Rural housing; Rs. 1.2–1.3 lakh per unit; Karnataka has major targets</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>PM Kisan Samman Nidhi</strong></p>",
            "<p>Rs. 6,000 per year to farmers; direct benefit transfer</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>MGNREGA</strong></p>",
            "<p>100 days employment guarantee; major implementation in North Karnataka districts</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>PM Jan Dhan Yojana</strong></p>",
            "<p>Financial inclusion; bank accounts for all; overdraft facility</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Ayushman Bharat – PM Jan Arogya Yojana</strong></p>",
            "<p>Rs. 5 lakh health cover; Karnataka integrated Arogya Karnataka</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>PMGSY (Pradhan Mantri Gram Sadak Yojana)</strong></p>",
            "<p>Rural road connectivity; all weather roads to villages 500+ population</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Digital India</strong></p>",
            "<p>Bengaluru as Digital India hub; data centres, CDAC, MeitY labs</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Smart Cities Mission</strong></p>",
            "<p>Bengaluru, Mysuru, Mangaluru, Hubballi-Dharwad, Belagavi, Shivamogga — selected Karnataka cities</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>AMRUT (Urban)</strong></p>",
            "<p>Basic urban amenities; water, sewage, parks — 13 Karnataka cities</p>"
          ]
        }
      ]
    },

      "content": "17.2 Important Comparisons & Distinctions (MCQ Traps)"
    },
    {
      "id": "zsi7xdi",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Vidhana Soudha vs Suvarna Soudha</strong></p>",
            "<p>Vidhana Soudha (1956) = State Legislature, Bengaluru; Suvarna Soudha = 2nd legislature building, Belagavi (for winter session)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Jnanpith vs Karnataka Ratna</strong></p>",
            "<p>Jnanpith = national literary award (Sahitya Bharati); Karnataka Ratna = State's highest civilian award for any field</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Lokayukta vs Upa-Lokayukta</strong></p>",
            "<p>Lokayukta = main ombudsman (1 person); Upa-Lokayuktas = 2 (north &amp; south Karnataka); all appointed by Governor</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>DGP vs DGP (Prisons)</strong></p>",
            "<p>DGP (Karnataka Police) = head of civil police; DGP Prisons = head of Karnataka prison department — two different IPS posts</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>KSRP vs DAR</strong></p>",
            "<p>KSRP = Karnataka State Reserve Police (state-level armed force); DAR = District Armed Reserve (district-level armed reserve under SP)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>KRS Dam vs Tungabhadra Dam</strong></p>",
            "<p>KRS = Cauvery River, Mandya, 1924; TB Dam = Tungabhadra River, Hospete, 1953; TB Dam is larger in capacity</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Bandipur vs Nagarhole</strong></p>",
            "<p>Both in Mysuru division; Bandipur adjoins Tamil Nadu; Nagarhole adjoins Kerala; Kabini reservoir is in Nagarhole</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Hampi vs Pattadakal</strong></p>",
            "<p>Both UNESCO WH; Hampi = Vijayanagara (14th–16th c.); Pattadakal = Chalukya (6th–8th c.)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Belur vs Halebidu</strong></p>",
            "<p>Both Hoysala; Belur = Chennakeshava Temple (Vishnuvardhana, 1117 CE); Halebidu = Hoysaleshwara Temple (12th c.) — larger &amp; unfinished</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Gol Gumbaz vs Gomateshwara</strong></p>",
            "<p>Gol Gumbaz = Adilshahi tomb, Bijapur — world's 2nd largest dome; Gomateshwara = Jain monolithic statue, Shravanabelagola — world's tallest monolithic statue</p>"
          ]
        }
      ]
    },

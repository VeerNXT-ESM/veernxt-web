{
  "id": "svle6u4",
  "title": "SECTION 6: CONSTITUTION, POLITY & KARNATAKA ADMINISTRATION",
  "order": 6,
  "blocks": [
    {
      "id": "5mh0blf",
      "type": "heading",
      "level": 2,
      "content": "6.1 Indian Constitution — Key Articles for Exams"
    },
    {
      "id": "qxjkexy",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Article</strong></p>",
            "<p><strong>Subject</strong></p>",
            "<p><strong>Exam Relevance</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 12–35</p>",
            "<p>Fundamental Rights</p>",
            "<p>Right to equality, freedom, against exploitation, religion, education, constitutional remedies</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 19</p>",
            "<p>6 Freedoms (Speech, Assemble, Form associations, Move freely, Reside, Profession)</p>",
            "<p>Frequently tested; Art. 19(1)(a) = Freedom of Speech</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 21</p>",
            "<p>Right to Life &amp; Personal Liberty</p>",
            "<p>Widened by Supreme Court; includes right to livelihood, privacy, health, education</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 21A</p>",
            "<p>Right to Education (86th Amendment, 2002)</p>",
            "<p>Free &amp; compulsory education 6–14 years</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 22</p>",
            "<p>Protection against arbitrary arrest</p>",
            "<p>Grounds of arrest must be communicated; magistrate within 24 hours</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 32</p>",
            "<p>Right to Constitutional Remedies</p>",
            "<p>Habeas Corpus, Mandamus, Prohibition, Certiorari, Quo Warranto</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 36–51</p>",
            "<p>Directive Principles of State Policy (DPSP)</p>",
            "<p>Not justiciable; guide state policy; Art. 40 — Panchayati Raj</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 51A</p>",
            "<p>Fundamental Duties (42nd Amendment, 1976)</p>",
            "<p>11 duties; Art. 51A(a)–(k)+(l added by 86th Amendment)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 72</p>",
            "<p>Pardoning powers of President</p>",
            "<p>Pardon, Reprieve, Respite, Commute, Remit</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 161</p>",
            "<p>Pardoning powers of Governor</p>",
            "<p>Similar to President but no mercy petition in court-martial cases</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 163</p>",
            "<p>Council of Ministers to aid Governor</p>",
            "<p>Governor acts on advice of CoM (except discretionary)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 168</p>",
            "<p>State Legislature</p>",
            "<p>Governor + 2 Houses (if bicameral like Karnataka)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 170</p>",
            "<p>Composition of Legislative Assembly</p>",
            "<p>Not less than 60, not more than 500 seats</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 171</p>",
            "<p>Composition of Legislative Council</p>",
            "<p>Not less than 40, not more than 1/3 of Assembly</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 213</p>",
            "<p>Governor's Ordinance making power</p>",
            "<p>When Legislature not in session</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 226</p>",
            "<p>High Court's Writ jurisdiction</p>",
            "<p>Both against state &amp; private bodies (wider than Art. 32)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 243–243O</p>",
            "<p>73rd Amendment — Panchayati Raj</p>",
            "<p>Three-tier system; elections; reservations; 11th Schedule</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 243P–243ZG</p>",
            "<p>74th Amendment — Municipalities</p>",
            "<p>Urban local bodies; 12th Schedule; ward committees</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 356</p>",
            "<p>President's Rule</p>",
            "<p>Failure of constitutional machinery in state; Art. 357 — Parlimentary powers during Presidents Rule</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art. 371J</p>",
            "<p>Special provisions for Hyderabad-Karnataka region</p>",
            "<p>Reservation for local candidates in education &amp; employment in 6 districts</p>"
          ]
        }
      ]
    },
    {
      "id": "lpg5v8o",
      "type": "heading",
      "level": 2,
      "content": "6.2 Karnataka State Legislature"
    },
    {
      "id": "rnvanzw",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Vidhan Sabha (Lower House)</strong></p>",
            "<p>224 elected seats; speaker presides; money bills originate here; life 5 years</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Vidhan Parishad (Upper House)</strong></p>",
            "<p>75 seats; permanent house (1/3 retire every 2 years); Chairman presides; 6-year term per member</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Composition of Vidhan Parishad</strong></p>",
            "<p>1/3 by local bodies, 1/3 by MLA votes, 1/12 by graduates, 1/12 by teachers, 1/6 nominated by Governor</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Sessions</strong></p>",
            "<p>Budget (Feb–May), Monsoon (July–Aug), Winter (Oct–Nov — at Belagavi)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Quorum</strong></p>",
            "<p>1/10 of total members present to conduct business</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Governor</strong></p>",
            "<p>Constitutional head; appointed by President; Art. 155; 5-year term (pleasure of President)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Chief Minister</strong></p>",
            "<p>Real executive head; must command majority in Vidhan Sabha; advises Governor</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Cabinet Size</strong></p>",
            "<p>Must not exceed 15% of Vidhan Sabha strength (91st Amendment 2003) = max ~34 ministers</p>"
          ]
        }
      ]
    },
    {
      "id": "a3p1ue7",
      "type": "heading",
      "level": 2,
      "content": "6.3 Karnataka High Court"
    },
    {
      "id": "8xfpwvt",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Established</strong></p>",
            "<p>1884 (as High Court of Mysore; renamed Karnataka High Court in 1973)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Location</strong></p>",
            "<p>Bengaluru (Principal Bench)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Permanent Benches</strong></p>",
            "<p>Dharwad &amp; Kalaburagi (Gulbarga)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Chief Justice</strong></p>",
            "<p>Appointed by President; 65 years retirement age</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Jurisdiction</strong></p>",
            "<p>Original, Appellate, Revisional; Writ jurisdiction under Art. 226</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Contempt of Court</strong></p>",
            "<p>High Court can punish for contempt under Art. 215</p>"
          ]
        }
      ]
    },
    {
      "id": "qwaz1ia",
      "type": "heading",
      "level": 2,
      "content": "6.4 Karnataka Lokayukta"
    },
    {
      "id": "k5g4tj2",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Established</strong></p>",
            "<p>1984 under Karnataka Lokayukta Act, 1984</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Appointment</strong></p>",
            "<p>By Governor on advice of CM (after consultation with HC CJ, Speaker, Chairman of Council, Leader of Opposition)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Tenure</strong></p>",
            "<p>5 years or age 65 (whichever earlier); not eligible for re-appointment</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Jurisdiction</strong></p>",
            "<p>Ministers, MLAs, MLCs, IAS/IPS officers, public servants in Karnataka</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Exclusions</strong></p>",
            "<p>Governor, CM (while in office), HC judges, UPSC members</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Powers</strong></p>",
            "<p>Investigate complaints; recommend action; cannot impose penalties directly</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Upa-Lokayukta</strong></p>",
            "<p>Two Upa-Lokayuktas assist (one for north, one for south Karnataka)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>2015 Amendment</strong></p>",
            "<p>Enhanced powers; raids on government officials became possible</p>"
          ]
        }
      ]
    },
    {
      "id": "fzn02ul",
      "type": "heading",
      "level": 2,
      "content": "6.5 Panchayati Raj in Karnataka"
    },
    {
      "id": "43633km",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Karnataka Zilla Parishads Act</strong></p>",
            "<p>1983 (replaced by Karnataka Panchayati Raj Act 1993)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Karnataka Panchayati Raj Act</strong></p>",
            "<p>1993 (implements 73rd Amendment)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Three Tiers</strong></p>",
            "<p>Zilla Panchayat (ZP) → Taluk Panchayat (TP) → Gram Panchayat (GP)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>GP Quorum</strong></p>",
            "<p>Gram Sabha — all adult voters; meets at least twice a year</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Reservations</strong></p>",
            "<p>1/3 seats reserved for women (often 50% in practice); SC/ST proportional</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Finances</strong></p>",
            "<p>State Finance Commission recommends funds; own taxes, grants, assigned revenue</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>RDPR Ministry</strong></p>",
            "<p>Rural Development &amp; Panchayati Raj; oversees PR institutions</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>e-Governance</strong></p>",
            "<p>e-Gram Swaraj portal; online panchayat accounts; NREGAsoft</p>"
          ]
        }
      ]
    }
  ],
  "enriched": false
}
    {
      "id": "cqpa6hk",
      "type": "heading",
      "level": 2,
      "content": "8.3 Agriculture — Comprehensive Coverage"
    },
    {
      "type": "paragraph",
      "content": "Karnataka is one of the most agriculturally diverse states in India. It grows food grains, commercial crops, horticultural crops, spices, and floriculture crops.",
      "id": "8hor319"
    },
    {
      "id": "82j8k1x",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Crop</strong></p>",
            "<p><strong>Type</strong></p>",
            "<p><strong>Key Districts</strong></p>",
            "<p><strong>Karnataka's Rank (India)</strong></p>",
            "<p><strong>Key Facts</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Coffee</p>",
            "<p>Plantation crop</p>",
            "<p>Kodagu, Chikkamagaluru, Hassan</p>",
            "<p>1st (produces ~70–72% of India's coffee)</p>",
            "<p>Arabica &amp; Robusta varieties; Baba Budangiri origin; GI tag for Coorg coffee</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sandalwood</p>",
            "<p>Tree (forest produce)</p>",
            "<p>Mysuru, Chamarajanagar, Kodagu</p>",
            "<p>1st (largest producer)</p>",
            "<p>Government monopoly on sandalwood; Mysore Sandal Soap; GI protected</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Arecanut</p>",
            "<p>Plantation crop</p>",
            "<p>Shivamogga, D. Kannada, Udupi, Uttara Kannada</p>",
            "<p>1st (highest producer)</p>",
            "<p>Used in paan/betel; Shivamogga district = areca capital</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Silk (Mulberry)</p>",
            "<p>Sericulture</p>",
            "<p>Ramanagara, Mysuru, Tumakuru, Chikkaballapur</p>",
            "<p>2nd (after AP-Telangana)</p>",
            "<p>Ramanagara = Silk City; cocoon market</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sugarcane</p>",
            "<p>Commercial</p>",
            "<p>Mandya, Belagavi, Shivamogga</p>",
            "<p>Major producer</p>",
            "<p>Mandya = 'Sugar Bowl of Karnataka'; Mysore Sugar Company, Chamundeshwari Sugar</p>"

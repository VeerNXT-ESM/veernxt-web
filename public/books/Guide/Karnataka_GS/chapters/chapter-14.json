    {
      "id": "h6zco2m",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Founded</strong></p>",
            "<p>1969; Dr. Vikram Sarabhai — 'Father of Indian Space Programme'</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Headquarters</strong></p>",
            "<p>Antariksh Bhavan, New BEL Road, Bengaluru</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>ISRO Satellite Centre (URSC)</strong></p>",
            "<p>Bengaluru; builds satellites; renamed U R Rao Satellite Centre</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Launch Vehicle Control Centre</strong></p>",
            "<p>Mission control at Bengaluru during launches</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>SHAR (Satish Dhawan Space Centre)</strong></p>",
            "<p>Sriharikota, Andhra Pradesh — actual launch facility; named after KA-born scientist</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>PSLV (Polar Satellite Launch Vehicle)</strong></p>",
            "<p>Most reliable; 50+ consecutive successful launches; places remote sensing &amp; navigation satellites</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>GSLV (Geosynchronous SLV)</strong></p>",
            "<p>Heavier payloads; communications satellites; cryogenic engine indigenously developed</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Chandrayaan-1 (2008)</strong></p>",
            "<p>First Indian lunar mission; discovered water molecules on Moon; NASA credited ISRO's data</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Mangalyaan (Mars Orbiter Mission)</strong></p>",
            "<p>2013–2022; first Asian mission to Mars; cheapest Mars mission globally; $74 million</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Chandrayaan-3 (2023)</strong></p>",
            "<p>Soft-landed near Moon's south pole (Aug 23, 2023); first ever south pole landing; Vikram lander, Pragyan rover</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Aditya-L1 (2023)</strong></p>",
            "<p>India's first solar mission; L1 Lagrange point; studying solar corona</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Gaganyaan</strong></p>",
            "<p>India's crewed spaceflight programme; 4 astronauts selected (from Bengaluru)</p>"
          ]
        }
      ]
    },

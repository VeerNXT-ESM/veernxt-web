    },
    {
      "type": "comparisonTable",
      "headers": [
        "Forest Type",
        "Rainfall & Vegetation Traits",
        "Prominent Locations"
      ],
      "rows": [
        [
          "Tropical Evergreen Forests",
          "Heavy rainfall (>250 cm); dense multi-layered canopy; trees retain leaves year-round",
          "Agumbe, Western Ghats slope, Uttara Kannada"
        ],
        [
          "Moist & Dry Deciduous Forests",
          "Moderate rainfall (70–200 cm); trees shed leaves during dry summer season",
          "Bandipur, Nagarhole, Mysuru, Chamarajanagar"
        ],
        [
          "Thorn & Scrub Forests",
          "Low rainfall (<60 cm); thorny shrubs, thick barks, and deep root systems",
          "Deccan Plateau region, Ballari, Raichur, Vijayapura"
        ]
      ],

    {
      "id": "7j4dua2",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Director General of Police (DGP)</strong></p>",
            "<p>Overall head of Karnataka Police; IPS officer; appointed by state government</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Additional DGP (ADGP)</strong></p>",
            "<p>Senior IPS officer; heads wings like CID, Intelligence, Armed Police</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Inspector General of Police (IGP)</strong></p>",
            "<p>Heads a Police Range; responsible for law &amp; order in the range</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Deputy Inspector General (DIG)</strong></p>",
            "<p>Heads a DIG range; between IG and SP level</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Superintendent of Police (SP)</strong></p>",
            "<p>Head of district police; responsible for law &amp; order in district (IPS or KPS)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Additional SP (ASP)</strong></p>",
            "<p>Assists SP; heads sub-division or handles special duties</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Deputy SP (DSP) / Circle Inspector (CI)</strong></p>",
            "<p>Circle level; supervises multiple police stations</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Inspector of Police (PI)</strong></p>",
            "<p>Investigates serious cases; in-charge of major police stations</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Sub-Inspector (SI)</strong></p>",
            "<p>Officer-in-charge of police station in rural/small town areas; investigates cases; files FIR</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Assistant Sub-Inspector (ASI)</strong></p>",
            "<p>Assists SI; performs patrolling, guard duties</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Head Constable (HC)</strong></p>",
            "<p>Supervisory role among constables</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Police Constable (PC)</strong></p>",
            "<p>Basic unit of police; patrol, guard, assist investigations</p>"
          ]
        }
      ]
    },

    {
      "id": "mliy8k8",
      "type": "heading",
      "level": 2,
      "content": "7.3 Specialised Police Units in Karnataka"
    },
    {
      "id": "fa7nopr",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>CID (Criminal Investigation Department)</strong></p>",
            "<p>State-level investigation; serious crimes, organised crime, economic offences</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Intelligence Department (IB Karnataka)</strong></p>",
            "<p>Internal intelligence; communal harmony; anti-Naxal, anti-terror</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>KSRP (Karnataka State Reserve Police)</strong></p>",
            "<p>Armed force for law &amp; order; bandobast; disaster management; 10+ battalions</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>DAR (District Armed Reserve)</strong></p>",
            "<p>Armed reserve at district level for serious law &amp; order situations</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>SCB (Special Crime Branch)</strong></p>",
            "<p>ADGP level; heinous crimes, organised crime</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>CCB (Central Crime Branch)</strong></p>",
            "<p>Bengaluru City; serious property crimes, drug cases, cyber crime</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Cyber Crime Police Station</strong></p>",
            "<p>Bengaluru + in all districts; BNS/IT Act enforcement</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>ACB (Anti-Corruption Bureau)</strong></p>",
            "<p>Registered under Lokayukta; trap cases against corrupt officials</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>KSSP (Karnataka Sreni Special Police)</strong></p>",
            "<p>Rapid response; crowd control; security</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Traffic Police</strong></p>",
            "<p>Separate wing in major cities; enforcement of MV Act</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Home Guards</strong></p>",
            "<p>Auxiliary force; Karnataka Home Guards Act, 1963; assist police at functions, traffic</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>KCOCA</strong></p>",
            "<p>Karnataka Control of Organised Crime Act, 2000; used for mafia/gang cases</p>"
          ]
        }
      ]
    },

          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Section 5</p>",
            "<p>Condonation of delay</p>",
            "<p>Sufficient cause must be shown; discretionary; not applicable to suits under Art.136 (execution)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Section 14</p>",
            "<p>Exclusion of time in good faith proceedings</p>",
            "<p>Time spent in wrong court bona fide excluded</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Section 15</p>",
            "<p>Exclusion when injunction/stay in force</p>",
            "<p>Period during which injunction or stay order operates excluded</p>"
          ]

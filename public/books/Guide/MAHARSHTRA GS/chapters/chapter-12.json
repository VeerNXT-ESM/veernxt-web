        {
          "isHeader": true,
          "cells": [
            "<p><strong>States Reorganization Commission (1955)</strong></p>",
            "<p>Fazal Ali Commission; recommended linguistic states; led to Maharashtra formation</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Dhar Commission (1948)</strong></p>",
            "<p>First commission on linguistic states; recommended against linguistic provinces</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>JVP Committee (1949)</strong></p>",
            "<p>Jawaharlal Nehru, Vallabhbhai Patel, Pattabhi Sitaramayya; also against linguistic division</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Mehta Committee</strong></p>",
            "<p>On Panchayati Raj development in Maharashtra</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Nagpur Agreement (1953)</strong></p>",
            "<p>Agreed on formation of Maharashtra; Nagpur as second capital</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Samyukta Maharashtra Movement</strong></p>",
            "<p>Mass movement demanding separate Maharashtra state; Senapati Bapat, S.A. Dange, P.K. Atre, S.M. Joshi among leaders; January 1956 – 105 died in police firing</p>"
          ]
        }
      ]

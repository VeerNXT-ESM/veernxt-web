    {
      "id": "e5ch6if",
      "type": "heading",
      "level": 2,
      "content": "5.1 Languages and Literature"
    },
    {
      "type": "paragraph",
      "content": "Marathi is the official language of Maharashtra and is spoken by approximately 83 million people. It is an Indo-Aryan language derived from Sanskrit and Prakrit.",
      "id": "s0dde7s"
    },
    {
      "id": "qz0drxs",
      "type": "heading",
      "level": 3,
      "content": "Important Marathi Literary Works and Authors"
    },
    {
      "id": "wdzpor7",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Author / Saint</strong></p>",
            "<p><strong>Period</strong></p>",
            "<p><strong>Works / Contribution</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Dnyaneshwar (Jnaneshwar)</p>",
            "<p>1275–1296 CE</p>",
            "<p>Dnyaneshwari (commentary on Bhagavad Gita in Marathi, 1290 CE); Amrutanubhav</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Namdev</p>",
            "<p>1270–1350 CE</p>",
            "<p>Abhangas (devotional poetry); compositions in Guru Granth Sahib</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Eknath</p>",
            "<p>1533–1599 CE</p>",
            "<p>Eknathi Bhagavat; popularized Varkari tradition</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Tukaram</p>",
            "<p>1608–1649 CE</p>",
            "<p>5000+ Abhangas; Greatest Varkari saint-poet; Dehu (Pune)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Ramdas Swami</p>",
            "<p>1608–1681 CE</p>",
            "<p>Dasbodh (moral treatise); Shivaji's spiritual mentor; founded Math at Sajjangad</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Mukteshwar</p>",
            "<p>17th century</p>",
            "<p>Translated Mahabharata into Marathi</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Vishnu Shastri Chiplunkar</p>",
            "<p>1850–1882</p>",
            "<p>Pioneer of Marathi prose; founded Chitrashala Press</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hari Narayan Apte</p>",
            "<p>1864–1919</p>",
            "<p>Father of Marathi novel</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>P.K. Atre (Acharya Atre)</p>",
            "<p>1898–1969</p>",
            "<p>Playwright, satirist, journalist; Navyug magazine</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>V.S. Khandekar</p>",
            "<p>1898–1976</p>",
            "<p>Yayati (Jnanpith Award 1960) – first Marathi Jnanpith</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Vishnu Vaman Shirwadkar (Kusumagraj)</p>",
            "<p>1912–1999</p>",
            "<p>Poet, playwright; Jnanpith Award 1987; Marathi Bhasha Gaurav Din on his birthday (27 Feb)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Bhalchandra Nemade</p>",
            "<p>1938–present</p>",
            "<p>Kosla (1963); Jnanpith Award 2014</p>"
          ]
        }
      ]
    },

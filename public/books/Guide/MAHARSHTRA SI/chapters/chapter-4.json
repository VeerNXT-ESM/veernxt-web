    {
      "id": "jnnsi5p",
      "type": "heading",
      "level": 2,
      "content": "4.7 Maharashtra Public Service Commission (MPSC)"
    },
    {
      "type": "paragraph",
      "id": "5pbvqfz",
      "content": "The Maharashtra Public Service Commission (MPSC) is a constitutional body under Article 315 of the Indian Constitution. It conducts examinations and makes recommendations for appointments to civil services of Maharashtra."
    },
    {
      "id": "bd8ids2",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Established</strong></p>",
            "<p>1937 (under British India; reconstituted after 1960)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Constitutional Basis</strong></p>",
            "<p>Article 315 of Indian Constitution</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Headquarters</strong></p>",
            "<p>Pune (MPSC Office, CBD Belapur, Navi Mumbai – new)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Chairman</strong></p>",
            "<p>Appointed by Governor of Maharashtra</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Exams Conducted</strong></p>",
            "<p>MPSC State Services (Class I &amp; II), Maharashtra Police Sub-Inspector (Non-Technical), PSI (Technical), STI (Sales Tax Inspector), Asst. Section Officer, Clerk-Typist, many others</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Main Exam</strong></p>",
            "<p>Maharashtra State Services Exam (Civil Services equivalent)</p>"
          ]
        }
      ]
    },

      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Principal Seat</strong></p>",
            "<p>Mumbai (Bombay High Court – established 1862; one of oldest High Courts in India)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Benches</strong></p>",

            "<p>30 years</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Chairman (Sabhadhyaksha)</strong></p>",
            "<p>Presides over Vidhan Parishad</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Nature</strong></p>",
            "<p>Permanent body; cannot be dissolved</p>"
          ]
        }
      ]
    },

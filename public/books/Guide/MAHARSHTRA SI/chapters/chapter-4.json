          "isHeader": true,
          "cells": [
            "<p><strong>Total Seats</strong></p>",
            "<p>78 members</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Composition</strong></p>",
            "<p>Graduates (7), Teachers (7), Local Bodies (22), MLAs elect (26), Governor nominates (12), State Council of Ministers elect (4)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Term of Members</strong></p>",
            "<p>6 years (1/3 retire every 2 years)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

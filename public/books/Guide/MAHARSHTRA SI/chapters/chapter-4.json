          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Jurisdiction</strong></p>",
            "<p>Maharashtra, Goa, Dadra and Nagar Haveli, Daman and Diu</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Bombay High Court established</strong></p>",
            "<p>1862 by Letters Patent under British India</p>"
          ]
        }
      ]
    },
    {

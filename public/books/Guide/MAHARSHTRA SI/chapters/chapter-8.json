          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>First Governor</strong></p>",
            "<p>Sri Prakasa (1960)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>First woman Chief Minister</strong></p>",
            "<p>No woman CM of Maharashtra yet as of 2024</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>First Marathi Jnanpith Award</strong></p>",
            "<p>V.S. Khandekar (1965)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>First nuclear power plant (India)</strong></p>",
            "<p>Tarapur (1969)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>First superfast train in India</strong></p>",
            "<p>Deccan Queen (Mumbai–Pune, 1930)</p>"

        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>First women's school in India</strong></p>",
            "<p>Jyotirao and Savitribai Phule at Bhidewada, Pune (1848)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>First MIDC established</strong></p>",
            "<p>1962</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>India's oldest stock exchange</strong></p>",
            "<p>BSE (1875) in Mumbai</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>India's first submarine</strong></p>",
            "<p>INS Kalvari commissioned in Mumbai</p>"

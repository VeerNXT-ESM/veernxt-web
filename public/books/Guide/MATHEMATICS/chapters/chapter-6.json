      "type": "comparisonTable",
      "headers": [
        "Work Scenario / Concept",
        "Key Characteristic / Mathematical Relation"
      ],
      "rows": [
        [
          "Single Person Work",
          "Rate of work per day is represented as 1/N if total time is N days."
        ],
        [
          "Two Persons Working Together",
          "Combined daily rate equals (1/A + 1/B), reducing total completion time."
        ],
        [
          "Work and Efficiency",
          "Efficiency = Work / Time (More efficiency means fewer days required)."
        ],
        [
          "Men–Days Concept",
          "Total Work = Number of Men × Days (M1 × D1 = M2 × D2)."
        ]
      ],

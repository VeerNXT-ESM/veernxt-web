    {
      "id": "byaatqj",
      "type": "heading",
      "level": 2,
      "content": "6.3 Particularly Vulnerable Tribal Groups (PVTGs)"
    },
    {
      "type": "paragraph",
      "content": "Madhya Pradesh has several Particularly Vulnerable Tribal Groups (PVTGs) - formerly called Primitive Tribal Groups. These communities are considered especially vulnerable due to their declining or stagnant population, pre-agricultural technology, and critical economic situation.",
      "id": "ysskuzh"
    },
    {
      "id": "6q3n71v",
      "type": "list",
      "items": [
        "Baiga - Mandla, Dindori, Umaria (shifting cultivation practitioners called Bewar)",
        "Sahariya - Sheopur, Gwalior, Shivpuri",
        "Birhor - Shahdol, Sidhi (nomadic, basket makers)",
        "Abujhmaria - Southern MP border area (Dindori)",
        "Kamar - Border districts",
        "Agaria - Mandla, Dindori (iron smelters, considered sacred craftsmen)"
      ]
    },
    {
      "id": "kninvop",
      "type": "heading",
      "level": 2,
      "content": "6.4 Tribal Festivals"
    },
    {
      "id": "lq8uv1b",
      "type": "list",
      "items": [
        "Bhagoria Haat (Bhil/Bhilala) - Marriage market festival of Jhabua, Alirajpur; celebrated in Phalgun month before Holi",
        "Hareli (Gond) - First festival of year, sowing of seeds",
        "Karma Festival - Worship of Karma tree for good harvest",
        "Nagpanchami - Worship of snakes",
        "Goncha Festival - Gond festival of Bastar region",
        "Madai Festival - Tribal fair held in various parts of eastern MP"
      ]
    }
  ],

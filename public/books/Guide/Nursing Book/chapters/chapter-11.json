    {
      "type": "paragraph",
      "id": "qlzv01x",
      "content": "Mental Health Nursing focuses on the care of individuals with psychological and psychiatric disorders. It involves assessment, diagnosis, treatment, and rehabilitation of patients with mental illnesses. In competitive nursing examinations such as RRB Nursing, important topics include types of mental disorders, psychiatric therapies, therapeutic communication, and nursing care of psychiatric patients."
    },
    {
      "id": "spkpbth",
      "type": "heading",
      "level": 2,
      "content": "Concept of Mental Health"
    },
    {
      "id": "djjigu0",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Concept</strong></p>",
            "<p><strong>Explanation</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Mental Health</p>",
            "<p>State of well-being where an individual can cope with normal stresses of life</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Mental Illness</p>",
            "<p>Disorder affecting mood, thinking, or behavior</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Psychiatry</p>",
            "<p>Branch of medicine dealing with diagnosis and treatment of mental disorders</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Psychiatric Nursing</p>",
            "<p>Specialized nursing practice focusing on mental health care</p>"
          ]
        }
      ]
    },
    {
      "id": "979fsti",
      "type": "heading",
      "level": 2,
      "content": "Factors Affecting Mental Health"
    },
    {
      "id": "xdoghla",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Factor</strong></p>",
            "<p><strong>Description</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Biological factors</p>",
            "<p>Genetic predisposition, brain injury, hormonal imbalance</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Psychological factors</p>",
            "<p>Stress, trauma, emotional conflicts</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Social factors</p>",
            "<p>Family environment, poverty, social isolation</p>"
          ]
        }
      ]
    },
    {
      "id": "rzmcr2h",
      "type": "heading",
      "level": 2,
      "content": "Common Mental Disorders"
    },
    {
      "id": "v08ufup",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Disorder</strong></p>",
            "<p><strong>Description</strong></p>",
            "<p><strong>Symptoms</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Depression</p>",
            "<p>Mood disorder causing persistent sadness</p>",
            "<p>Low mood, fatigue, loss of interest</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Anxiety disorders</p>",
            "<p>Excessive fear and worry</p>",
            "<p>Restlessness, rapid heartbeat</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Schizophrenia</p>",
            "<p>Severe mental disorder affecting thinking</p>",
            "<p>Hallucinations, delusions</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Bipolar disorder</p>",
            "<p>Alternating episodes of mania and depression</p>",
            "<p>Mood swings</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Obsessive Compulsive Disorder (OCD)</p>",
            "<p>Repetitive thoughts and behaviors</p>",
            "<p>Obsessions and compulsions</p>"
          ]
        }
      ]
    },
    {
      "id": "5ss3mb8",
      "type": "heading",
      "level": 2,
      "content": "Symptoms of Mental Illness"
    },
    {
      "id": "8fjx2nv",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Symptom</strong></p>",
            "<p><strong>Explanation</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hallucination</p>",
            "<p>Perception without external stimulus</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Delusion</p>",
            "<p>False belief not based on reality</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Illusion</p>",
            "<p>Misinterpretation of real external stimulus</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Phobia</p>",
            "<p>Irrational fear of specific object or situation</p>"
          ]
        }
      ]
    },

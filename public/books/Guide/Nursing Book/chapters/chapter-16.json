            "<p>Peers</p>",
            "<p>Influence behavior and attitudes during adolescence</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Media</p>",
            "<p>Shapes beliefs and cultural awareness</p>"
          ]
        }
      ]
    },

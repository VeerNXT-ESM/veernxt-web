          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Art and literature</p>",
            "<p>Creative expressions of culture</p>"
          ]
        }
      ]
    },
    {
      "id": "nqgvi8q",
      "type": "heading",
      "level": 2,
      "content": "Socialization"
    },
    {
      "type": "paragraph",
      "id": "2y2tu4r",
      "content": "Socialization is the lifelong process through which individuals learn social norms, values, and behaviors necessary for participation in society."
    },

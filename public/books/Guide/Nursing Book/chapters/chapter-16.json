    {
      "id": "lwagmzy",
      "type": "heading",
      "level": 2,
      "content": "Introduction"
    },
    {
      "type": "keyFacts",
      "title": "Key Takeaways",
      "items": [
        "Sociology examines the structure, culture, and socialization processes within human societies.",
        "Social stratification and family dynamics act as major social determinants of health.",
        "Social problems directly influence community health standards and individual patient outcomes.",
        "Nurses must understand sociological elements to deliver holistic, culturally competent care."
      ],
      "id": "e05rusz"
    },

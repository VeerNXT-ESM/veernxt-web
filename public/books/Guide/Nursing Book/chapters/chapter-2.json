      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Term</strong></p>",
            "<p><strong>Description</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Tidal Volume</p>",
            "<p>Amount of air inhaled in normal breath (~500 mL)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Vital Capacity</p>",
            "<p>Maximum air expelled after deep breath</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Residual Volume</p>",
            "<p>Air remaining in lungs after forced expiration</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Alveoli</p>",
            "<p>Site of gas exchange</p>"
          ]
        }
      ]
    },
    {
      "id": "hfhgsev",
      "type": "heading",
      "level": 2,
      "content": "Digestive Physiology"
    },
    {
      "type": "paragraph",
      "id": "ucydvil",
      "content": "The digestive system breaks down food, absorbs nutrients, and eliminates waste."
    },

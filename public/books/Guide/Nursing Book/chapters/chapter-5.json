      "content": "Types of Inflammation"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Feature",
        "Necrosis",
        "Apoptosis"
      ],
      "rows": [
        [
          "Cell Size",
          "Enlarged (cellular swelling)",
          "Reduced (cellular shrinkage)"
        ],
        [
          "Nucleus",
          "Pyknosis, Karyorrhexis, Karyolysis",
          "Fragmentation into nucleosome-sized fragments"
        ],
        [
          "Plasma Membrane",
          "Disrupted (leaking contents)",
          "Intact (structure altered for phagocytosis)"
        ],
        [
          "Adjacent Inflammation",
          "Frequent and extensive",
          "Absent"
        ],
        [
          "Physiologic/Pathologic Role",
          "Invariably pathologic",
          "Often physiologic (can be pathologic)"
        ]

          "isHeader": true,
          "cells": [
            "<p><strong>Term</strong></p>",
            "<p><strong>Meaning</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Drug</p>",
            "<p>Chemical substance used for diagnosis, treatment, or prevention of disease</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Pharmacokinetics</p>",
            "<p>Study of how the body absorbs, distributes, metabolizes, and excretes drugs</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Pharmacodynamics</p>",
            "<p>Study of the biochemical and physiological effects of drugs</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Therapeutic effect</p>",
            "<p>Desired beneficial effect of a drug</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Side effect</p>",
            "<p>Unintended effect occurring at normal doses</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Toxicity</p>",
            "<p>Harmful effect of a drug due to overdose or accumulation</p>"
          ]
        }
      ]
    },

      "level": 2,
      "content": "Introduction"
    },
    {
      "type": "keyFacts",
      "title": "Key Takeaways",
      "items": [
        "Explores the primary clinical role and responsibilities of the Medical-Surgical Nurse.",
        "Covers major system-based clinical conditions including Cardiovascular, Respiratory, Gastrointestinal, Renal, Neurological, and Endocrine disorders.",
        "Details essential nursing interventions required throughout Preoperative and Postoperative patient care.",
        "Highlights high-yield nursing assessment points and exam-oriented clinical facts."
      ],
      "id": "bgx58ta"
    },

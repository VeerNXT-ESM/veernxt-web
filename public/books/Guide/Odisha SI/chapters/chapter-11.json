            "<p><strong>Significance</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Jagannath Temple (Puri)</p>",
            "<p>Puri</p>",
            "<p>One of Char Dham; Lord Jagannath; Rath Yatra; 12th century; 65 m high</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Konark Sun Temple</p>",
            "<p>Konark, Puri</p>",
            "<p>UNESCO World Heritage Site; built by Narasimhadeva I (1250 CE); 'Black Pagoda'</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Lingaraj Temple</p>",
            "<p>Bhubaneswar</p>",
            "<p>Dedicated to Harihara (Shiva-Vishnu); 11th century; 55 m high; finest Kalinga temple</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Mukteshwar Temple</p>",
            "<p>Bhubaneswar</p>",

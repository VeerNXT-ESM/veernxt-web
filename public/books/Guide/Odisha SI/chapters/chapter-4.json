        },
        {
          "isHeader": false,
          "cells": [
            "<p>Highest Rainfall</p>",
            "<p>&gt;2000 mm</p>",
            "<p>Koraput, Malkangiri, Nabarangapur, Mayurbhanj</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Heavy Rainfall</p>",
            "<p>1400-2000 mm</p>",
            "<p>Puri, Cuttack, Keonjhar, Sundargarh</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Moderate Rainfall</p>",
            "<p>1000-1400 mm</p>",
            "<p>Bolangir, Bargarh, Sambalpur</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Lowest Rainfall</p>",
            "<p>&lt;1000 mm</p>",

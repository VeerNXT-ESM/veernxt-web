      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Season</strong></p>",
            "<p><strong>Period &amp; Features</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Summer</p>",
            "<p>March to May; hot and humid; max temp 40–45°C in interior</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>South-West Monsoon</p>",
            "<p>June to September; heavy rainfall; 80% of annual rain in this period</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Post-Monsoon</p>",
            "<p>October–November; retreating monsoon; cyclone season</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Winter</p>",
            "<p>December to February; cool and dry; mild along coast</p>"
          ]
        }
      ]
    },

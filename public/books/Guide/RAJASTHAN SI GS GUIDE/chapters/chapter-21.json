      "content": "B.1 RPSC (Rajasthan Public Service Commission)"
    },
    {
      "type": "paragraph",
      "content": "The Rajasthan Public Service Commission is headquartered at Ajmer. It conducts recruitment for state civil services (RAS), state services (subordinate), and other Group A &amp; B posts.",
      "id": "4c2wsuh"
    },
    {
      "id": "rbtk7a6",
      "type": "table",
      "rows": [
        {

            "<p><strong>Exam Pattern</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>RAS/RTS (Rajasthan Administrative Service)</p>",
            "<p>Prelims (200 MCQ) + Mains (Written + Interview)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Assistant Professor</p>",
            "<p>Subject paper + General Studies</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>School Lecturer</p>",
            "<p>Subject paper + General Knowledge + Teaching Methodology</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>State Services (Group B)</p>",
            "<p>Written exam + Interview</p>"
          ]
        }
      ]
    },

      "items": [
        "Rivers flowing into the Bay of Bengal (Eastern drainage)",
        "Rivers flowing into the Arabian Sea (Western drainage)",
        "Rivers with no outlet to the sea (Internal drainage – flows into saline lakes)"
      ]
    },

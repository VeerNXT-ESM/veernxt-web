            "<p><strong>Bases</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Taste</p>",
            "<p>Sour</p>",
            "<p>Bitter</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Litmus test</p>",
            "<p>Blue → Red</p>",
            "<p>Red → Blue</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

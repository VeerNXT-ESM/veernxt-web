            "<p>Produces hydrogen gas</p>",
            "<p>Usually no reaction</p>"
          ]
        }
      ]
    },
    {
      "id": "iaar68m",
      "type": "heading",
      "level": 2,
      "content": "5. Strength of Acids and Bases"
    },
    {
      "type": "paragraph",
      "id": "d0m3xav",
      "content": "• Strong acids completely ionize in water."
    },
    {
      "type": "paragraph",
      "id": "gxstoym",
      "content": "• Weak acids partially ionize in water."
    },
    {
      "type": "paragraph",
      "id": "mt3rc4q",
      "content": "• Strong bases completely ionize in water."
    },
    {
      "type": "paragraph",
      "id": "szrhbbk",
      "content": "• Weak bases partially ionize."
    },
    {
      "id": "8wfbn1x",
      "type": "heading",
      "level": 2,
      "content": "6. pH Scale"
    },
    {
      "type": "paragraph",
      "id": "rosjvrv",
      "content": "The pH scale measures the acidity or basicity of a solution and ranges from 0 to 14."
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Property",
        "Acids",
        "Bases"
      ],
      "rows": [
        [
          "Taste",
          "Sour",
          "Bitter"
        ],
        [
          "Ions Produced in Water",
          "Hydrogen ions (H+) / Hydronium (H3O+)",
          "Hydroxide ions (OH-)"
        ],
        [
          "Litmus Paper Test",
          "Turns blue litmus red",
          "Turns red litmus blue"
        ],
        [
          "Phenolphthalein Test",
          "Remains colorless",
          "Turns bright pink"
        ],
        [
          "Texture / Touch",
          "Corrosive, burning sensation",
          "Slippery / Soapy to touch"
        ]
      ],
      "id": "8y9jvdc"
    },
    {
      "type": "paragraph",
      "id": "4nbvymx",
      "content": "pH &lt; 7 : Acidic solution"
    },
    {
      "type": "paragraph",
      "id": "s4j5hdi",
      "content": "pH = 7 : Neutral solution"
    },
    {
      "type": "paragraph",
      "id": "0yqwdmb",
      "content": "pH &gt; 7 : Basic solution"
    },
    {
      "id": "b27j69n",
      "type": "heading",
      "level": 2,
      "content": "7. Indicators"
    },
    {
      "id": "y50y1qs",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Indicator</strong></p>",

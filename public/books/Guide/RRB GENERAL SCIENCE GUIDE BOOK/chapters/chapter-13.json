      "content": "• Cytoplasm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "n64okd2",
      "content": "• Nucleus"
    },
    {
      "id": "50h1d78",
      "type": "heading",
      "level": 2,
      "content": "5. Cell Membrane"
    },
    {
      "type": "paragraph",
      "id": "ozqwmne",
      "content": "• Also called plasma membrane."
    },
    {
      "type": "paragraph",
      "id": "r7mcekh",
      "content": "• Controls movement of substances into and out of the cell."
    },
    {
      "type": "paragraph",
      "id": "981ksoi",
      "content": "• It is selectively permeable."
    },

            "<p>Natural immunity present at birth</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Acquired immunity</p>",
            "<p>Developed after infection or vaccination</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Active immunity</p>",
            "<p>Produced by body after exposure to antigen</p>"
          ]
        },
        {
          "isHeader": false,

    {
      "type": "paragraph",
      "id": "qruhcz7",
      "content": "<strong>Important: </strong><em>Article 343 makes Hindi the Official Language of the Union (not National Language). The Constitution does not designate any language as 'national language'. The 8th Schedule lists 22 recognised languages.</em>"
    },

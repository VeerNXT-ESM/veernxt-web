      "type": "heading",
      "level": 2,
      "content": "2.2 Official Languages Rules, 1976"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Region Classification",
        "Coverage / Definition"
      ],
      "rows": [
        [
          "Region A",
          "States and UTs where Hindi is the primary language of communication (e.g., UP, MP, Bihar, Rajasthan, Haryana, Delhi)."
        ],
        [
          "Region B",
          "States and UTs where communication with the Union is substantially in Hindi (e.g., Maharashtra, Gujarat, Punjab, Chandigarh)."
        ],
        [
          "Region C",
          "All other States and Union Territories not included in Region A or Region B (e.g., Southern States, North-Eastern States)."
        ]
      ],
      "id": "odweoxt"

          "cells": [
            "<p>Bhartendu Harishchandra</p>",
            "<p>1850–1885</p>",
            "<p>Poetry, Drama, Essays, Journalism</p>",
            "<p>Andher Nagari (play); Bharat Durdasha (play); founder of modern Hindi literature; modernised Hindi prose; started Hindi journalism</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Mahavir Prasad Dwivedi</p>",
            "<p>1864–1938</p>",
            "<p>Essays, literary criticism</p>",
            "<p>Edited Saraswati magazine (1903–1920); standardised Khariboli Hindi grammar; encouraged modern Hindi literature; period named after him</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Maithili Sharan Gupt</p>",
            "<p>1886–1964</p>",
            "<p>Poetry</p>",
            "<p>Saket; Bharat-Bharati; Panchvati; national poet; Khari Boli poetry; praised by Gandhi; Rashtrakavi</p>"
          ]
        }
      ]
    },

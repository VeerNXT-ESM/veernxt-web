      "content": "Bhakti Kaal Writers"
    },
    {
      "id": "s6br2ji",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Writer</strong></p>",
            "<p><strong>Period</strong></p>",
            "<p><strong>Faith</strong></p>",
            "<p><strong>Famous Work / Contribution</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Kabir (कबीर)</p>",
            "<p>1440–1518</p>",
            "<p>Nirguna Sant; critical of both Hindu and Muslim orthodoxy</p>",
            "<p>Bijak; Dohe (couplets); formless God; opposed caste, superstition; weaver of Varanasi</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Tulsidas (तुलसीदास)</p>",
            "<p>1532–1623</p>",
            "<p>Saguna :Ram Bhakta</p>",
            "<p>Ramcharitmanas (Ram's story in Awadhi Hindi); Vinaypatrika; Hanuman Chalisa; Kavitavali; greatest Hindi poet</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Surdas (सूरदास)</p>",
            "<p>1478–1583</p>",
            "<p>Saguna :Krishna Bhakta</p>",
            "<p>Sursagar; Sahitya Lahari; blind poet; Braj Bhasha; vivid descriptions of Krishna's childhood (Bal Leela)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Meerabai (मीराबाई)</p>",
            "<p>1498–1547</p>",
            "<p>Saguna :Krishna Bhakta</p>",
            "<p>Padas (devotional songs); princess of Mewar; complete devotion to Krishna; Braj and Rajasthani Hindi</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Rahim (रहीम)</p>",
            "<p>1556–1627</p>",
            "<p>Bhakti + courtly; syncretic</p>",
            "<p>Dohe (couplets); humanistic and practical wisdom; Abdul Rahim Khan-i-Khana; Akbar's court</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Bihari (बिहारी)</p>",
            "<p>1603–1664</p>",
            "<p>Riti kaal; Sringara</p>",
            "<p>Satsai (700 dohas); extreme conciseness; elaborate imagery; Jaipur court poet</p>"
          ]
        }
      ]
    },

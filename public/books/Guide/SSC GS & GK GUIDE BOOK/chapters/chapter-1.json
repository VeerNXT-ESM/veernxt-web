      ],
      "id": "zikyhcm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "pm64dbd",
      "content": "• Decline in trade"
    },
    {
      "type": "paragraph",
      "id": "1op02ia",
      "content": "• Possible Aryan migration theory (debated)"
    },
    {
      "id": "k20t1gs",
      "type": "heading",
      "level": 2,
      "content": "9.SSC Exam Important Facts"
    },
    {
      "type": "paragraph",
      "id": "7rix4o6",
      "content": "• Indus Valley script is still undeciphered"
    },
    {
      "type": "paragraph",
      "id": "znzpwfq",
      "content": "• Lothal is famous for dockyard"
    },
    {
      "type": "paragraph",
      "id": "k149bzh",
      "content": "• Dholavira is known for water management"
    },
    {
      "type": "paragraph",
      "id": "fmrtn69",
      "content": "• Harappa civilization is also called Bronze Age civilization"
    },
    {
      "type": "paragraph",
      "id": "8m6gkit",
      "content": "• Great Bath is located in Mohenjo‑daro"
    }
  ],
  "enriched": true

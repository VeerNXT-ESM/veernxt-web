    {
      "id": "1xy6drw",
      "type": "heading",
      "level": 3,
      "content": "Exceptions to Right to Equality"
    },
    {
      "type": "paragraph",
      "id": "asdgmnh",
      "content": "• President and Governors enjoy immunity from court proceedings during their tenure."
    },
    {
      "type": "paragraph",
      "id": "djrz0ug",
      "content": "• Parliament can make special provisions for women and children."
    },
    {
      "type": "paragraph",
      "id": "zw1crul",
      "content": "• State can provide reservations for SC, ST and OBC."
    },
    {
      "type": "paragraph",
      "id": "1c05opv",
      "content": "• Diplomatic officials enjoy immunity."
    },
    {
      "id": "oaag8uw",
      "type": "heading",
      "level": 2,
      "content": "4. Right to Freedom (Articles 19–22)"
    },
    {
      "type": "paragraph",
      "id": "l1dqq2h",
      "content": "Article 19 provides six freedoms to citizens:"
    },
    {
      "type": "paragraph",
      "id": "v8y8yc9",
      "content": "• Freedom of speech and expression"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "1mnis9z",
      "content": "• Freedom to assemble peacefully"
    },
    {
      "type": "paragraph",
      "id": "o2ly1ok",
      "content": "• Freedom to form associations or unions"
    },
    {
      "type": "paragraph",
      "id": "80wdeua",
      "content": "• Freedom to move freely throughout India"
    },
    {
      "type": "paragraph",
      "id": "d75gaz1",
      "content": "• Freedom to reside and settle in any part of India"
    },
    {
      "type": "paragraph",
      "id": "gmp1y15",
      "content": "• Freedom to practice any profession or occupation"
    },
    {
      "id": "gaqewx6",
      "type": "heading",
      "level": 3,
      "content": "Reasonable Restrictions"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "4xhsofn",
      "content": "• Security of the state"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "8dgvcki",
      "content": "• Public order"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "vu6ret2",
      "content": "• Morality"
    },
    {
      "type": "paragraph",
      "id": "bhqnokv",
      "content": "• Friendly relations with foreign states"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "8kp0c87",
      "content": "• Contempt of court"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Writ Type",
        "Literal Meaning",
        "Purpose & Application"
      ],
      "rows": [
        [
          "Habeas Corpus",
          "To have the body of",
          "Protects against illegal detention; applicable against both public authorities and private individuals."
        ],
        [
          "Mandamus",
          "We Command",
          "Directs a public official or body to perform a duty they have failed or refused to perform."
        ],
        [
          "Prohibition",
          "To forbid",
          "Issued by a higher court to a lower court/tribunal to prevent it from exceeding its jurisdiction."
        ],
        [
          "Certiorari",
          "To be certified / informed",
          "Quashes an existing illegal order passed by a lower court, tribunal, or administrative body."
        ],
        [
          "Quo-Warranto",
          "By what authority?",
          "Inquires into the legality of a person's claim to a public office to prevent illegal usurpation."
        ]
      ],
      "id": "5pauwjd"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "yjsc75a",
      "content": "• Defamation"
    },
    {
      "type": "paragraph",
      "id": "1qjbd5k",
      "content": "Article 20 protects against arbitrary punishment."
    },
    {
      "type": "paragraph",
      "id": "p3a9m77",
      "content": "Article 21 guarantees protection of life and personal liberty."
    },
    {
      "type": "paragraph",
      "id": "tu759p2",
      "content": "Article 21A provides the Right to Education (added by 86th Amendment)."
    },
    {
      "type": "paragraph",
      "id": "cwsyv6q",
      "content": "Article 22 protects against arbitrary arrest and detention."
    },

    {
      "id": "iw0dkei",
      "type": "heading",
      "level": 2,
      "content": "2. Longitudes"
    },
    {
      "id": "oyf7jc9",
      "type": "image",
      "imageId": "sfyhcqx",
      "src": "/books/Guide/SSC GS & GK GUIDE BOOK/images/image_sfyhcqx.jpeg"
    },
    {
      "type": "paragraph",
      "id": "3rikcf1",
      "content": "• Longitudes are imaginary vertical lines joining North and South poles.<img></img>"
    },
    {
      "type": "paragraph",
      "id": "ltcldgx",
      "content": "• They measure distance east or west of the Prime Meridian."
    },
    {
      "type": "paragraph",
      "id": "rw119ua",
      "content": "• The Prime Meridian is located at Greenwich, London."
    },
    {
      "type": "paragraph",
      "id": "nd8d8zm",
      "content": "• There are 360° of longitude."
    },
    {
      "id": "gadmqp8",
      "type": "heading",
      "level": 2,
      "content": "3. Indian Standard Time (IST)"
    },
    {
      "type": "paragraph",
      "id": "8d85hwv",
      "content": "• India follows Indian Standard Time."
    },
    {
      "type": "paragraph",
      "id": "uttkdeo",
      "content": "• The standard meridian is 82°30′ East longitude.       "
    },
    {
      "type": "paragraph",
      "id": "ywabkhn",
      "content": "• It passes near Mirzapur in Uttar Pradesh."
    },
    {
      "type": "paragraph",
      "id": "1fk3e9i",
      "content": "• IST is 5 hours 30 minutes ahead of GMT."
    },

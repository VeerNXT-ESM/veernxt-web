    {
      "id": "terqggc",
      "type": "heading",
      "level": 2,
      "content": "3. Kinetic Energy"
    },
    {
      "type": "paragraph",
      "id": "7tvry2z",
      "content": "Kinetic energy is the energy possessed by an object due to its motion."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "hy3lcb8",
      "content": "Formula: KE = ½ mv²"
    },
    {
      "type": "paragraph",
      "id": "xcodsjv",
      "content": "Where:"
    },
    {
      "type": "paragraph",
      "id": "mhaxlc3",
      "content": "m = mass of the object"
    },
    {
      "type": "paragraph",
      "id": "fssyu8n",
      "content": "v = velocity of the object"
    },
    {
      "type": "pullQuote",
      "content": "Energy can neither be created nor destroyed; it can only be transformed from one form to another.",
      "id": "no6rgl7"
    },
    {
      "id": "ngazegx",
      "type": "heading",
      "level": 2,
      "content": "4. Potential Energy"
    },
    {
      "type": "paragraph",
      "id": "d9oyyqx",
      "content": "Potential energy is the energy possessed by an object due to its position or configuration."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "zl03hd5",
      "content": "Formula: PE = mgh"
    },
    {
      "type": "paragraph",
      "id": "0eprfpt",
      "content": "Where:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "lesiyx9",
      "content": "m = mass"
    },
    {
      "type": "paragraph",
      "id": "9cpuyjo",
      "content": "g = acceleration due to gravity"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "ofdx48n",
      "content": "h = height"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Parameter",
        "Kinetic Energy",
        "Potential Energy"
      ],
      "rows": [
        [
          "Definition",
          "Energy possessed by virtue of motion",

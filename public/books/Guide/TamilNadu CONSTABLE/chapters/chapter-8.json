          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Ashoka the Great</p>",
            "<p>268–232 BCE</p>",
            "<p>Kalinga War (261 BCE); converted to Buddhism; Dhamma policy; edicts</p>"
          ]
        }
      ]
    },

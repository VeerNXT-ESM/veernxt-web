        },
        {
          "isHeader": false,
          "cells": [
            "<p>Laterite Soil</p>",
            "<p>Parts of Khammam, Bhadradri</p>",
            "<p>Coffee, tea (limited)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Alluvial Soil</p>",
            "<p>River valleys of Godavari &amp; Krishna</p>",
            "<p>Paddy, sugarcane, vegetables</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

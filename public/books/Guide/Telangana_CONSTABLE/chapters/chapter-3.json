          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Assembly Seats</p>",
            "<p>119 (including 1 nominated Anglo-Indian – removed by 104th Amendment)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

            "<p>Manjeera</p>",
            "<p>Water supply to Hyderabad</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Nizamsagar Dam</p>",
            "<p>Manjira</p>",
            "<p>Oldest major dam; constructed under Nizam</p>"

    {
      "id": "hs8gppi",
      "type": "heading",
      "level": 2,
      "content": "1.4 Freedom Movement in Uttarakhand"
    },
    {
      "type": "paragraph",
      "id": "wrfc2z8",
      "content": "The freedom struggle had a distinct character in Uttarakhand. The region contributed significantly to the Indian National Movement through protests, civil disobedience, and sacrifice."
    },

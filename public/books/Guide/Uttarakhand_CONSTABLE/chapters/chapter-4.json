    },
    {
      "id": "p1xhh0a",
      "type": "list",
      "items": [
        "High Court of Uttarakhand is located in Nainital. It was established on 9 November 2000 (same day as state formation).",
        "First Chief Justice of Uttarakhand High Court: A.A. Desai",
        "The HC bench also sits at Dehradun.",
        "The state has 13 district courts (one for each district)."
      ]
    },

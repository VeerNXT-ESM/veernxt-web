    },
    {
      "id": "fv8plzo",
      "type": "list",
      "items": [
        "Kolkata Police — separate from WB Police; handles Kolkata city; headed by Commissioner",
        "STF (Special Task Force) — anti-crime, anti-drug, anti-terror operations",
        "CID (Crime Investigation Department) — investigates serious crimes",
        "SB (Special Branch) — intelligence gathering; VIP security",
        "IB (Intelligence Branch) — state intelligence; political intelligence",
        "WBPRB (WB Police Recruitment Board) — conducts SI, Constable exams; at prb.wb.gov.in",
        "Women's Helpline 1091 — WB Police helpline for women",
        "Police Helpline 100 — emergency police response",
        "Traffic Police Helpline 1073 — Kolkata traffic",
        "Kolkata Police Dial 100 — emergency; modernised as single integrated number",
        "DCRB (District Crime Record Bureau) — crime data at district level",
        "SCRB (State Crime Record Bureau) — crime data at state level; feeds into NCRB"
      ]
    },

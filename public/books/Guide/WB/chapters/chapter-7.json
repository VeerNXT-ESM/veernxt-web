          "cells": [
            "<p><strong>Netaji Subhas Chandra Bose</strong></p>",
            "<p>Cuttack origin (Odisha) but Bengal connection; INA; \"Dilli Chalo\" slogan</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Aurobindo Ghosh</strong></p>",
            "<p>Born Kolkata; revolutionary turned spiritual; went to Pondicherry</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Surya Sen (\"Master Da\")</strong></p>",
            "<p>Chittagong Armoury Raid 1930; hanged 1934</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Khudiram Bose</strong></p>",
            "<p>Youngest revolutionary; hanged at 18 (1908); Muzaffarpur bomb case</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Bipin Chandra Pal</strong></p>",
            "<p>Trio of Lal-Bal-Pal; extremist nationalist; born in Sylhet (now Bangladesh)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Rashbehari Bose</strong></p>",
            "<p>Delhi bomb case 1912; escaped to Japan; helped Netaji form INA</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Jatindranath Mukherjee (Bagha Jatin)</strong></p>",
            "<p>Revolutionary leader; died fighting British in Balasore (Odisha) 1915</p>"
          ]
        }
      ]

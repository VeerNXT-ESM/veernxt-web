          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Santragachi Lake</strong></p>",
            "<p>Howrah; famous for migratory whistling ducks in winter</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Bakreswar Thermal</strong></p>",
            "<p>Geothermal hot springs — Birbhum district</p>"
          ]

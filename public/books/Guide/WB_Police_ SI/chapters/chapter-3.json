      "content": "Climate of West Bengal"
    },
    {
      "id": "atj1vev",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Factor</strong></p>",
            "<p><strong>Details</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Type</strong></p>",
            "<p>Tropical monsoon in south; subtropical in north</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Summer</strong></p>",
            "<p>March–June; hot &amp; humid; Kolkata avg 35–40°C</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Monsoon</strong></p>",
            "<p>June–September; heavy rainfall; Darjeeling gets 300+ cm</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Winter</strong></p>",
            "<p>Nov–Feb; cool; Darjeeling gets snowfall; fog in plains</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Cyclones</strong></p>",
            "<p>South WB coast highly vulnerable to Bay of Bengal cyclones</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Rainfall</strong></p>",
            "<p>Varies — 150 cm in plains to 300+ cm in hills</p>"
          ]
        }
      ]
    },

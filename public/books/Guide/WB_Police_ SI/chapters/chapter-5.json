      "content": "Medieval Bengal"
    },
    {
      "id": "3r8gixl",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Period/Event</strong></p>",
            "<p><strong>Details</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Sultanate of Bengal</strong></p>",
            "<p>14th century; Shamsuddin Ilyas Shah united Bengal; capital Gaur</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Mughal Bengal</strong></p>",
            "<p>Under Akbar (1576); Bengal Subah formed; Dhaka as capital later</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Nawabs of Bengal</strong></p>",
            "<p>Semi-independent; Murshid Quli Khan (1717) — first Nawab; capital Murshidabad</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Siraj-ud-Daulah</strong></p>",
            "<p>Last Nawab of Bengal; defeated by British at Battle of Plassey (1757)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Battle of Plassey</strong></p>",
            "<p>23 June 1757 — British East India Company vs Siraj-ud-Daulah; turning point of Indian history</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Battle of Buxar</strong></p>",
            "<p>1764 — British defeated combined force; WB came under British control</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Fort William</strong></p>",
            "<p>Built by British in Kolkata; administrative centre</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Black Hole of Calcutta</strong></p>",
            "<p>1756 — Siraj imprisoned British soldiers in a small room; many died</p>"
          ]
        }
      ]
    },

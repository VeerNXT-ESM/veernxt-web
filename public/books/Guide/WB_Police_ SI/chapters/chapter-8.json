{
  "id": "ylnccei",
  "title": "Chapter 8: Post-Independence West Bengal",
  "order": 8,
  "blocks": [
    {
      "id": "lfnk6te",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Year</strong></p>",
            "<p><strong>Event</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>1947</strong></p>",
            "<p>Bengal partitioned — West Bengal joined India; East Bengal became East Pakistan</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>1950</strong></p>",
            "<p>West Bengal became state of Republic of India</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>1952</strong></p>",
            "<p>First state election; Congress won</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>1956</strong></p>",
            "<p>Some areas from Bihar (like Purulia) merged into WB after States Reorganisation</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>1971</strong></p>",
            "<p>Bangladesh Liberation War; massive refugee influx into WB</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>1977</strong></p>",
            "<p>Left Front (CPM) came to power — ruled for 34 years (1977–2011); longest in India</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>2000</strong></p>",
            "<p>Jharkhand carved out — no direct impact on WB boundaries</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>2011</strong></p>",
            "<p>Mamata Banerjee &amp; Trinamool Congress ended Left Front rule</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>2011 onwards</strong></p>",
            "<p>TMC ruling WB; Mamata Banerjee has been CM since 2011</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>2019</strong></p>",
            "<p>New districts formed — Kalimpong, Paschim Bardhaman, Jhargram, Alipurduar, Purba Bardhaman created in reorganisation</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>2022</strong></p>",
            "<p>TMC re-elected in 2021 for 3rd term; Mamata Banerjee CM</p>"
          ]
        }
      ]
    },
    {
      "id": "7o9j40b",
      "type": "heading",
      "level": 2,
      "content": "Chief Ministers of WB — Important Names"
    },
    {
      "id": "ia896r5",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Name</strong></p>",
            "<p><strong>Significance</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Prafulla Chandra Ghosh</strong></p>",
            "<p>First CM of West Bengal (1947)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Bidhan Chandra Roy</strong></p>",
            "<p>Most important early CM; 1948–62; built modern WB; \"Bidhan Shishu Shiksha Sangha\"</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Ajoy Mukherjee</strong></p>",
            "<p>Bangla Congress; formed United Front govt</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Jyoti Basu</strong></p>",
            "<p>Longest serving CM of WB (1977–2000); CPM; 23 years; also longest serving CM in India</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Buddhadeb Bhattacharjee</strong></p>",
            "<p>CPM; 2000–2011; industrialisation attempt; Singur &amp; Nandigram controversy</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p><strong>Mamata Banerjee</strong></p>",
            "<p>Founded TMC 1998; CM since 2011; first woman CM of WB</p>"
          ]
        }
      ]
    },

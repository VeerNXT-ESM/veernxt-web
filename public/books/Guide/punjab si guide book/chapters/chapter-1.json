          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "id": "2rbmffd",
      "content": "The Five Ks (Panj Kakars) introduced by Guru Gobind Singh Ji:"
    },
    {
      "id": "n2ik363",
      "type": "list",
      "items": [
        "Kesh :Unshorn hair",
        "Kara :Steel bracelet",
        "Kanga :Wooden comb",
        "Kachera :Cotton undergarment",
        "Kirpan :Steel sword/dagger"
      ]
    },
    {

      "content": "2.3 Climate"
    },
    {
      "id": "yy3g9sm",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Season</strong></p>",
            "<p><strong>Characteristics</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Summer (April–June)</p>",
            "<p>Hot and dry; temperatures up to 45°C in plains; Loo (hot dusty wind) blows; maximum temperature at Bathinda, Firozpur</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Monsoon (July–September)</p>",
            "<p>SW monsoon brings 60–70% of annual rainfall; average annual rainfall 300–700 mm; Shivaliks get more rain (1000mm+)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Post-Monsoon/Autumn (Oct–Nov)</p>",
            "<p>Retreating monsoon; dry and cool; beginning of Rabi crop sowing</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Winter (December–February)</p>",
            "<p>Cold; temperature drops to near 0°C in some areas; fog common in plains; snowfall in Shivalik foothills; Western disturbances bring winter rain beneficial for wheat</p>"
          ]
        }
      ]
    },

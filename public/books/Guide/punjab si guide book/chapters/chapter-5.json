      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p>Language / Script</p>",
            "<p>Details</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjabi</p>",
            "<p>Official state language; spoken by majority; Indo-Aryan language</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Script</p>",
            "<p>Gurmukhi (for Punjabi in India); Shahmukhi (Nastaliq Perso-Arabic script, used in Pakistan)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Gurmukhi Origin</p>",
            "<p>Developed and standardized by Guru Angad Dev Ji (2nd Sikh Guru)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hindi</p>",
            "<p>Second official language in Punjab; widely understood</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Urdu</p>",
            "<p>Significant minority language; used by Muslim communities</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Dialects of Punjabi</p>",
            "<p>Majhi (Amritsar-Lahore region :considered standard); Doabi (Jalandhar doab); Malwai (Malwa region); Pwadhi (SE Punjab); Dogri (N Punjab foothills)</p>"
          ]
        }
      ]
    },
    {
      "id": "ltxqcvi",
      "type": "heading",
      "level": 2,
      "content": "5.2 Folk Dances of Punjab"
    },
    {
      "id": "3xn7xy3",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Dance</strong></p>",
            "<p><strong>Performed By</strong></p>",
            "<p><strong>Occasion / Description</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Bhangra</p>",
            "<p>Men</p>",
            "<p>Harvest festival (Baisakhi); energetic; dhol, chimta, tumbi instruments; now performed worldwide</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Giddha</p>",
            "<p>Women</p>",
            "<p>Folk celebration; based on Boliyan (folk verses); antiphonal singing; graceful</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Jhummar</p>",
            "<p>Men (Malwa region)</p>",
            "<p>Slow, graceful; performed in circles; typically at weddings; Jhummri is the women's version</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Luddi</p>",
            "<p>Men</p>",
            "<p>Victory dance; performed after battle or achievement; loose and spontaneous</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Kikli</p>",
            "<p>Girls / Young women</p>",
            "<p>Pair dance; spinning while holding hands; folk game-dance hybrid</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Daankara</p>",
            "<p>Men</p>",
            "<p>Stick dance; performed during wedding processions</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Dhamal</p>",
            "<p>Sufi devotees</p>",
            "<p>Spiritual ecstatic dance at Sufi shrines; whirling</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sammi</p>",
            "<p>Women (Malwa)</p>",
            "<p>Traditional women's folk dance with melodic singing</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Gatka</p>",
            "<p>Men (Sikh)</p>",
            "<p>Traditional Sikh martial art / performance; weaponry display; also performed at festivals</p>"
          ]
        }
      ]
    },
    {
      "id": "z2qta9d",
      "type": "heading",
      "level": 2,
      "content": "5.3 Folk Music and Musical Instruments"
    },
    {
      "id": "2s9k5dt",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p>Instrument / Form</p>",
            "<p>Description</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Dhol</p>",
            "<p>Large double-headed barrel drum; backbone of Punjabi folk music; indispensable at Bhangra</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Tumbi</p>",
            "<p>Single-stringed plucked instrument; high-pitched tone; popularized by Lal Chand Yamla Jatt</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Chimta</p>",
            "<p>Fire tongs used as percussion; played at Giddha and religious functions</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Algoza (Dotura)</p>",
            "<p>Double flute; pairs of flutes blown simultaneously; popular in Malwa region</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Sarangi</p>",
            "<p>Bowed string instrument; used in classical and folk music</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Iktara / Ek Tara</p>",
            "<p>Single-string instrument; used by wandering saints (Jogis, Fakirs)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Toomba</p>",
            "<p>Gourd instrument; used in tumbi making</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Waja (Harmonium)</p>",
            "<p>Indian harmonium; ubiquitous in Punjabi music, bhajan, gurbani kirtan</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Tabla</p>",
            "<p>Pair of hand drums; classical and popular music</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Bolian</p>",
            "<p>Improvised couplets sung by women in Giddha; humorous, philosophical, romantic</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Mahiya</p>",
            "<p>Love songs of Punjab; expresses longing; sung in a specific melodic style</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Tappe</p>",
            "<p>Short lyrical compositions; intense emotion; associated with folk singer Meeta Bai Tappa</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Vaar</p>",
            "<p>Heroic ballads; sung by dhadis; narrate battles and heroic deeds</p>"
          ]
        }
      ]
    },
    {
      "id": "sk4inzw",
      "type": "heading",
      "level": 2,
      "content": "5.4 Festivals of Punjab"
    },
    {
      "id": "xeurhkr",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Festival</strong></p>",
            "<p><strong>Time of Year</strong></p>",
            "<p><strong>Significance</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Baisakhi</p>",
            "<p>April 13/14 each year</p>",
            "<p>Harvest festival; Sikh New Year; anniversary of Khalsa founding (1699); celebrated at Anandpur Sahib and Golden Temple</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Lohri</p>",
            "<p>January 13</p>",
            "<p>Winter harvest festival; bonfire; sugarcane and peanuts offered; celebrated by all communities; marks end of winter</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Gurpurabs</p>",
            "<p>Various (lunar calendar)</p>",
            "<p>Birth/death anniversaries of Sikh Gurus; Nagar Kirtan processions; Akhand Path; Guru Granth Sahib carried on palanquin</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hola Mohalla</p>",
            "<p>Day after Holi (March)</p>",
            "<p>Martial arts, mock battles; organized by Guru Gobind Singh at Anandpur Sahib; Nihang Sikhs participate</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Diwali</p>",
            "<p>October/November</p>",
            "<p>Festival of lights; particularly significant at Amritsar (Golden Temple lit up); marks Guru Hargobind Ji's release from Gwalior Fort</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Teeyan (Teej)</p>",
            "<p>Sawan (July-August)</p>",
            "<p>Women's festival; swings, folk songs, henna; celebrates arrival of monsoon</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Maghi Mela</p>",
            "<p>January 14 (Makar Sankranti)</p>",
            "<p>At Muktsar; commemorates 40 Muktay (liberated ones) who died fighting Mughals; large gathering</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Basant Panchami</p>",
            "<p>January/February</p>",
            "<p>Festival of spring; kite flying; yellow clothes; marks arrival of spring</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Eid-ul-Fitr &amp; Eid-ul-Adha</p>",
            "<p>Islamic calendar</p>",
            "<p>Celebrated by Muslims in Punjab; significant in Malerkotla (historic Muslim center)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Navratra / Durgiana Fair</p>",
            "<p>Ashwin (Oct)</p>",
            "<p>Hindu festival; Durgiana Temple fair in Amritsar; deity worship</p>"
          ]
        }
      ]
    },

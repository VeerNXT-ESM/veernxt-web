          "isHeader": false,
          "cells": [
            "<p>Punjab Land Revenue Act</p>",
            "<p>1887</p>",
            "<p>Governs land records, rights, assessment; framework for patwaris and revenue officers</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Tenancy Act</p>",
            "<p>1887</p>",
            "<p>Rights of tenants; occupancy rights; governs landlord-tenant relations in rural Punjab</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Alienation of Land Act</p>",
            "<p>1900</p>",
            "<p>Prohibited transfer of agricultural land from agricultural to non-agricultural tribes; repealed 1947</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Security of Land Tenures Act</p>",
            "<p>1953</p>",
            "<p>Protected small tenants from eviction; upper ceiling on landholding</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Land Reforms Act</p>",
            "<p>1972</p>",
            "<p>Land ceiling; redistribution of surplus land to landless/marginal farmers</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Village Common Lands (Regulation) Act</p>",
            "<p>1961</p>",
            "<p>Governs panchayat lands (shamlat deh)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Police Act</p>",
            "<p>2007</p>",
            "<p>Restructured Punjab Police; State Police Complaints Authority; District Police Complaints Authority; accountability mechanisms</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Gurdwaras Act (Sikh Gurdwaras Act)</p>",
            "<p>1925</p>",
            "<p>Established SGPC; transferred gurdwara management from mahants to elected Sikh body</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Regional and Town Planning and Development Act</p>",
            "<p>1995</p>",
            "<p>Urban development; PUDA (Punjab Urban Development Authority)</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Right to Service Act</p>",
            "<p>2011</p>",
            "<p>Time-bound delivery of government services; penalty for delay</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Prevention of Human Trafficking Act</p>",
            "<p>2012</p>",
            "<p>Prevention and rescue in human trafficking cases</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Scheduled Castes Land Development and Finance Corporation Act</p>",
            "<p>1971</p>",
            "<p>Financial assistance to SC communities</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Punjab Fiscal Responsibility and Budget Management Act</p>",
            "<p>2003</p>",
            "<p>Fiscal discipline; debt and deficit limits</p>"

    {
      "type": "paragraph",
      "content": "Economic Planning refers to the conscious and systematic effort made by the government to use national resources efficiently to achieve economic and social goals within a fixed period.",
      "id": "yaacvnw"
    },
    {
      "type": "paragraph",
      "content": "It answers four basic questions:",
      "id": "d7l0iu9"
    },
    {
      "id": "j3rwkmt",
      "type": "numberedList",
      "items": [
        "What to produce?",
        "How much to produce?",
        "How to produce?",
        "For whom to produce?"
      ]
    },

      "level": 2,
      "content": "3.13  स्मरणीय बिंदु"
    },
    {
      "id": "p1sax18",
      "type": "list",
      "items": [
        "हिंदी शब्द चार वर्गों में आते हैं:तत्सम, तद्भव, देशज, विदेशज।",
        "तत्सम = संस्कृत मूल शब्द ज्यों-का-त्यों।",
        "तद्भव = संस्कृत से बिगड़कर बने हिंदी शब्द।",
        "पर्यायवाची = समान अर्थ, पर संदर्भ के अनुसार प्रयोग अलग।",
        "विलोम = विपरीत अर्थ।",
        "अनेकार्थी = एक शब्द, अनेक अर्थ।",
        "श्रुतिसमभिन्नार्थक = समान उच्चारण, अलग अर्थ।",
        "उपसर्ग शब्द के आगे, प्रत्यय शब्द के पीछे लगता है।"
      ]
    }

    {
      "id": "390brwk",
      "type": "numberedList",
      "items": [
        "निम्नलिखित शब्दों के तत्सम रूप लिखिए: आग, आँख, पाँव, दाँत, हाथ, रात, घर, फूल",
        "निम्नलिखित तत्सम शब्दों के तद्भव रूप लिखिए: वायु, नेत्र, पुष्प, कर्ण, ग्राम, चंद्र, सप्त, दश",
        "'जल' के पाँच पर्यायवाची शब्द लिखिए।",
        "'सत्य' और 'आकाश' के विलोम शब्द लिखिए।",
        "'कर' शब्द के तीन अलग-अलग अर्थ वाक्यों में लिखकर समझाइए।",
        "'दिन' और 'दीन' में अंतर स्पष्ट कीजिए।",
        "उपसर्ग 'अ', 'सु', 'वि' और 'प्र' से दो-दो शब्द बनाइए।",
        "प्रत्यय 'आई', 'ता' और 'वाला' से दो-दो शब्द बनाइए।"
      ]
    },
    {
      "id": "e3raciw",

        },
        {
          "isHeader": false,
          "cells": [
            "<p>कर्ता (Nominative)</p>",
            "<p>ने (भूतकाल में)</p>",
            "<p>राम ने आम खाया।</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>कर्म (Accusative)</p>",

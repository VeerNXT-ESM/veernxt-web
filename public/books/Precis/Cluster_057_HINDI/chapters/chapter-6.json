{
  "id": "628nm6w",
  "title": "अध्याय 6 विशेषण और क्रियाविशेषण",
  "order": 6,
  "blocks": [
    {
      "id": "ni1f34k",
      "type": "heading",
      "level": 2,
      "content": "6.1  विशेषण:परिचय"
    },
    {
      "type": "keyFacts",
      "title": "Key Takeaways",
      "items": [
        "विशेषण संज्ञा या सर्वनाम की विशेषता बताने वाले शब्द होते हैं।",
        "विशेषण के प्रमुख भेद गुणवाचक, संख्यावाचक, परिमाणवाचक और सार्वनामिक विशेषण हैं।",
        "विशेषण की तीन तुलनावस्थाएँ (Degrees of Comparison) होती हैं: मूलावस्था, उत्तरावस्था और उत्तमावस्था।",
        "विशेष्य वह संज्ञा या सर्वनाम है जिसकी विशेषता बताई जाती है, जबकि विधेय-विशेषण क्रिया के बाद प्रयुक्त होने वाला विशेषण है।",
        "क्रियाविशेषण अविकारी (अव्यय) शब्द होते हैं जो क्रिया की विशेषता, काल, स्थान या परिमाण बताते हैं।"
      ],
      "id": "9qwz9pw"
    },
    {
      "type": "statStrip",
      "stats": [
        {
          "label": "विशेषण के भेद",
          "value": "4",
          "icon": "book"
        },

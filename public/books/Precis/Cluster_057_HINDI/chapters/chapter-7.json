            "<p><strong>पुल्लिंग बहुवचन</strong></p>",
            "<p><strong>स्त्रीलिंग एकवचन</strong></p>",
            "<p><strong>स्त्रीलिंग बहुवचन</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>उत्तम</p>",
            "<p>मैं जाऊँगा</p>",

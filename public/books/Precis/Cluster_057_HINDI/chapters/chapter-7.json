          "वाक्य में कर्म अनुपस्थित रहता है।"
        ],
        [
          "क्रिया का प्रभाव",
          "क्रिया के व्यापार का फल कर्म पर पड़ता है।",
          "क्रिया के व्यापार का फल सीधे कर्ता पर पड़ता है।"
        ],
        [
          "उदाहरण",
          "राम पुस्तक पढ़ता है। ('पुस्तक' कर्म है)",

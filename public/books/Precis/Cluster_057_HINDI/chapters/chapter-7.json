            "<p>वह खा चुका है।</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>सकता / सकती / सकते</p>",
            "<p>संभावना / सामर्थ्य</p>",
            "<p>वह जा सकता है।</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

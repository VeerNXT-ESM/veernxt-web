    },
    {
      "type": "paragraph",
      "content": "Secondary Functions:",
      "id": "9r93dpz"
    },
    {
      "type": "paragraph",
      "content": "• Agency Functions (collection of cheques, payment of bills)<br/>• Utility Services (ATM, internet banking, debit cards)",
      "id": "hqka2nv"
    },

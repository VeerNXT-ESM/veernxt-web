            "<p>Tax on individual income</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Corporate Tax</p>",
            "<p>Tax on company profits</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

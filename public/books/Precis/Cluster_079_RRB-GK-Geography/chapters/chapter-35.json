    {
      "type": "keyFacts",
      "title": "Key Takeaways",
      "items": [
        "Longitudes are imaginary semicircles connecting the North Pole to the South Pole.",
        "They measure the angular distance of a location east or west relative to the Prime Meridian.",
        "Unlike full-circle latitudes, longitude lines are defined as semicircles."
      ],
      "id": "kyqkp77"
    },
    {
      "type": "examAlert",
      "items": [
        "Longitudes run from pole to pole (North Pole to South Pole) as imaginary semicircles.",
        "The measurement direction for longitudinal angular distance is always East or West of the Prime Meridian."
      ],
      "id": "y09kutz"
    },

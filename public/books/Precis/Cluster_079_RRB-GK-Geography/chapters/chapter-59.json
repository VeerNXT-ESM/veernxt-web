    {
      "type": "examAlert",
      "items": [
        "Remember the top-to-bottom sequence using the mnemonic CMRGL: Conrad, Mohorovicic, Repetti, Gutenberg, Lehmann.",
        "Gutenberg Discontinuity at ~2900 km marks the depth where S-waves stop propagating because the outer core is liquid.",
        "Moho discontinuity depth varies significantly: ~35 km beneath continents versus ~5-10 km beneath ocean basins."
      ],
      "id": "543rnnb"
    },
    {
      "type": "keyFacts",
      "title": "Key Takeaways",
      "items": [
        "Conrad Discontinuity separates the upper crust (Sial) from the lower crust (Sima).",
        "Mohorovicic (Moho) Discontinuity forms the boundary between the Earth's crust and the upper mantle.",
        "Repetti Discontinuity marks the transition between the upper mantle and the lower mantle.",
        "Gutenberg Discontinuity separates the solid lower mantle from the liquid outer core.",
        "Lehmann Discontinuity separates the liquid outer core from the solid inner core."
      ],
      "id": "uzcyi9m"
    }

    {
      "id": "pln5pwk",
      "type": "heading",
      "level": 2,
      "content": "1. ILBERT BILL CONTROVERSY (1883)"
    },
    {
      "type": "paragraph",
      "content": "Proposed by Lord Ripon allowing Indian judges to try Europeans. Faced strong racial opposition; exposed British discrimination and strengthened nationalism.",
      "id": "wu3as7y"
    },
    {
      "id": "k685iau",
      "type": "heading",
      "level": 2,
      "content": "2. VERNACULAR PRESS ACT (1878)"
    },
    {
      "type": "paragraph",
      "content": "Passed by Lord Lytton to suppress Indian language newspapers. Repealed by Lord Ripon in 1882.",
      "id": "8rc67h4"
    },
    {
      "id": "bi0s5vb",
      "type": "heading",
      "level": 2,
      "content": "3. SWARAJ PARTY (1923)"
    },

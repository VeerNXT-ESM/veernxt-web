            "<p>Processes continuous data such as temperature or speed.</p>",
            "<p>Thermometer, Speedometer</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Digital Computer</p>",
            "<p>Processes discrete data using binary numbers.</p>",
            "<p>Desktop, Laptop</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Hybrid Computer</p>",
            "<p>Combination of analog and digital computers.</p>",
            "<p>Medical monitoring systems</p>"
          ]
        }
      ]

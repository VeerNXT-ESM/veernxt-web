    {
      "id": "55e0sj4",
      "type": "heading",
      "level": 2,
      "content": "4.7 Important Exam Points"
    },
    {
      "id": "ra5g6cp",
      "type": "list",
      "items": [
        "Keyboard is the most common input device.",
        "OMR is used for reading answer sheets in exams.",
        "OCR converts printed text into digital text.",
        "MICR is used by banks to process cheques.",
        "Touch screens are widely used in smartphones."
      ]
    }
  ],

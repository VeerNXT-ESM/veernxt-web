            "<p><strong>Function</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Joystick</p>",
            "<p>Used mainly in gaming and simulations.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Light Pen</p>",
            "<p>Used to draw directly on the screen.</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Touch Screen</p>",
            "<p>Allows users to interact by touching the display.</p>"
          ]
        }
      ]

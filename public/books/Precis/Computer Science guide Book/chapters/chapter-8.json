    {
      "type": "comparisonTable",
      "headers": [
        "Operating System Type",
        "Core Concept",
        "Key Feature"
      ],
      "rows": [
        [
          "Batch Operating System",
          "Jobs prepared offline and processed in groups",
          "Executes jobs in sequence without direct user interaction"
        ],
        [
          "Time Sharing Operating System",
          "Allocates CPU time-slices across multiple users",
          "Provides interactive environment and fast response time"
        ],
        [
          "Multiprocessing Operating System",
          "Utilizes two or more CPUs simultaneously",
          "Increases execution speed and parallel processing capacity"
        ]
      ],

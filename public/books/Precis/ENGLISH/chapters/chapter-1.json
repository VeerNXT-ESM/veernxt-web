      "content": "6.1 CAN vs COULD"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Modal/Verb Pairing",
        "Core Comparison Focus"
      ],
      "rows": [
        [
          "FINITE vs NON-FINITE VERBS",
          "Verbs bound by tense and subject vs. verbs that do not change with the subject"
        ],
        [
          "CAN vs COULD",
          "Present ability/permission vs. past ability/polite request"
        ],
        [
          "MAY vs MIGHT",
          "Higher probability/formal permission vs. lower probability/hypothetical condition"
        ],
        [
          "SHALL vs WILL",
          "First-person future/formal commands vs. second/third-person future and determination"
        ]
      ],
      "id": "k2vqlcg"
    },

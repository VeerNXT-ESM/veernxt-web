    {
      "type": "comparisonTable",
      "headers": [
        "Conjunction Pair / Word",
        "Function / Focus",
        "Mandatory Follow-Up Rule",
        "Common SSC Error"
      ],
      "rows": [
        [
          "Unless vs Until",
          "Unless = Condition; Until = Time",
          "Requires positive verb structure",
          "Adding 'not' inside the conditional clause"
        ],
        [
          "Lest",
          "Expresses purpose/precaution against negative outcome",
          "Followed by 'Should' or base verb",
          "Using 'will', 'would', or adding 'not'"
        ],
        [
          "No Sooner",
          "Expresses immediate sequential events",
          "Followed by 'Than' (Requires Inversion)",
          "Pairing with 'when', 'then', or omitting inversion"
        ],
        [
          "Hardly / Scarcely",
          "Expresses immediate sequential events",
          "Followed by 'When' or 'Before' (Requires Inversion)",
          "Pairing with 'than' instead of 'when'"
        ]
      ],
      "id": "g1955q6"

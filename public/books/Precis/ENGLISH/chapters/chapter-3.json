        "Verb Requirement",
        "Key Distinction"
      ],
      "rows": [
        [
          "A number of + Plural Noun",
          "Plural Verb",
          "Refers to an indefinite large quantity (e.g., 'A number of students are present')"
        ],
        [
          "The number of + Plural Noun",
          "Singular Verb",
          "Refers to a specific unit count (e.g., 'The number of students is fifty')"
        ]

      "content": "15. HIGH-PROBABILITY SSC RULES"
    },
    {
      "type": "paragraph",
      "id": "dl7shu2"
    },
    {
      "type": "examAlert",
      "items": [
        "Never use future tense modal verbs (will/shall) inside the conditional 'if' clause.",
        "Do not add 'not' inside an 'unless' clause, as 'unless' already carries a negative meaning.",
        "Use 'were' for all subjects (singular and plural) in imaginary or hypothetical second conditional statements.",
        "Inversion rule: 'Had + Subject + V3' replaces 'If + Subject + had + V3' without altering the third conditional meaning."
      ],
      "id": "pw93xg8"
    },

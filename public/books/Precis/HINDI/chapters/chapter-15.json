    {
      "id": "lk9uctj",
      "type": "heading",
      "level": 2,
      "content": "16.1  राजभाषा : परिचय"
    },
    {
      "type": "keyFacts",
      "title": "मुख्य बिंदु (Key Takeaways)",
      "items": [
        "भारतीय संविधान के भाग 17 में अनुच्छेद 343 से 351 तक राजभाषा संबंधी संवैधानिक प्रावधान दिए गए हैं।",
        "अनुच्छेद 343(1) के अनुसार संघ की राजभाषा हिंदी और लिपि देवनागरी होगी।",
        "राजभाषा अधिनियम 1963 को वर्ष 1967 में संशोधित किया गया था।",
        "राजभाषा नियम 1976 के तहत भारत के राज्यों को 'क', 'ख' और 'ग' क्षेत्रों में वर्गीकृत किया गया है।",
        "सरकारी पत्राचार और विधिक अनुवाद में मानक शब्दावली और सटीक पारिभाषिक शब्दों का प्रयोग अनिवार्य है।"
      ],
      "id": "qi8ctnt"
    },

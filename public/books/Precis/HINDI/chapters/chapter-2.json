{
  "id": "u4v6vp6",
  "title": "अध्याय 2- उच्चारण और ध्वनि",
  "order": 2,
  "blocks": [
    {
      "id": "ef2wot9",
      "type": "heading",
      "level": 2,
      "content": "2.1  ध्वनि क्या होती है?"
    },
    {
      "type": "keyFacts",
      "title": "महत्वपूर्ण बिंदु (Key Takeaways)",
      "items": [
        "ध्वनि भाषा की सबसे छोटी मौखिक इकाई है जिसका स्पष्ट उच्चारण वाक्-अंगों द्वारा होता है।",
        "उच्चारण अंगों (Organs of Speech) में कण्ठ, तालु, मूर्धा, दन्त एवं ओष्ठ मुख्य हैं।",
        "स्वर ध्वनियाँ स्वतंत्र रूप से उच्चारित होती हैं, जबकि व्यंजन ध्वनियों के उच्चारण में स्वर की सहायता आवश्यक है।",
        "ध्वनि परिवर्तन के नियमों का ज्ञान वर्तनी और संधि को सही रूप से समझने के लिए आवश्यक है।"
      ],
      "id": "jwuaasu"
    },
    {
      "type": "statStrip",
      "stats": [

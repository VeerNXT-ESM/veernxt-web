    {
      "type": "examAlert",
      "items": [
        "तत्सम और तद्भव शब्दों के बीच पहचान एवं अंतर पर आधारित प्रश्न बहुधा पूछे जाते हैं।",
        "उपसर्ग और प्रत्यय को मूल शब्द से अलग करने संबंधी अभ्यास प्रतियोगी परीक्षाओं के लिए अत्यंत महत्वपूर्ण हैं।",
        "श्रुतिसमभिन्नार्थक शब्दों के सूक्ष्म अर्थ-भेद पर आधारित प्रश्नों का नियमित अभ्यास करें।"
      ],
      "id": "ld4nvv4"

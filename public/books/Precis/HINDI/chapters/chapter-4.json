    {
      "type": "examAlert",
      "items": [
        "परीक्षाओं में प्रायः 'दही', 'घी', 'पानी', 'मोती' (पुल्लिंग) तथा 'लस्सी', 'छाछ' (स्त्रीलिंग) जैसे अपवाद शब्दों का लिंग पूछा जाता है।",
        "पदसूचक शब्द जैसे 'राष्ट्रपति', 'प्रधानमंत्री', 'डॉक्टर' उभयलिंगी होते हैं और इनका प्रयोग लिंग भेद के बिना समान रहता है।",
        "भाववाचक संज्ञाएँ हमेशा एकवचन में प्रयुक्त होती हैं; बहुवचन रूप में प्रयुक्त होने पर वे जातिवाचक संज्ञा बन जाती हैं।"
      ],

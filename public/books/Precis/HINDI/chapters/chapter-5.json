      "type": "numberedList",
      "items": [
        "निम्नलिखित वाक्यों में सर्वनाम पहचानकर उनका भेद बताइए:"
      ]
    },
    {
      "id": "g8d4ilf",
      "type": "list",
      "items": [
        "कोई दरवाज़े पर खड़ा है।",
        "जो परिश्रम करेगा, वह सफल होगा।",
        "यह पुस्तक किसकी है?",
        "उसने स्वयं यह निर्णय लिया।",
        "हम सब मिलकर काम करेंगे।"
      ]
    },
    {
      "id": "j9sk1x0",
      "type": "numberedList",
      "items": [
        "'मैं', 'तुम' और 'वह' के निम्नलिखित कारक रूप लिखिए: संबंध कारक, कर्म कारक, करण कारक।",
        "'कोई' और 'कौन' में क्या अंतर है? दो-दो उदाहरण देकर समझाइए।",

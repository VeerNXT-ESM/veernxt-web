{
  "id": "pmdtw2b",
  "title": "अध्याय 6 विशेषण और क्रियाविशेषण",
  "order": 6,
  "blocks": [
    {
      "id": "dgztwfr",
      "type": "heading",
      "level": 2,
      "content": "6.1  विशेषण:परिचय"
    },
    {
      "type": "keyFacts",
      "title": "मुख्य बिंदु (Key Takeaways)",
      "items": [
        "संज्ञा या सर्वनाम की विशेषता बताने वाले शब्दों को विशेषण कहते हैं।",
        "विशेषण शब्द जिस संज्ञा या सर्वनाम की विशेषता बताते हैं, उसे विशेष्य कहा जाता है।",
        "विशेषण की तीन अवस्थाएं होती हैं: मूलावस्था, उत्तरावस्था और उत्तमावस्था।",
        "क्रिया की विशेषता बताने वाले अव्यय शब्दों को क्रियाविशेषण कहते हैं।",
        "विशेषण लिंग और वचन के अनुसार बदलते हैं, जबकि क्रियाविशेषण सदैव अविकारी रहते हैं।"
      ],
      "id": "7b3yuh2"
    },

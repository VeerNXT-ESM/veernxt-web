{
  "id": "xvj7w8r",
  "title": "अध्याय 7 क्रिया और काल",
  "order": 7,
  "blocks": [
    {
      "id": "yzkturz",
      "type": "heading",
      "level": 2,
      "content": "7.1  क्रिया:परिचय"
    },
    {
      "type": "keyFacts",
      "title": "मुख्य बिंदु",
      "items": [
        "क्रिया के मूल रूप को धातु (Verb Root) कहा जाता है।",
        "क्रिया का काल क्रिया के निष्पादन के समय (वर्तमान, भूत, भविष्यत्) को दर्शाता है।",
        "वाच्य (Voice) के माध्यम से यह ज्ञात होता है कि वाक्य में क्रिया का मुख्य विषय कर्ता, कर्म या भाव है।",
        "सहायक क्रियाएँ मुख्य क्रिया के अर्थ को पूरा करने और उसके काल को स्पष्ट करने का कार्य करती हैं।"
      ],
      "id": "ntey57c"
    },

    },
    {
      "id": "81928sf",
      "type": "numberedList",
      "items": [
        "उपसर्ग अलग कीजिए और मूल शब्द लिखिए: अध्यक्ष, परिक्रमा, विदेश, प्रकाश, सुविचार",
        "प्रत्यय अलग कीजिए और मूल शब्द लिखिए: पढ़ाई, लिखावट, सुनार, ऐतिहासिक, बचपन, भारतीय",
        "कर्मधारय और बहुव्रीहि में अंतर उदाहरण सहित स्पष्ट कीजिए।",
        "'सम्' उपसर्ग से पाँच शब्द बनाइए।"
      ]
    },
    {
      "id": "1b1pz0f",
      "type": "heading",
      "level": 2,
      "content": "8.10  स्मरणीय बिंदु"
    },
    {
      "id": "v119dxb",
      "type": "list",
      "items": [
        "संधि:वर्णों का मेल; तीन प्रकार:स्वर, व्यंजन, विसर्ग।",
        "स्वर संधि के पाँच भेद:दीर्घ, गुण, वृद्धि, यण, अयादि।",
        "समास:शब्दों का मेल, विभक्ति का लोप; छः भेद।",
        "अव्ययीभाव:पहला पद प्रधान। तत्पुरुष:दूसरा पद प्रधान।",
        "कर्मधारय:विशेषण-विशेष्य। द्विगु:संख्यावाचक पहला पद।",
        "द्वंद्व:दोनों पद प्रधान। बहुव्रीहि:तीसरे का बोध।",
        "उपसर्ग:शब्द के आगे लगता है; अर्थ बदलता है।",
        "प्रत्यय:शब्द के पीछे लगता है; कृत् और तद्धित दो प्रकार।"
      ]
    }

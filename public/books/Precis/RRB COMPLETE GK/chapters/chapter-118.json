      "content": "• Granular Disintegration"
    },
    {
      "id": "pncnt4b",
      "type": "heading",
      "level": 2,
      "content": "C. Chemical Weathering Processes"
    },
    {
      "type": "paragraph",
      "id": "x8xq5oa",
      "content": "• Oxidation – reaction with oxygen (iron-rich rocks)."
    },
    {
      "type": "paragraph",
      "id": "p7nea8l",
      "content": "• Carbonation – carbonic acid dissolves limestone (karst landscapes)."
    },
    {
      "type": "paragraph",
      "id": "jlh43ka",
      "content": "• Hydrolysis – formation of clay minerals."
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Aspect",
        "Mechanical Weathering",
        "Chemical Weathering"
      ],
      "rows": [
        [
          "Definition",
          "Physical disintegration of rocks without chemical change",
          "Chemical decomposition altering the mineral composition"
        ],
        [
          "Dominant Environment",
          "Arid, semi-arid, and cold high-altitude regions",
          "Warm, hot, and humid tropical regions"
        ],
        [
          "Major Agents",
          "Temperature fluctuations, frost action, pressure release",
          "Water, oxygen, carbon dioxide, organic acids"
        ]
      ],
      "id": "69j5awp"

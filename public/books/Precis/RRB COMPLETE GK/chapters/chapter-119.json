  "title": "2. Mass Wasting (Mass Movement)",
  "order": 119,
  "blocks": [
    {
      "type": "paragraph",
      "id": "2yy8v42",
      "content": "Mass wasting is the downslope movement of weathered material under the influence of gravity without external transporting agents."
    },

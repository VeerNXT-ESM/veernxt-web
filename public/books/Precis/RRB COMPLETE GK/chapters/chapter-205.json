      "type": "comparisonTable",
      "headers": [
        "Feature",
        "Warm Local Winds",
        "Cold Local Winds"
      ],
      "rows": [
        [
          "Formation Cause",
          "Adiabatic heating during descent down mountain slopes or intense continental heating",
          "Drainage of cold, high-density air from polar plateaus or snow-covered mountain ranges"
        ],
        [
          "Temperature & Humidity",
          "Hot, dry, and moisture-absorbing",
          "Extremely cold, dry, and temperature-dropping"
        ],
        [
          "Local Effects",
          "Melts winter snow, raises pasture temperatures, or induces heatwaves",
          "Causes sudden blizzards, frost damage to crops, and severe wind chill"
        ],
        [
          "Prominent Examples",
          "Chinook (Rockies), Fohn (Alps), Loo (Northern India), Zonda (Andes)",
          "Mistral (Rhone Valley), Bora (Adriatic Sea), Pampero (Pampas), Blizzard (Polar)"
        ]
      ],

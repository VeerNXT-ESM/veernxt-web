      "level": 2,
      "content": "7. Factors Controlling Ocean Currents"
    },
    {
      "type": "paragraph",
      "id": "yj2v2mz",
      "content": "• Planetary wind systems."
    },
    {
      "type": "paragraph",
      "id": "9opmn9j",
      "content": "• Coriolis force."
    },
    {
      "type": "paragraph",
      "id": "2n36irh",
      "content": "• Temperature differences."
    },
    {
      "type": "paragraph",
      "id": "c5gxv2w",
      "content": "• Salinity variations."
    },
    {
      "type": "paragraph",
      "id": "x6pc2hy",
      "content": "• Shape of ocean basins."
    },

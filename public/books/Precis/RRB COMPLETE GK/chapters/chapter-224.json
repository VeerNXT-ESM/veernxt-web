      "type": "heading",
      "level": 2,
      "content": "8. LIQUIDITY ADJUSTMENT FACILITY (LAF)"
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Monetary Instrument / Concept",
        "Primary Objective"
      ],
      "rows": [
        [
          "Liquidity Adjustment Facility (LAF)",
          "Manages day-to-day liquidity mismatches through repo and reverse repo transactions."
        ],
        [
          "Marginal Standing Facility (MSF)",
          "Provides penal rate overnight liquidity borrowing window for scheduled commercial banks."
        ],
        [
          "Monetary Policy Committee (MPC)",
          "Determines benchmark policy interest rates to meet explicit inflation targets."
        ],
        [
          "Basel Norms",
          "Establishes international capital adequacy and risk mitigation standards for banks."
        ]
      ],
      "id": "fscwmn3"

    {
      "id": "0w3z3x9",
      "type": "heading",
      "level": 2,
      "content": "3. FUNCTIONS OF RBI"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "6x9q4f4",
      "content": "A. Monetary Authority"
    },
    {
      "type": "paragraph",
      "id": "j9eawp2",
      "content": "• Controls money supply<br></br>• Controls inflation<br></br>• Maintains financial stability"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "kzo7mf6",
      "content": "B. Issuer of Currency"
    },
    {
      "type": "paragraph",
      "id": "ibrlivq",
      "content": "• Sole authority to issue currency notes (except ₹1 note &amp; coins issued by Ministry of Finance)"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "qi0283z",
      "content": "C. Banker to Government"
    },
    {
      "type": "paragraph",
      "id": "2hxhago",
      "content": "• Manages government accounts<br></br>• Manages public debt"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "nbe5yzm",
      "content": "D. Banker’s Bank"
    },
    {
      "type": "paragraph",
      "id": "2oharbe",
      "content": "• Provides loans to commercial banks<br></br>• Maintains CRR of banks"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "i4xg1pa",
      "content": "E. Custodian of Foreign Exchange"
    },
    {
      "type": "paragraph",
      "id": "dodbi11",
      "content": "• Manages forex reserves<br></br>• Regulates exchange rate under FEMA, 1999"
    },
    {
      "id": "ni7gkw3",
      "type": "heading",
      "level": 2,
      "content": "4. MONETARY POLICY TOOLS"
    },

    {
      "id": "5e35ckv",
      "type": "heading",
      "level": 2,
      "content": "3. FUNCTIONS OF COMMERCIAL BANKS"
    },
    {
      "type": "paragraph",
      "id": "lm6nivt",
      "content": "Primary Functions:"
    },
    {
      "type": "paragraph",
      "id": "2a3axlh",
      "content": "• Accepting Deposits (Savings, Current, Fixed, Recurring)<br></br>• Granting Loans and Advances"
    },
    {
      "type": "paragraph",
      "id": "g85fnz8",
      "content": "Secondary Functions:"
    },
    {
      "type": "paragraph",
      "id": "nml533y",
      "content": "• Agency Functions (collection of cheques, payment of bills)<br></br>• Utility Services (ATM, internet banking, debit cards)"
    },
    {
      "id": "p8b56ld",
      "type": "heading",
      "level": 2,
      "content": "4. TYPES OF DEPOSITS"

      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Objective</strong></p>",
            "<p><strong>Explanation</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Economic Growth</p>",
            "<p>Increase GDP and national income</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Price Stability</p>",
            "<p>Control inflation</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Employment</p>",
            "<p>Generate job opportunities</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Income Equality</p>",
            "<p>Reduce inequality through taxation</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Resource Allocation</p>",
            "<p>Efficient allocation of public funds</p>"
          ]
        }
      ]
    },
    {
      "id": "cm4xkq5",
      "type": "heading",
      "level": 2,
      "content": "4. GOVERNMENT BUDGET"
    },
    {
      "type": "paragraph",
      "id": "9eifwh3",
      "content": "Budget is an annual financial statement of estimated receipts and expenditures of the government."
    },
    {
      "type": "paragraph",
      "id": "krb4vbt",
      "content": "Presented annually by the Finance Minister in Parliament."
    },
    {
      "id": "91za09r",

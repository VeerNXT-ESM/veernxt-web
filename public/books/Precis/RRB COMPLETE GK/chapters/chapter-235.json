    },
    {
      "id": "pzmwxjo",
      "type": "heading",
      "level": 2,
      "content": "2. GNP (Gross National Product)"
    },
    {
      "type": "paragraph",
      "id": "75rtqol",
      "content": "GDP + Net factor income from abroad."
    },
    {
      "id": "gk36bh0",
      "type": "heading",
      "level": 2,
      "content": "3. NDP (Net Domestic Product)"
    },
    {
      "type": "paragraph",
      "id": "78xii1w",
      "content": "GDP – Depreciation."
    },
    {
      "id": "oqg4dio",
      "type": "heading",
      "level": 2,
      "content": "4. Inflation"
    },
    {
      "type": "paragraph",
      "id": "wart5hv",
      "content": "Sustained rise in general price level over time."
    },
    {
      "id": "qmru9c3",
      "type": "heading",
      "level": 2,
      "content": "5. Deflation"
    },
    {
      "type": "paragraph",
      "id": "05hwazy",
      "content": "Sustained fall in general price level."
    },
    {
      "id": "ds587bj",
      "type": "heading",
      "level": 2,
      "content": "6. Stagflation"
    },
    {
      "type": "paragraph",
      "id": "7r5vba1",
      "content": "Situation of high inflation and high unemployment together."
    },
    {
      "id": "6ui9pcq",
      "type": "heading",
      "level": 2,
      "content": "7. Fiscal Deficit"
    },
    {
      "type": "paragraph",
      "id": "tmfelej",
      "content": "Total Expenditure – Total Receipts (excluding borrowings)"
    },
    {
      "id": "ekmrdh3",
      "type": "heading",
      "level": 2,
      "content": "8. Revenue Deficit"
    },
    {
      "type": "paragraph",
      "id": "p90aj0e",
      "content": "Revenue Expenditure – Revenue Receipts."
    },
    {
      "id": "zc0tzm9",
      "type": "heading",
      "level": 2,
      "content": "9. Primary Deficit"
    },
    {
      "type": "paragraph",
      "id": "6z9rduz",
      "content": "Fiscal Deficit – Interest Payments."
    },
    {
      "id": "yuhdre8",
      "type": "heading",
      "level": 2,
      "content": "10. Repo Rate"
    },
    {
      "type": "paragraph",
      "id": "xatm6pn",
      "content": "Rate at which RBI lends money to commercial banks."
    },
    {
      "id": "cmrx0di",
      "type": "heading",
      "level": 2,
      "content": "11. Reverse Repo Rate"
    },
    {
      "type": "paragraph",
      "id": "0bopmit",
      "content": "Rate at which RBI borrows money from banks."
    },
    {
      "type": "pullQuote",
      "content": "CHAPTER 14: IMPORTANT TERMS IN ECONOMICS",
      "id": "bd0b443"
    },
    {
      "id": "skvm94o",
      "type": "heading",
      "level": 2,
      "content": "12. CRR (Cash Reserve Ratio)"
    },
    {
      "type": "paragraph",
      "id": "9ztjvdn",
      "content": "Percentage of deposits banks must keep with RBI."
    },
    {
      "id": "pvakjmg",
      "type": "heading",
      "level": 2,
      "content": "13. SLR (Statutory Liquidity Ratio)"
    },
    {
      "type": "paragraph",
      "id": "4c09852",
      "content": "Percentage of deposits banks must keep in liquid assets."
    },
    {
      "id": "j33j6qp",
      "type": "heading",
      "level": 2,
      "content": "14. Balance of Payments (BoP)"
    },
    {
      "type": "paragraph",
      "id": "mc2ucn1",
      "content": "Record of all economic transactions with rest of the world."
    },
    {
      "id": "9ekhkfm",
      "type": "heading",
      "level": 2,
      "content": "15. Current Account Deficit (CAD)"
    },
    {
      "type": "paragraph",
      "id": "rx420tb",
      "content": "When imports exceed exports."
    },
    {
      "id": "ffb73h6",
      "type": "heading",
      "level": 2,
      "content": "16. Exchange Rate"
    },
    {
      "type": "paragraph",
      "id": "yslyg44",
      "content": "Price of one currency in terms of another."
    },
    {
      "id": "w2neomj",
      "type": "heading",
      "level": 2,
      "content": "17. Depreciation (Currency)"
    },
    {
      "type": "paragraph",
      "id": "65sbu45",
      "content": "Fall in value of domestic currency."
    },
    {
      "type": "comparisonTable",
      "headers": [
        "Parameter",
        "FDI (Foreign Direct Investment)",
        "FPI (Foreign Portfolio Investment)"
      ],
      "rows": [
        [
          "Definition",
          "Investment in physical assets or enterprises in another country",
          "Investment in financial assets like stocks and bonds"
        ],
        [
          "Control & Management",

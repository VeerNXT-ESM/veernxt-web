    {
      "type": "paragraph",
      "id": "0ri9mrv",
      "content": "• Aggregate Demand – Total demand for goods and services in an economy."
    },
    {
      "type": "paragraph",
      "id": "uitwplx",
      "content": "• Aggregate Supply – Total output produced in an economy."
    },
    {
      "type": "paragraph",
      "id": "z2ejbjg",
      "content": "• Appreciation – Rise in value of domestic currency."
    },
    {
      "type": "paragraph",
      "id": "ac79jgn",
      "content": "• Absolute Poverty – Inability to meet basic needs."
    },
    {
      "id": "52gcm4o",
      "type": "heading",
      "level": 2,
      "content": "B"
    },
    {
      "type": "paragraph",
      "id": "ff3iegx",
      "content": "• Balance of Payments – Record of international transactions."
    },
    {
      "type": "paragraph",
      "id": "parqhsy",
      "content": "• Budget – Annual financial statement of government."
    },
    {
      "type": "paragraph",
      "id": "tvk0ku0",
      "content": "• Base Year – Year used for comparison in index numbers."
    },
    {
      "type": "paragraph",
      "id": "cvwyyry",

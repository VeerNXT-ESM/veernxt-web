    {
      "type": "examAlert",
      "items": [
        "NNP at Factor Cost is conventionally defined as National Income.",
        "The Monetary Policy Committee (MPC) operates with a flexible inflation target of 4% with a tolerance band of +/- 2%.",
        "Fiscal Deficit equals Total Expenditure minus Total Receipts excluding borrowings.",
        "HDI components include Life Expectancy at Birth, Expected & Mean Years of Schooling, and GNI per Capita."
      ],
      "id": "xmkeov8"

    {
      "type": "paragraph",
      "id": "6tammjv",
      "content": "• MAO College → AMU (1920)."
    },
    {
      "type": "paragraph",
      "id": "itlg3t7",
      "content": "• Encouraged English and scientific education."
    },
    {
      "type": "paragraph",
      "id": "o7p507w",
      "content": "• Initially opposed Indian National Congress."
    },
    {
      "type": "paragraph",
      "id": "13grxae",
      "content": "• Promoted Muslim social reform but later contributed to separate political identity debate."
    },
    {
      "id": "ymikc9k",
      "type": "heading",
      "level": 3,
      "content": "7. RAMAKRISHNA MISSION — DETAILED ANALYSIS"
    },
    {
      "type": "paragraph",
      "id": "kg0hq6v",
      "content": "• Vivekananda’s Chicago Speech (1893)."
    },
    {
      "type": "paragraph",
      "id": "qcncu79",
      "content": "• Emphasis on universal religion and harmony."
    },
    {
      "type": "paragraph",
      "id": "efbjd5h",
      "content": "• Promoted Practical Vedanta."
    },
    {
      "type": "paragraph",
      "id": "79pkqhi",
      "content": "• Established educational and relief institutions."
    },
    {
      "type": "paragraph",
      "id": "slozuus",
      "content": "• Cultural nationalism dimension."
    },

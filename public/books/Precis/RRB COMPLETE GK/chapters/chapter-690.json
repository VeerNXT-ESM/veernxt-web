      "content": "• Nehruvian Non-Alignment (1947–1964)."
    },
    {
      "type": "paragraph",
      "id": "7s07r6l",
      "content": "• Realist Phase (1965–1991)."
    },
    {
      "type": "paragraph",
      "id": "gdyix0p",
      "content": "• Post-Cold War Globalization Phase (1991–2014)."
    },
    {
      "type": "paragraph",
      "id": "5er5k2c",
      "content": "• Multi-alignment &amp; Strategic Autonomy (2014–Present)."
    },
    {
      "type": "paragraph",
      "id": "ex1lnoa",
      "content": "• Look East / Act East Policy."
    },
    {
      "type": "paragraph",
      "id": "idbs1it",
      "content": "• QUAD participation."
    },

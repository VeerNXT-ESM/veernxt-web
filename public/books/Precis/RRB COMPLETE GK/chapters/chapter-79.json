    },
    {
      "type": "paragraph",
      "id": "ve12uf7",
      "content": "• Characterized by strike-slip faults."
    },
    {
      "type": "paragraph",
      "id": "nrjhln4",
      "content": "• Earthquakes occur due to sudden release of accumulated stress."
    },
    {
      "type": "paragraph",
      "id": "2gydia4",
      "content": "• Example: San Andreas Fault."
    }

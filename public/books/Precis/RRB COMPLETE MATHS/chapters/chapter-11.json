  "title": "CHAPTER 8 : SIMPLE INTEREST",
  "order": 11,
  "blocks": [
    {
      "id": "n15wizv",
      "type": "heading",
      "level": 2,
      "content": "FUNDAMENTAL CONCEPTS"
    },
    {
      "type": "keyFacts",
      "title": "Key Takeaways",
      "items": [
        "Simple Interest is calculated uniformly only on the initial principal amount throughout the entire period.",
        "The Principal (P) remains constant for the entire duration of the loan or investment.",
        "When time is given in months, it must be converted to years by dividing by 12 before applying the formula.",
        "The total Amount (A) at the end of the tenure is the sum of the Principal and Simple Interest."
      ],
      "id": "23vg228"
    },
    {
      "type": "statStrip",
      "stats": [
        {
          "label": "Core Formula",
          "value": "SI = (P×R×T)/100",
          "icon": "book"
        },
        {
          "label": "Total Amount",
          "value": "A = P + SI",
          "icon": "check"
        },
        {
          "label": "Time Standard",
          "value": "Years (T)",
          "icon": "clock"
        },
        {
          "label": "Target Exams",
          "value": "RRB & SSC",
          "icon": "award"
        }
      ],
      "id": "ckez7tw"

      "content": "45% = 45/100 = 9/20"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "q0nzapg",
      "content": "360 ÷ 20 = 18"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "8z9zd6j",
      "content": "18 × 9 = 162"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "z3qfxpc",
      "content": "Answer: 162"
    },
    {
      "type": "paragraph",

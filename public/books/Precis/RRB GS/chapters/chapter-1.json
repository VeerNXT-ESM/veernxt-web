    {
      "type": "paragraph",
      "id": "4ptamv1",
      "content": "Biology is the branch of science that deals with the study of living organisms, their structure, function, growth, origin, evolution and interaction with the environment."
    },
    {
      "type": "paragraph",
      "id": "hgy0cx0",
      "content": "- Nutrition – Obtaining and utilizing food."
    },
    {
      "type": "paragraph",
      "id": "t1bv3py",
      "content": "- Respiration – Release of energy from food."
    },
    {
      "type": "paragraph",
      "id": "ihtoajy",
      "content": "- Growth – Increase in size and number of cells."
    },
    {
      "type": "paragraph",
      "id": "5bjc98t",
      "content": "- Reproduction – Production of new individuals."
    },
    {
      "type": "paragraph",
      "id": "m0zr6q0",
      "content": "- Excretion – Removal of metabolic waste."
    },
    {
      "type": "paragraph",
      "id": "oe0t2vd",
      "content": "- Response to Stimuli – Reaction to environmental changes."
    },
    {
      "type": "paragraph",
      "id": "di65ppa",
      "content": "- Metabolism – All chemical reactions inside the body."
    },
    {
      "type": "paragraph",
      "id": "oblyzaz",
      "content": "- Adaptation – Adjustment for survival."
    },

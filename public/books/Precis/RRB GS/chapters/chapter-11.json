    {
      "id": "92tc3u8",
      "type": "heading",
      "level": 2,
      "content": ""
    },
    {
      "id": "uyh4s0r",
      "type": "heading",
      "level": 2,
      "content": "4. Thallophyta"
    },
    {
      "type": "paragraph",
      "id": "cekoq2u",
      "content": "Thallophyta are the simplest plants. The plant body is not differentiated into root, stem and leaves. They are mostly aquatic and reproduce by spores."
    },
    {
      "id": "vbso03o",
      "type": "heading",
      "level": 2,
      "content": "5. Bryophyta"
    },
    {
      "type": "paragraph",
      "id": "w49ottp",
      "content": "Bryophytes are known as the 'Amphibians of Plant Kingdom' because they live on land but require water for reproduction. They lack true roots and vascular tissues."
    },
    {
      "id": "fywc7c9",
      "type": "heading",
      "level": 2,
      "content": "6. Pteridophyta"
    },
    {
      "type": "paragraph",
      "id": "at7m39z",
      "content": "Pteridophytes are first vascular plants. They have true roots, stems and leaves. They reproduce by spores and do not produce seeds."
    },
    {
      "id": "0slr980",
      "type": "heading",
      "level": 2,
      "content": "7. Gymnosperms"
    },
    {
      "type": "paragraph",
      "id": "rhiib4a",
      "content": "Gymnosperms are seed-bearing plants with naked seeds (not enclosed in fruit). They are mostly evergreen and bear cones."
    },
    {
      "id": "yjipxfl",
      "type": "heading",
      "level": 2,
      "content": "8. Angiosperms"
    },
    {
      "type": "paragraph",
      "id": "k9he8io",
      "content": "Angiosperms are flowering plants. Seeds are enclosed within fruits. They are the most advanced and diverse group of plants."
    },
    {
      "id": "nnhe748",
      "type": "heading",
      "level": 2,
      "content": "9. Monocotyledons"
    },
    {
      "type": "paragraph",
      "id": "nrvydzs",
      "content": "Monocots are angiosperms with one cotyledon in seed. They show parallel venation and fibrous root system."
    },
    {
      "id": "o2spyes",
      "type": "heading",
      "level": 2,
      "content": "10. Dicotyledons"
    },
    {
      "type": "paragraph",
      "id": "nt28ixm",
      "content": "Dicots are angiosperms with two cotyledons in seed. They show reticulate venation and tap root system."
    },
    {

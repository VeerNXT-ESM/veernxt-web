            "<p><strong>Symptoms</strong></p>",
            "<p><strong>Affected Group</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Kwashiorkor</p>",
            "<p>Protein deficiency</p>",
            "<p>Swollen belly</p>",
            "<p>Children</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Marasmus</p>",
            "<p>Protein + calorie deficiency</p>",
            "<p>Severe wasting</p>",
            "<p>Infants</p>"
          ]
        }
      ]
    },
    {
      "id": "2tmxt8n",
      "type": "heading",
      "level": 2,
      "content": "8.Important High-Yield Points"
    },
    {

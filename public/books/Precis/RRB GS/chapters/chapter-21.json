    {
      "id": "v1pnwth",
      "type": "heading",
      "level": 2,
      "content": "Exothermic and Endothermic Reactions"
    },
    {
      "id": "xvwzbh7",
      "type": "image",
      "imageId": "6wwy3ew",
      "src": "/books/Precis/RRB GS/images/image_6wwy3ew.png"
    },
    {
      "type": "pullQuote",
      "content": "Mass can neither be created nor destroyed in a chemical reaction.",
      "id": "r7bzifs"
    },
    {
      "type": "paragraph",
      "id": "c9xtkft",
      "content": "<strong>Exothermic Reaction:</strong>"
    },
    {
      "type": "paragraph",
      "id": "d3m856y",
      "content": "A reaction in which heat energy is released to the surroundings."
    },
    {
      "type": "paragraph",
      "id": "u9yztdg",
      "content": "Example: Combustion of methane."
    },
    {
      "type": "paragraph",
      "id": "nmn9fux",
      "content": "<strong>Endothermic Reaction:</strong>"
    },
    {
      "type": "paragraph",
      "id": "tnxlkb5",
      "content": "A reaction in which heat energy is absorbed from the surroundings."
    },
    {
      "type": "paragraph",
      "id": "4a22vah",
      "content": "Example: Photosynthesis."
    },
    {
      "id": "m4njyf1",
      "type": "heading",
      "level": 2,
      "content": "Precipitation Reaction"
    },
    {
      "type": "paragraph",
      "id": "8v8gzd6",
      "content": "When two aqueous solutions react to form an insoluble solid called precipitate."
    },
    {
      "type": "paragraph",
      "id": "dprdp34",
      "content": "Example: Na2SO4 + BaCl2 → BaSO4 (white precipitate) + 2NaCl"
    },
    {
      "id": "4asniph",
      "type": "heading",
      "level": 2,
      "content": "Thermal Decomposition"
    },
    {
      "type": "paragraph",
      "id": "wlrwnr7",
      "content": "Decomposition reaction carried out by heating."
    },
    {
      "type": "paragraph",
      "id": "74r429a",
      "content": "Example: CaCO3 (heat) → CaO + CO2"
    },
    {
      "id": "qxwotq4",
      "type": "heading",
      "level": 2,
      "content": "Oxidising and Reducing Agents"
    },

    {
      "type": "paragraph",
      "id": "lt0o9zd",
      "content": "<strong>Physical Change: </strong>"
    },
    {
      "id": "glbtqnz",
      "type": "image",
      "imageId": "kya1g88",
      "src": "/books/Precis/RRB GS/images/image_kya1g88.png"
    },
    {
      "id": "z2edbje",
      "type": "image",
      "imageId": "lecv8qk",
      "src": "/books/Precis/RRB GS/images/image_lecv8qk.png"
    },
    {
      "id": "e45n03d",
      "type": "image",
      "imageId": "g768w2i",
      "src": "/books/Precis/RRB GS/images/image_g768w2i.png"
    },
    {
      "id": "jyok42p",
      "type": "image",
      "imageId": "3kukc4y",
      "src": "/books/Precis/RRB GS/images/image_3kukc4y.png"
    },
    {
      "type": "paragraph",
      "id": "vhh63ct",
      "content": "A change in which only physical properties such as shape, size, colour or state change. No new substance is formed and the change is usually reversible."
    },
    {
      "type": "paragraph",
      "id": "haf1urn",
      "content": "<strong>Chemical Change: </strong>"
    },
    {
      "type": "paragraph",
      "id": "e25rf9e",
      "content": "A change in which one or more new substances are formed with new properties. These changes are usually irreversible."
    },

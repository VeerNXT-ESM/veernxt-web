      "content": "9. Density"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "ckbscyz",
      "content": "Density = Mass / Volume"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "etb8qjn",
      "content": "SI Unit = kg/m³"
    },
    {
      "type": "paragraph",
      "id": "7thhv16",
      "content": "Density of water = 1000 kg/m³"
    },
    {
      "type": "paragraph",
      "id": "dkuvtqo",
      "content": "Ice floats on water due to lower density."
    },
    {
      "id": "cqsbfjv",

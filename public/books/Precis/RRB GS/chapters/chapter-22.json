    {
      "id": "2vgl1dv",
      "type": "heading",
      "level": 2,
      "content": "4. Other States of Matter"
    },
    {
      "type": "paragraph",
      "id": "fod4mpv",
      "content": "Plasma: Ionized gas found in Sun, stars, lightning, neon signs."
    },
    {
      "type": "paragraph",
      "id": "u5xg9ov",
      "content": "Bose-Einstein Condensate (BEC): Formed at extremely low temperature near 0 Kelvin."
    },
    {
      "type": "paragraph",
      "id": "c64l0d8",
      "content": "Absolute Zero = 0 K (−273°C)."
    },
    {
      "id": "ye2a048",
      "type": "heading",
      "level": 2,
      "content": "5. Change of State"
    },
    {
      "type": "paragraph",
      "id": "xttv780",
      "content": "Matter changes state by change in temperature or pressure."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "670zfpy",
      "content": "Melting: Solid → Liquid"
    },
    {
      "id": "qhmfhv6",
      "type": "image",
      "imageId": "aqghmf4",
      "src": "/books/Precis/RRB GS/images/image_aqghmf4.png"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "gqcu7qn",
      "content": "Boiling: Liquid → Gas"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "feld3we",
      "content": "Condensation: Gas → Liquid"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "ze0d15x",
      "content": "Freezing: Liquid → Solid"
    },
    {
      "type": "paragraph",
      "id": "88bg2kd",
      "content": "Sublimation: Solid → Gas directly (Dry ice, Camphor)"
    },
    {
      "type": "paragraph",
      "id": "ltvuf4l",
      "content": "Deposition: Gas → Solid directly (Frost)"
    },
    {
      "id": "6ajs9ir",
      "type": "heading",
      "level": 3,
      "content": "Important Temperature & Pressure Values"
    },
    {
      "type": "paragraph",
      "id": "il56chn",
      "content": "Melting point of ice = 273.15 K"
    },
    {
      "type": "paragraph",
      "id": "cyakl3j",
      "content": "Boiling point of water = 373 K"
    },
    {
      "type": "paragraph",
      "id": "y69hcep",
      "content": "1 atmosphere = 1.01 × 10^5 Pascal"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "mooakg1",
      "content": "K = °C + 273"
    },
    {
      "type": "pullQuote",
      "content": "Matter is anything that occupies space and has mass.",
      "id": "damyoto"
    },
    {
      "id": "wisr4q1",
      "type": "heading",
      "level": 2,
      "content": "6. Latent Heat"
    },
    {
      "type": "paragraph",
      "id": "kfyoy3r",
      "content": "Latent heat is heat required to change state without change in temperature."
    },
    {
      "type": "paragraph",
      "id": "2870pva",
      "content": "Latent Heat of Fusion: Solid → Liquid"
    },
    {
      "type": "paragraph",
      "id": "x30btnx",
      "content": "Latent Heat of Vaporization: Liquid → Gas"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "fah35fg",
      "content": "Unit = Joule/kg"
    },
    {
      "id": "68wywe8",
      "type": "heading",
      "level": 2,
      "content": "7. Evaporation"
    },
    {
      "type": "paragraph",
      "id": "jx8xkyx",
      "content": "Evaporation is a surface phenomenon and causes cooling."
    },
    {
      "type": "paragraph",
      "id": "pcig28y",
      "content": "Factors affecting evaporation:"
    },
    {
      "id": "lohds5a",
      "type": "list",
      "items": [
        " Surface area (More → Faster)",
        "Temperature (Higher → Faster)",
        " Wind speed (Higher → Faster)",
        "Humidity (Lower → Faster)"
      ]
    },
    {
      "id": "drffnzu",
      "type": "image",
      "imageId": "xcfbldy",
      "src": "/books/Precis/RRB GS/images/image_xcfbldy.png"
    },
    {
      "id": "1kdgfk6",
      "type": "heading",
      "level": 2,
      "content": "8. Diffusion"
    },
    {
      "type": "paragraph",
      "id": "hvbxrfo",
      "content": "Diffusion is mixing of particles due to motion."
    },
    {
      "type": "paragraph",
      "id": "ey7jc86",
      "content": "Fastest in gases, slowest in solids."
    },

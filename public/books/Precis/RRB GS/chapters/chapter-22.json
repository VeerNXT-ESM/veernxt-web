      "content": "10. Pure Substances and Mixtures"
    },
    {
      "type": "paragraph",
      "id": "re0la67",
      "content": "Pure substances: Elements and Compounds (fixed composition)."
    },
    {
      "type": "paragraph",
      "id": "bnjblum",
      "content": "Mixtures: Two or more substances in any proportion."
    },

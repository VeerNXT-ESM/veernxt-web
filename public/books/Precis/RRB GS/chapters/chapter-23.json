    {
      "id": "b6cf26g",
      "type": "heading",
      "level": 2,
      "content": "Atom"
    },
    {
      "type": "paragraph",
      "id": "lnl1hmc",
      "content": "Atom is the smallest particle of an element that takes part in chemical reaction."
    },
    {
      "type": "paragraph",
      "id": "g7spvsr",
      "content": "Atomic radius is measured in nanometre (1 nm = 10^-9 m)."
    },
    {
      "id": "6w3u1al",
      "type": "heading",
      "level": 2,
      "content": "Atomic Mass"
    },
    {
      "type": "paragraph",
      "id": "fg7wvnr",
      "content": "Atomic mass is the mass of an atom relative to 1/12th mass of carbon-12 atom."
    },
    {
      "type": "paragraph",
      "id": "hc35h6r",
      "content": "1 atomic mass unit (u) = 1/12th mass of carbon-12."
    },
    {
      "id": "11cg049",
      "type": "heading",
      "level": 3,

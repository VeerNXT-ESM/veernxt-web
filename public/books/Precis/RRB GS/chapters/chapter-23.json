    {
      "type": "paragraph",
      "id": "4h0wrm2",
      "content": "<strong>9. Atomic Number and Mass Number</strong>"
    },
    {
      "type": "paragraph",
      "id": "v23p249",
      "content": "Atomic number = Number of protons."
    },
    {
      "type": "paragraph",
      "id": "xpw0et3",
      "content": "Mass number = Protons + Neutrons."
    },
    {
      "id": "2bakzb6",
      "type": "heading",
      "level": 2,
      "content": "10. Isotopes, Isobars and Isotones"
    },
    {
      "type": "paragraph",
      "id": "mhhwqnz",
      "content": "Isotopes: Same atomic number, different mass number (Cl-35, Cl-37)."
    },
    {
      "type": "paragraph",
      "id": "eahh7yh",
      "content": "Isobars: Same mass number, different atomic number (Ar-40, Ca-40)."
    },
    {
      "type": "paragraph",
      "id": "tkvie16",
      "content": "Isotones: Same number of neutrons."
    },
    {
      "id": "9ykaplv",
      "type": "heading",
      "level": 3,
      "content": "Applications of Isotopes (RRB Important)"
    },
    {
      "id": "cwulg2c",
      "type": "list",
      "items": [
        " Uranium isotope used as nuclear fuel.",
        " Cobalt isotope used in cancer treatment.",
        "Iodine isotope used in goitre treatment."
      ]
    },
    {
      "id": "dw1u8le",
      "type": "heading",
      "level": 2,
      "content": "11. Avogadro Constant"
    },
    {
      "type": "paragraph",

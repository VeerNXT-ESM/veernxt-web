      "content": "Hard water contains Ca2+ and Mg2+ ions."
    },
    {
      "type": "paragraph",
      "id": "anv66j4",
      "content": "Temporary hardness due to bicarbonates."
    },
    {
      "type": "paragraph",
      "id": "00u4iqn",
      "content": "Permanent hardness due to chlorides and sulphates."
    },
    {
      "type": "paragraph",
      "id": "2db6de0",
      "content": "Washing soda removes permanent hardness."
    },

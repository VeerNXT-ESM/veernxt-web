  "order": 30,
  "blocks": [
    {
      "id": "pvhtlwy",
      "type": "heading",
      "level": 3,
      "content": "1. Industrial Chemicals"
    },
    {
      "type": "statStrip",
      "stats": [
        {
          "label": "Chapter Focus",
          "value": "Chemical Compounds",
          "icon": "book"
        },
        {
          "label": "High-Yield Topics",
          "value": "Gases & Salts",
          "icon": "award"
        },
        {
          "label": "Key Modules",
          "value": "10 Categories",

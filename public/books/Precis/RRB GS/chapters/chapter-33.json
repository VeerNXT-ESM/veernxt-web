    {
      "type": "paragraph",
      "id": "769ul44",
      "content": "Motion is the change in position of an object with respect to time and reference point. If an object changes its position with time, it is said to be in motion."
    },
    {
      "id": "dclxxbn",
      "type": "image",
      "imageId": "f66c1p3",

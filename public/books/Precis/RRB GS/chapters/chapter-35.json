    },
    {
      "id": "xkdcrma",
      "type": "heading",
      "level": 3,
      "content": "1. BASIC CONCEPT OF FORCE"
    },
    {
      "type": "paragraph",
      "id": "cvm8228",
      "content": "• SI Unit of Force = Newton (N)"
    },
    {
      "type": "paragraph",
      "id": "fujp50m",
      "content": "• 1 Newton = Force required to produce acceleration of 1 m/s² in a body of mass 1 kg."
    },
    {
      "type": "paragraph",
      "id": "y5hkqxm",
      "content": "• Formula: F = m × a"
    },
    {
      "type": "paragraph",
      "id": "9jihh39",
      "content": "• Dimension of Force = [M¹L¹T⁻²]"
    },
    {
      "type": "paragraph",
      "id": "ser3vsm",
      "content": "Effects of Force:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "kj8vlky",
      "content": "1. Change in speed"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "1yjte4z",
      "content": "2. Change in direction"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "tyxsdgb",
      "content": "3. Change in shape"
    },
    {
      "id": "ux368gl",
      "type": "heading",
      "level": 3,
      "content": "2. TYPES OF FORCES"
    },
    {
      "id": "2q65blj",

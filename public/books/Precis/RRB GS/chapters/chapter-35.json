      "id": "rz98ijf",
      "content": "<br></br>Correct Answer: C (18 N)"
    },
    {
      "type": "paragraph",
      "id": "mz748ic",
      "content": "Detailed Solution:"
    },
    {
      "type": "paragraph",
      "id": "wk2fy2o",
      "content": "Step 1: Apply Newton’s Second Law of Motion."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "r8hux8c",
      "content": "F = m × a"
    },
    {
      "type": "paragraph",
      "id": "s47yron",
      "content": "Step 2: Substitute given values."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "eandk04",

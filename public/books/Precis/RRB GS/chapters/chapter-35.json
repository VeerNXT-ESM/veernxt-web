    },
    {
      "type": "heading",
      "level": 4,
      "id": "z8yfp3x",
      "content": "F = 6 × 3"
    },
    {
      "type": "paragraph",
      "id": "4t3dw8f",
      "content": "Step 3: Multiply carefully."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "3hqockv",
      "content": "F = 18"
    },
    {
      "type": "paragraph",
      "id": "orbikqp",
      "content": "Unit Check: kg × m/s² = Newton (N)"

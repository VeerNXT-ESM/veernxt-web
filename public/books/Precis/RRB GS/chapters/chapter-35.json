    },
    {
      "type": "heading",
      "level": 4,
      "id": "pv25kp5",
      "content": "B) 12 N"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "utnfae6",
      "content": "C) 18 N"
    },

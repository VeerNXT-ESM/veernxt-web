    {
      "type": "paragraph",
      "id": "f07e1sq",
      "content": "Force is a push or pull acting on a body which can change its state of rest or motion or can change its shape. Force is a vector quantity because it has both magnitude and direction."
    },
    {
      "id": "4o8piex",
      "type": "image",
      "imageId": "r3linbx",
      "src": "/books/Precis/RRB GS/images/image_r3linbx.gif"
    },

      "level": 3,
      "content": "Q5."
    },
    {
      "type": "paragraph",
      "id": "gxy7dre",
      "content": "If orbital velocity of a satellite is 8 km/s, escape velocity is approximately:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "cc86fnf",
      "content": "A) 8 km/s"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "ul41pwq",
      "content": "B) 11.2 km/s"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "nfyp9zy",
      "content": "C) 16 km/s"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "5hf3fyv",
      "content": "D) 5.6 km/s"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "0lol74d",
      "content": "<br></br>Correct Answer: B"
    },
    {
      "type": "paragraph",
      "id": "px3h96b",
      "content": "Detailed Solution:"
    },
    {
      "type": "paragraph",
      "id": "lu0i640",
      "content": "Escape Velocity = √2 × Orbital Velocity"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "98j3qvo",
      "content": "√2 ≈ 1.414"
    },
    {
      "type": "paragraph",
      "id": "phsvv51",
      "content": "Escape velocity = 1.414 × 8"
    },
    {
      "type": "paragraph",
      "id": "ibdfx1a",
      "content": "≈ 11.3 km/s ≈ 11.2 km/s (approx.)"
    }

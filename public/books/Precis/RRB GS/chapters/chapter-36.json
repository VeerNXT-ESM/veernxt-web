      "content": "<br></br>Correct Answer: A"
    },
    {
      "type": "paragraph",
      "id": "ozpu3x0",
      "content": "Detailed Solution:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "jbk42v2",
      "content": "Formula: P = hρg"
    },
    {
      "type": "paragraph",
      "id": "31flspf",

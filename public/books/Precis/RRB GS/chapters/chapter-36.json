      "content": "B) 5 × 10³ Pa"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "7yqh5q4",
      "content": "C) 50 Pa"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "ksnumoe",
      "content": "D) 500 Pa"
    },
    {
      "type": "heading",
      "level": 4,

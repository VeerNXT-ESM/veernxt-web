            "<p>Guitar, Violin</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Wind Instruments</p>",
            "<p>Flute, Trumpet</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Percussion Instruments</p>",
            "<p>Drum, Tabla</p>"
          ]
        }
      ]
    },
    {
      "id": "hvdyr4w",
      "type": "heading",
      "level": 3,
      "content": "20. NOISE POLLUTION"
    },
    {
      "type": "paragraph",
      "id": "gn58scf",
      "content": "Excessive and unwanted sound is called noise pollution."
    },
    {
      "type": "paragraph",
      "id": "3gy3937",
      "content": "Effects: Hearing loss, stress, sleep disturbance."
    },
    {
      "type": "paragraph",
      "id": "hbtyout",
      "content": "Control: Soundproofing, Plantation, Noise barriers."
    },
    {
      "id": "wn42lsd",
      "type": "heading",
      "level": 3,
      "content": "21. ADVANCED RRB EXAM POINTS"
    },
    {
      "type": "paragraph",
      "id": "bk0n97u",
      "content": "• Sound travels fastest in solids."
    },
    {
      "type": "paragraph",
      "id": "yogo69b",
      "content": "• Frequency remains constant during reflection."
    },
    {
      "type": "paragraph",
      "id": "bfs3i4b",
      "content": "• Speed of sound increases with temperature."
    },
    {
      "type": "paragraph",
      "id": "mi4hl6h",
      "content": "• Loudness ∝ square of amplitude."
    },
    {
      "type": "paragraph",
      "id": "61tlrmx",
      "content": "• Wave velocity depends on medium, not frequency."
    }
  ],
  "enriched": true
}
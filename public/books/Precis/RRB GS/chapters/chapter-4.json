          ]
        }
      ]
    },
    {
      "id": "3iaqobt",
      "type": "heading",
      "level": 2,
      "content": "5 Platelets"
    },
    {
      "type": "paragraph",
      "id": "a3wgqrb",
      "content": "• Help in clotting."
    },
    {
      "type": "paragraph",
      "id": "009ag96",
      "content": "• Life span: 8–10 days."
    },
    {
      "type": "paragraph",
      "id": "i0kme60",
      "content": "• Normal count: 2.5–4 lakh per mm³."
    },
    {
      "type": "paragraph",
      "id": "x43rtfa",
      "content": "• Decrease: Thrombocytopenia."
    },
    {
      "id": "ayw31wn",
      "type": "heading",
      "level": 2,
      "content": "6 Blood Groups & Rh Factor"
    },
    {
      "id": "f10q6q4",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [

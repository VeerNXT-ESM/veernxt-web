    {
      "type": "paragraph",
      "id": "gxbg824",
      "content": "Plasma is the liquid part of blood. Serum is plasma without clotting factor (fibrinogen)."
    },
    {
      "id": "cd56vjy",
      "type": "heading",
      "level": 2,
      "content": "8 Blood Clotting Mechanism"
    },
    {
      "type": "paragraph",
      "id": "a3g1c8x",
      "content": "• Platelets release Thromboplastin."
    },
    {
      "type": "paragraph",
      "id": "ln9yzyo",
      "content": "• Prothrombin converts to Thrombin."
    },
    {
      "type": "paragraph",
      "id": "j2e0duh",
      "content": "• Thrombin converts Fibrinogen to Fibrin."
    },
    {
      "type": "paragraph",
      "id": "ragg99p",
      "content": "• Fibrin mesh stops bleeding."
    },
    {
      "id": "qrns7g5",
      "type": "heading",
      "level": 2,
      "content": "9 Blood Vessels"
    },
    {
      "id": "539rci3",
      "type": "table",
      "rows": [
        {
          "isHeader": true,
          "cells": [
            "<p><strong>Vessel</strong></p>",
            "<p><strong>Wall Thickness</strong></p>",
            "<p><strong>Direction</strong></p>",
            "<p><strong>Special Feature</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Artery</p>",
            "<p>Thick</p>",
            "<p>Away from heart</p>",
            "<p>High pressure</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Vein</p>",
            "<p>Thin</p>",
            "<p>Towards heart</p>",
            "<p>Valves</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [

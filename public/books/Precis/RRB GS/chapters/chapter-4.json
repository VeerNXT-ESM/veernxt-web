            "<p><strong>Antigen</strong></p>",
            "<p><strong>Antibody</strong></p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>A</p>",
            "<p>A</p>",
            "<p>Anti-B</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>B</p>",

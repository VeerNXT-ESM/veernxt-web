            "<p>Anti-A</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>AB</p>",
            "<p>A &amp; B</p>",
            "<p>None</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>O</p>",

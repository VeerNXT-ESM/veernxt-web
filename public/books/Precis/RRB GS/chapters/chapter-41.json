    {
      "id": "kes0ulj",
      "type": "heading",
      "level": 3,
      "content": "Q5."
    },
    {
      "type": "paragraph",
      "id": "228gz34",
      "content": "Refractive index of glass = 1.5. Find critical angle."
    },
    {
      "type": "paragraph",
      "id": "29cltnz",
      "content": "Options:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "l1rl5nr",
      "content": "A) 30°"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "7m38zhn",
      "content": "B) 42°"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "rkysq84",
      "content": "C) 60°"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "5vp3m5t",
      "content": "D) 75°"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "co9tw2m",
      "content": "<br></br>Correct Answer: B (≈42°)"
    },
    {
      "type": "paragraph",
      "id": "ktwebx6",
      "content": "<br></br>Step 1: Formula for critical angle."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "gylcv3y",
      "content": "sin C = 1/n"
    },
    {
      "type": "paragraph",
      "id": "gx0cbme",
      "content": "<br></br>Step 2: Substitute."
    },
    {
      "type": "paragraph",
      "id": "i0h8stt",
      "content": "sin C = 1 / 1.5"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "ahz117p",
      "content": "sin C = 0.67"
    },
    {
      "type": "paragraph",
      "id": "gyrei7w",
      "content": "<br></br>Step 3: Take inverse sine."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "jjdwi5a",
      "content": "C = sin⁻¹(0.67)"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "y1rb4jx",
      "content": "C ≈ 42°"
    },
    {
      "type": "paragraph",
      "id": "arjzjhl",
      "content": "If angle of incidence &gt; 42°, total internal reflection occurs."
    }
  ],

    {
      "type": "paragraph",
      "id": "23yplbw",
      "content": "An object is placed 20 cm in front of a concave mirror of focal length 10 cm. Find the image distance."
    },
    {
      "type": "paragraph",
      "id": "i45qbvl",
      "content": "Options:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "d2zqmm6",
      "content": "A) 10 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "rk1kpzv",
      "content": "B) 15 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "hfdr8on",
      "content": "C) 20 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "y91wuip",
      "content": "D) 30 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "46r8s2x",
      "content": "<br></br>Correct Answer: C (20 cm)"
    },
    {
      "type": "paragraph",
      "id": "0ir6vdo",
      "content": "<br></br>Step 1: Write mirror formula."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "pn6hyxu",
      "content": "1/f = 1/v + 1/u"
    },
    {
      "type": "paragraph",
      "id": "dn3604m",
      "content": "<br></br>Step 2: Apply sign convention (VERY IMPORTANT IN RRB)."
    },
    {
      "type": "paragraph",
      "id": "9g53b67",
      "content": "For concave mirror:"
    },
    {
      "type": "paragraph",
      "id": "fxs46dk",
      "content": "• Focal length (f) is negative."
    },
    {
      "type": "paragraph",
      "id": "j8afvw8",
      "content": "• Object distance (u) is always negative (object in front)."
    },
    {
      "type": "paragraph",
      "id": "s651fp5",
      "content": "Given:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "3pad3nm",
      "content": "f = -10 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "f45rrca",
      "content": "u = -20 cm"
    },
    {
      "type": "paragraph",
      "id": "z0hd6v0",
      "content": "<br></br>Step 3: Substitute values."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "lbcbndf",
      "content": "1/(-10) = 1/v + 1/(-20)"
    },
    {
      "type": "paragraph",
      "id": "tlzmqhr",
      "content": "⇒ -1/10 = 1/v - 1/20"
    },
    {
      "type": "paragraph",
      "id": "jvphiz8",
      "content": "<br></br>Step 4: Take LCM to simplify."
    },
    {
      "type": "paragraph",
      "id": "g9ffded",
      "content": "Multiply entire equation by 20:"
    },
    {
      "type": "paragraph",
      "id": "64uddoo",
      "content": "20 × (-1/10) = 20 × (1/v - 1/20)"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "taa4za3",
      "content": "-2 = 20/v - 1"
    },
    {
      "type": "paragraph",
      "id": "gmx5rqp",
      "content": "<br></br>Step 5: Rearrange equation."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "qc5pz1w",
      "content": "-2 + 1 = 20/v"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "jx2l0iz",
      "content": "-1 = 20/v"
    },
    {
      "type": "paragraph",
      "id": "567o7gi",
      "content": "<br></br>Step 6: Solve for v."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "1srf6yq",
      "content": "v = -20 cm"
    },
    {
      "type": "paragraph",
      "id": "o2fisf6",
      "content": "<br></br>Step 7: Interpretation."
    },
    {
      "type": "paragraph",
      "id": "ahbvqme",
      "content": "Negative v → Image formed in front of mirror."
    },
    {
      "type": "paragraph",
      "id": "gpmmxpd",
      "content": "Therefore, image distance = 20 cm (real image)."
    },
    {
      "id": "mckdzg0",
      "type": "heading",
      "level": 3,
      "content": "Q2."
    },
    {
      "type": "paragraph",
      "id": "20l732b",
      "content": "Using above data, find magnification."
    },
    {
      "type": "paragraph",
      "id": "kazux29",
      "content": "Options:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "awc4961",
      "content": "A) 1"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "j0s1txz",
      "content": "B) -1"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "ip5q8jm",
      "content": "C) 2"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "4kjpcmy",
      "content": "D) -2"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "pma3jd5",
      "content": "<br></br>Correct Answer: B (-1)"
    },
    {
      "type": "paragraph",
      "id": "64xa2uo",
      "content": "<br></br>Step 1: Use magnification formula for mirror."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "mb7lh8j",
      "content": "m = -v/u"
    },
    {
      "type": "pullQuote",
      "content": "MCQs",
      "id": "n9kvp9f"
    },
    {
      "type": "paragraph",
      "id": "aey2o3c",
      "content": "<br></br>Step 2: Substitute values."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "41pu5mk",
      "content": "v = -20 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "d88rcfg",
      "content": "u = -20 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "utx54f1",
      "content": "m = -(-20)/(-20)"
    },
    {
      "type": "paragraph",
      "id": "r2ogyz2",
      "content": "<br></br>Step 3: Simplify carefully."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "y7x6pte",
      "content": "m = 20 / (-20)"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "rwybk6f",
      "content": "m = -1"
    },
    {
      "type": "paragraph",
      "id": "683mztd",
      "content": "<br></br>Step 4: Interpretation."
    },
    {
      "type": "paragraph",
      "id": "hhvumz1",
      "content": "Negative sign → Image is inverted."
    },
    {
      "type": "paragraph",
      "id": "lqkaur6",
      "content": "Magnitude = 1 → Image size = Object size."
    },
    {
      "id": "dk17oej",
      "type": "heading",
      "level": 3,
      "content": "Q3."
    },
    {
      "type": "paragraph",
      "id": "eudwucm",
      "content": "An object is placed 30 cm from a convex lens of focal length 15 cm. Find image distance."
    },
    {
      "type": "paragraph",
      "id": "2unqolr",
      "content": "Options:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "hmsfw2x",
      "content": "A) 10 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "6h9itp7",
      "content": "B) 15 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "wu5ebtc",
      "content": "C) 20 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "moytnxj",
      "content": "D) 30 cm"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "y9nwfek",
      "content": "<br></br>Correct Answer: D (30 cm)"
    },
    {
      "type": "paragraph",
      "id": "pilvjal",
      "content": "<br></br>Step 1: Write lens formula."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "p4p7tf9",
      "content": "1/f = 1/v - 1/u"
    },
    {
      "type": "paragraph",
      "id": "vdxi0rc",
      "content": "<br></br>Step 2: Apply sign convention."
    },
    {
      "type": "paragraph",
      "id": "ud8dr6o",
      "content": "For convex lens:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "atjwvgx",
      "content": "f = +15 cm"
    },
    {
      "type": "paragraph",
      "id": "mgm0dgm",
      "content": "u = -30 cm (object always negative)"
    },
    {
      "type": "paragraph",
      "id": "iwkk2r7",
      "content": "<br></br>Step 3: Substitute."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "8027ajw",
      "content": "1/15 = 1/v - (-1/30)"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "ld0ujak",
      "content": "1/15 = 1/v + 1/30"
    },
    {
      "type": "paragraph",
      "id": "n3e3h6r",
      "content": "<br></br>Step 4: Take LCM 30."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "617eijw",
      "content": "2/30 = 1/v + 1/30"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "yzi4uzq",
      "content": "2/30 - 1/30 = 1/v"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "4ptjl0f",
      "content": "1/30 = 1/v"
    },
    {
      "type": "paragraph",
      "id": "1bjk9ak",
      "content": "<br></br>Step 5: Solve."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "6zrcmgw",
      "content": "v = 30 cm"
    },
    {
      "type": "paragraph",
      "id": "w1bsmfa",
      "content": "Positive v → Image formed on opposite side (real image)."
    },
    {
      "id": "1lnin5b",
      "type": "heading",
      "level": 3,
      "content": "Q4."
    },
    {
      "type": "paragraph",
      "id": "zgafeku",
      "content": "Focal length of lens = 0.5 m. Find power."
    },
    {
      "type": "paragraph",
      "id": "y3nvbbq",
      "content": "Options:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "e4djsi3",
      "content": "A) 0.5 D"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "orak24i",
      "content": "B) 1 D"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "84ulupq",
      "content": "C) 2 D"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "008bg1a",
      "content": "D) 4 D"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "er1zisd",
      "content": "<br></br>Correct Answer: C (2 D)"
    },
    {
      "type": "paragraph",
      "id": "v20cyu8",
      "content": "<br></br>Step 1: Formula of power."
    },
    {
      "type": "paragraph",
      "id": "cg8dkux",
      "content": "P = 1/f (f in metre)"
    },
    {
      "type": "paragraph",
      "id": "awpy0b6",
      "content": "<br></br>Step 2: Substitute."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "pok2s32",
      "content": "P = 1 / 0.5"
    },
    {
      "type": "paragraph",
      "id": "1ob85bf",
      "content": "<br></br>Step 3: Calculate."
    },
    {
      "type": "heading",
      "level": 4,
      "id": "cqj0fae",
      "content": "P = 2 Dioptre"
    },
    {
      "type": "paragraph",
      "id": "t89ygsl",
      "content": "Since focal length positive → Convex lens."
    },

    {
      "id": "l03yk2p",
      "type": "heading",
      "level": 3,
      "content": "21. ADVANCED RRB EXAM POINTS"
    },
    {
      "type": "paragraph",
      "id": "m8gvf30",
      "content": "• Rods are more sensitive than cones."
    },
    {
      "type": "paragraph",
      "id": "yi4t9dq",
      "content": "• Critical angle inside eye helps total internal reflection."
    },
    {
      "type": "paragraph",
      "id": "c09tbaj",
      "content": "• Twinkling occurs due to atmospheric refraction."
    },
    {
      "type": "paragraph",
      "id": "9up4g9i",
      "content": "• Scattering ∝ 1/λ⁴ (Rayleigh scattering concept)."
    },
    {
      "type": "paragraph",
      "id": "s4u39fy",
      "content": "• Near point increases with age."
    }
  ],
  "enriched": true
}
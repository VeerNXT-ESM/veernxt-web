    {
      "id": "9z8kmq0",
      "type": "heading",
      "level": 3,
      "content": "Q5."
    },
    {
      "type": "paragraph",
      "id": "s1c6ri5",
      "content": "Persistence of vision is approximately:"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "tv8wzje",
      "content": "A) 1/2 second"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "urqhke6",
      "content": "B) 1/10 second"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "cxz7zxx",
      "content": "C) 1/16 second"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "rgpz3h9",
      "content": "D) 1/60 second"
    },
    {
      "type": "heading",
      "level": 4,
      "id": "s1ppe9z",
      "content": "<br></br>Correct Answer: C (1/16 second)"
    },
    {
      "type": "paragraph",
      "id": "qas8ho9",
      "content": "<br></br>Detailed Explanation:"
    },
    {
      "type": "paragraph",
      "id": "km3uqu9",
      "content": "• Image remains on retina for about 1/16 second."
    },
    {
      "type": "paragraph",
      "id": "rlbok0y",
      "content": "• Due to this, rapidly changing images appear continuous."
    },
    {
      "type": "paragraph",
      "id": "jhoougm",
      "content": "• This principle is used in motion pictures and films."
    }
  ],
  "enriched": true

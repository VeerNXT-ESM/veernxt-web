    },
    {
      "id": "fx18fil",
      "type": "heading",
      "level": 3,
      "content": "14. ADVANCED RRB EXAM POINTS"
    },
    {
      "type": "paragraph",
      "id": "1tfmt6y",
      "content": "• Ammeter connected in series (low resistance)."
    },
    {
      "type": "paragraph",
      "id": "6uwus25",
      "content": "• Voltmeter connected in parallel (high resistance)."
    },
    {
      "type": "paragraph",
      "id": "gt5n8f8",
      "content": "• In series, total resistance increases."
    },
    {
      "type": "paragraph",
      "id": "d20bui2",
      "content": "• In parallel, equivalent resistance decreases."
    },
    {
      "type": "paragraph",
      "id": "pyj6qyi",
      "content": "• Electric bulb filament made of tungsten (high melting point)."
    }
  ],
  "enriched": true
}
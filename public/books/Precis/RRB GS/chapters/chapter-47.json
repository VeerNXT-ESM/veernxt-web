            "<p>Using solar panels</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Wind Energy</p>",
            "<p>Wind turbines</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>Tidal Energy</p>",
            "<p>Energy from sea tides</p>"
          ]
        },
        {
          "isHeader": false,

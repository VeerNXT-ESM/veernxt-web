            "<p>AB</p>"
          ]
        },
        {
          "isHeader": false,
          "cells": [
            "<p>ii</p>",
            "<p>O</p>"
          ]
        }
      ]
    },
    {
      "id": "oojd8r9",
      "type": "heading",
      "level": 2,
      "content": "12. Variation"
    },
    {
      "type": "paragraph",
      "id": "g84orzy",
      "content": "Variations are differences between individuals of same species. They may be genetic or environmental."
    },
    {
      "id": "xohgria",
      "type": "heading",
      "level": 2,
      "content": "13. Mutation"
    },
    {
      "type": "paragraph",
      "id": "bvrw1p5",
      "content": "Mutation is sudden change in genetic material. It may be beneficial or harmful and leads to variation."
    },
    {
      "type": "examAlert",

        ],
        [
          "Black Soil (Regur)",
          "Derived from basaltic lava; high water retention; self-ploughing",
          "Cotton, Sugarcane, Tobacco, Oilseeds"
        ],
        [
          "Red Soil",
          "Reddish due to diffusion of iron in crystalline rocks; porous and friable",
          "Wheat, Rice, Pulses, Millets"
        ],
        [
          "Laterite Soil",
          "Formed by intense leaching in high temperature & heavy rainfall zones",
          "Tea, Coffee, Cashew nut, Rubber"

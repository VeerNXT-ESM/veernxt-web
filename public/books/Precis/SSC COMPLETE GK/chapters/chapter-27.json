    {
      "type": "paragraph",
      "id": "03a3xmx",
      "content": "The word Chalcolithic is derived from two words: - <em>Chalco </em>meaning copper - <em>Lithic </em>meaning stone"
    },
    {
      "id": "eqn5ua6",
      "type": "image",
      "imageId": "1gbz1qv",

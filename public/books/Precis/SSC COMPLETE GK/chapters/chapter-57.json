        "Banking Service Commission Bill"
      ]
    },
    {
      "id": "nke1ddm",
      "type": "heading",
      "level": 2,
      "content": "POWERS AND FUNCTIONS OF PARLIAMENT"
    },
    {
      "type": "paragraph",
      "id": "bumezxl",
      "content": "Legislative Powers:"
    },
    {
      "id": "gm4de8w",
      "type": "list",
      "items": [
        "<ul><li>Makes laws on Union and Concurrent List</li></ul>",
        "Makes laws on Union and Concurrent List"
      ]
    },
    {
      "type": "paragraph",
      "id": "jfqorh8",
      "content": "Executive Powers:"
    },
    {
      "id": "kwsl28l",
      "type": "list",
      "items": [
        "<ul><li>Controls Council of Ministers</li><li>No-confidence motion</li></ul>",
        "Controls Council of Ministers",
        "No-confidence motion"
      ]
    },
    {
      "type": "paragraph",
      "id": "74pzoxb",
      "content": "Financial Powers:"
    },
    {
      "id": "yqenma0",
      "type": "list",
      "items": [
        "<ul><li>Budget approval</li><li>Taxation</li></ul>",
        "Budget approval",
        "Taxation"
      ]
    },
    {
      "type": "paragraph",
      "id": "5qh06vx",
      "content": "Judicial Powers:"
    },
    {
      "id": "68jvf8t",
      "type": "list",
      "items": [
        "<ul><li>Impeachment of President</li><li>Removal of judges</li></ul>",
        "Impeachment of President",
        "Removal of judges"
      ]
    },
    {
      "type": "paragraph",
      "id": "h9ruk9b",
      "content": "Electoral Powers:"
    },
    {
      "id": "1vp2tq9",
      "type": "list",
      "items": [
        "<ul><li>Election of President and Vice-President</li></ul>",
        "Election of President and Vice-President"
      ]
    },
    {
      "id": "0or02g6",
      "type": "heading",
      "level": 2,
      "content": "PARLIAMENTARY PRIVILEGES"
    },
    {
      "type": "paragraph",
      "id": "o5tmkl3",
      "content": "Parliamentary privileges ensure smooth functioning. Includes:"
    },
    {
      "id": "6vgqngc",
      "type": "list",
      "items": [
        "<ul><li>Freedom of speech</li><li>Freedom from arrest</li><li>Right to publish proceedings</li></ul>",
        "Freedom of speech",
        "Freedom from arrest",
        "Right to publish proceedings"
      ]
    },
    {
      "id": "re92kh2",
      "type": "heading",
      "level": 2,
      "content": "PARLIAMENTARY COMMITTEES"
    },
    {
      "type": "paragraph",
      "id": "8677yiv",
      "content": "Types:"
    },
    {
      "id": "bzw9umw",
      "type": "list",
      "items": [
        "<ul><li>Standing Committees</li><li>Ad-hoc Committees</li></ul>",
        "Standing Committees",
        "Ad-hoc Committees"
      ]
    },
    {
      "type": "paragraph",
      "id": "kc96cvl",
      "content": "Functions:"
    },
    {
      "id": "ffmiayr",
      "type": "list",
      "items": [

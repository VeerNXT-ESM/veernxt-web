    },
    {
      "type": "examAlert",
      "items": [
        "The 73rd Amendment added Part IX and the 11th Schedule (containing 29 functional subjects) to the Constitution of India.",
        "The 74th Amendment added Part IX-A and the 12th Schedule (containing 18 functional subjects) to the Constitution.",
        "Mandatory reservation of at least one-third of total seats for women is required in all local government bodies."
      ],
      "id": "98vtyg1"
    },

    {
      "type": "comparisonTable",
      "headers": [
        "Inflation Type",
        "Primary Cause / Factor",
        "Key Characteristic"
      ],
      "rows": [
        [
          "Demand-Pull Inflation",
          "Excess aggregate demand over supply",
          "Driven by increased money supply, government spending, or consumer demand"
        ],
        [
          "Cost-Push Inflation",
          "Rise in cost of production inputs",
          "Driven by wage hikes, high raw material costs, or supply shocks"
        ],
        [
          "Creeping Inflation",
          "Mild and slow price rise",
          "Generally manageable and beneficial for economic expansion"
        ],
        [
          "Hyperinflation",
          "Out of control monetary expansion",
          "Extremely rapid price increase leading to currency devaluation"
        ]
      ],
      "id": "5hcao1k"

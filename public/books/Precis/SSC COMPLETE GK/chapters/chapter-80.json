    {
      "type": "comparisonTable",
      "headers": [
        "Parameter",
        "Absolute Poverty",
        "Relative Poverty"
      ],
      "rows": [
        [
          "Definition",
          "Inability to secure the minimum basic human needs such as food, clothing, and shelter.",
          "Condition where a person's income is significantly less than the average standard of living in society."
        ],
        [
          "Measurement",
          "Measured against a fixed threshold known as the Poverty Line.",
          "Measured using income distribution metrics like the Gini Coefficient or Lorenz Curve."
        ],
        [
          "Prevalence",
          "Prevalent primarily in developing and underdeveloped countries.",
          "Exists in all societies, including highly developed nations."
        ]
      ],
      "id": "h7e75pz"

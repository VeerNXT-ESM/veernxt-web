          "Kharif Crops",
          "Sown: June–July | Harvested: Sept–Oct",
          "Monsoon crops requiring substantial rainfall and heat"
        ],
        [
          "Rabi Crops",
          "Sown: Oct–Nov | Harvested: April–May",
          "Winter crops needing cooler growing conditions and moderate moisture"
        ],
        [
          "Zaid Crops",
          "Sown & Harvested: March–June",
          "Short-season summer crops grown between Rabi and Kharif seasons"
        ]
